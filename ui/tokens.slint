// UI V2 showcase tokens. Near-black canvas, warm bone type, chartreuse signal.
// Hairlines are intentionally low-contrast; text never uses them for emphasis.
export global AgTheme {
    out property <color> canvas: #0B0B0E;
    out property <color> rail: #0E0E12;
    out property <color> panel: #121217;
    out property <color> panel-raised: #17171D;
    out property <color> panel-hover: #1C1C23;
    out property <color> ink: #050506;

    out property <color> bone: #F2EBDD;
    out property <color> bone-strong: #FBF8F0;
    out property <color> bone-dim: #C9C1B2;
    out property <color> muted: #938D81;
    out property <color> quiet: #817A6E;

    out property <color> accent: #D8FF57;
    out property <color> accent-hover: #E4FF86;
    out property <color> accent-press: #C2EA38;
    out property <color> accent-ink: #101405;
    out property <color> accent-wash: #D8FF5714;
    out property <color> accent-line: #D8FF5759;

    out property <color> amber: #FFB86B;
    out property <color> amber-wash: #FFB86B16;
    out property <color> coral: #FF8577;
    out property <color> coral-wash: #FF857716;

    out property <color> line: #27262D;
    out property <color> line-strong: #3A3841;
    out property <color> line-faint: #F2EBDD12;
    out property <color> scrim: #050506C7;

    out property <color> state-idle: #938D81;
    out property <color> state-live: #D8FF57;
    out property <color> state-attention: #FFB86B;
    out property <color> state-danger: #FF8577;
    out property <color> state-done: #C9C1B2;

    out property <length> rail-width: 252px;
    out property <length> inspector-width: 356px;
    out property <length> header-height: 88px;
    out property <length> composer-height: 154px;
    out property <length> gutter: 40px;
    out property <length> hairline: 1px;

    out property <string> font-display: "Segoe UI Variable Display";
    out property <string> font-ui: "Segoe UI Variable";
    out property <string> font-mono: "Cascadia Mono";

    out property <length> type-hero: 54px;
    out property <length> type-hero-compact: 42px;
    out property <length> type-display: 30px;
    out property <length> type-title: 22px;
    out property <length> type-lead: 17px;
    out property <length> type-body: 14px;
    out property <length> type-small: 12px;
    out property <length> type-micro: 10px;
    out property <length> type-code: 11px;

    out property <int> weight-regular: 400;
    out property <int> weight-medium: 500;
    out property <int> weight-semibold: 600;
    out property <int> weight-bold: 700;

    out property <length> radius-sm: 2px;
    out property <length> radius-md: 4px;
    out property <length> radius-lg: 8px;

    out property <duration> motion-fast: 110ms;
    out property <duration> motion-state: 220ms;
    out property <duration> motion-pulse: 760ms;
}
