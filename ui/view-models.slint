export struct RichBlockView {
    kind: string, // p | h1 | h2 | h3 | li | quote | code | table | hr
    text: string,
    styled: styled-text,
    rich: bool, // true when `styled` carries inline formatting
    lang: string,
    depth: int,
    marker: string,
}

