export struct GraphNodeView {
    id: string,
    label: string,
    detail: string,
    kind: string,           // "agent" | "workflow" | "module" | "tool" | "provider" | "model" | "memory" | "channel" | "cli" | "input" | "output" | "workspace"
    state: string,          // "idle" | "running" | "success" | "blocked" | "error" | "disabled"
    icon: string,
    x: length,              // logical position in graph canvas (pixels before zoom)
    y: length,
    width: length,
    height: length,
    ports: int,             // number of connection ports
    run_progress: float,    // 0.0 .. 1.0
    run_label: string,
    detail_role: string,    // secondary subtitle (model, scope, count, etc.)
}

export struct GraphEdgeView {
    id: string,
    source: string,
