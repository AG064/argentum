export struct ConversationMessageView {
    role: string,
    steps: string,
    steps_title: string,
    additions: int,
    removals: int,
    changes: [MessageChangeView],
    text: string,
    reasoning: string,
    reasoning_available: bool,
    provider_label: string,
    model: string,
    usage_reported: bool,
    input_tokens: int,
    output_tokens: int,
    total_tokens: int,
    context_window_reported: bool,
    context_window_tokens: int,
    state: string,
    blocks: [RichBlockView],
}

