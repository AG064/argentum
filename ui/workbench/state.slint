    // the owner confirms with open_workspace.
    callback choose_workspace_folder();
    // Android only: the optional All files access permission. Without it the
    // workspace is the app's own folder. With it, the owner can pick a folder
    // in Internal storage. Nothing here grants the agent anything beyond the
    // chosen workspace.
    in-out property <bool> workspace_all_files_supported: false;
    in-out property <bool> workspace_all_files_granted: false;
    // True when the open workspace is a folder the owner picked, not the
