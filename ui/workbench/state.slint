}

// One flag per optional module, set from the harness snapshot. Core parts of the
// shell, the conversation, the provider chooser, and approvals, have no flag.
export global Mods {
    in-out property <bool> sessions: false;
    in-out property <bool> context-meter: false;
    in-out property <bool> reasoning: false;
    in-out property <bool> status-bar: false;
    in-out property <bool> palette: false;
    in-out property <bool> goal: false;
    in-out property <bool> usage: false;
    in-out property <bool> any-panel: false;
}
