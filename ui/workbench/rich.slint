// Renders the block model shared by chat Markdown and the reader-mode browser.
import { Theme } from "theme.slint";
import { App } from "state.slint";
import { CopyBtn, Label } from "kit.slint";
import { RichBlockView, DiffLineView } from "../view-models.slint";

// Plain text stays selectable. Text with inline formatting uses StyledText, which
// Slint does not make selectable, so messages also carry a copy action.
component Paragraph inherits VerticalLayout {
    in property <RichBlockView> block;
    in property <length> size: Theme.fs-md;
    in property <color> tint: Theme.text;
    in property <int> weight: Theme.w-normal;
    callback link(string);
    if block.rich: StyledText {
        text: block.styled;
        default-color: root.tint;
        default-font-size: root.size;
        link-color: Theme.accent-ink;
        link-clicked(url) => { root.link(url); }
    }
    if !block.rich: TextInput {
        text: block.text;
        // On a phone a scroll must not start a selection, so reply text is
        // fixed there; the message's Copy button copies it.
        enabled: !App.touch_device;
        read-only: true;
        single-line: false;
        wrap: word-wrap;
        color: root.tint;
        font-size: root.size;
        font-weight: root.weight;
        selection-background-color: Theme.accent.with-alpha(0.4);
        selection-foreground-color: Theme.text;
    }
}

component CodeBlock inherits Rectangle {
    in property <RichBlockView> block;
    border-radius: Theme.r-md;
    border-width: Theme.hair;
    border-color: Theme.border;
    background: Theme.code-bg;
    clip: true;
    VerticalLayout {
        Rectangle {
            height: Theme.control - 4px;
            background: Theme.hover;
            HorizontalLayout {
                padding-left: Theme.sp12;
                padding-right: Theme.sp3;
                Label {
                    text: block.lang != "" ? block.lang : "text";
                    tone: "muted";
                    size: "xs";
                    mono: true;
                    horizontal-stretch: 1;
                }
                CopyBtn { text: block.text; tip: "Copy code"; tip-beside: true; y: (parent.height - self.height) / 2; }
            }
        }
        VerticalLayout {
            padding: Theme.sp12;
            TextInput {
                text: block.text;
                // Fixed on a phone, like reply text. Copy code copies it.
                enabled: !App.touch_device;
                read-only: true;
                single-line: false;
                wrap: word-wrap;
                color: Theme.text;
                font-family: Theme.font-mono;
                font-size: Theme.fs-sm;
                selection-background-color: Theme.accent.with-alpha(0.4);
                selection-foreground-color: Theme.text;
            }
        }
    }
}

component TableCell inherits Rectangle {
    in property <string> text;
    in property <bool> head;
    in property <int> align;
    in property <length> column-width;
    width: column-width;
    background: head ? Theme.hover : transparent;
    VerticalLayout {
        padding-left: Theme.sp10;
        padding-right: Theme.sp10;
        padding-top: Theme.sp8;
        padding-bottom: Theme.sp8;
        Text {
            text: root.text;
            wrap: word-wrap;
            color: head ? Theme.text : Theme.text-2;
            font-size: Theme.fs-sm;
            font-weight: head ? Theme.w-semibold : Theme.w-normal;
            horizontal-alignment: align == 1 ? center : align == 2 ? right : left;
        }
    }
    Rectangle { x: 0; y: parent.height - self.height; width: parent.width; height: Theme.hair; background: Theme.border; }
    Rectangle { x: parent.width - self.width; y: 0; width: Theme.hair; height: parent.height; background: Theme.border; }
}

// A real grid: header row, hairline separators, wrapping cells. Columns share the
// reply width by content length, never narrower than a readable minimum, so a
// wide table scrolls sideways instead of crushing its text.
component TableView inherits Rectangle {
    in property <RichBlockView> block;
    // Wider than the reply, so it scrolls sideways.
    private property <bool> wide: grid.preferred-width > grid-scroll.width + 8px;
    // While scrolled away from its left edge, the table tells the drawer swipe
    // where it is on screen, so a right swipe on it scrolls the table back.
    private property <bool> scrolled: root.wide && grid-scroll.content-x < -1px;
    private property <length> screen-top: root.absolute-position.y;
    changed scrolled => { root.publish(); }
    changed screen-top => { root.publish(); root.report(); }
    changed wide => { root.report(); }
    changed height => { root.report(); }
    init => { root.report(); }
    function report() {
        if App.touch_device {
            App.report_wide_table(block.text, root.screen-top, root.screen-top + root.height, root.wide);
        }
    }
    // A sideways swipe that started on this table moves it by the same
    // distance. The chat's handler decides the axis before anything scrolls.
    private property <bool> panning: root.wide && App.table_pan_active && App.table_pan_y >= root.screen-top && App.table_pan_y < root.screen-top + root.height;
    private property <length> pan-dx: App.table_pan_dx;
    private property <length> last-dx: 0px;
    changed pan-dx => {
        if root.panning {
            grid-scroll.content-x = clamp(grid-scroll.content-x + root.pan-dx - root.last-dx, min(0px, grid-scroll.width - grid-scroll.content-width), 0px);
        }
        root.last-dx = root.pan-dx;
    }
    function publish() {
        if root.scrolled {
            App.scrolled_table_top = root.screen-top;
            App.scrolled_table_bottom = root.screen-top + root.height;
        } else if App.scrolled_table_top == root.screen-top && App.scrolled_table_bottom == root.screen-top + root.height {
            App.scrolled_table_top = 0px;
            App.scrolled_table_bottom = 0px;
        }
    }
    border-radius: Theme.r-md;
    border-width: Theme.hair;
    border-color: Theme.border;
    background: Theme.code-bg;
    clip: true;
    VerticalLayout {
        Rectangle {
            height: Theme.control - 4px;
            background: Theme.hover;
            HorizontalLayout {
                padding-left: Theme.sp12;
                padding-right: Theme.sp3;
                Label {
                    text: root.wide ? "table, scroll sideways" : "table";
                    tone: "muted";
                    size: "xs";
                    mono: true;
                    horizontal-stretch: 1;
                }
                CopyBtn { text: block.text; tip: "Copy table"; tip-beside: true; y: (parent.height - self.height) / 2; }
            }
        }
        Rectangle {
        min-width: 0px;
        max-width: 100000px;
        height: grid.preferred-height;
        grid-scroll := Flickable {
            // On touch the chat's gesture handler scrolls the table, so a
            // swipe moves along one axis only.
            interactive: !App.touch_device;
            // Shift and the wheel, or a touchpad, scroll it sideways.
            mouse-drag-pan-enabled: false;
            // Fixed bounds keep the columns from feeding their own width back.
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            content-width: max(self.width, grid.preferred-width);
            content-height: grid.preferred-height;
            grid := VerticalLayout {
                alignment: start;
                for row in block.rows: HorizontalLayout {
                    alignment: start;
                    for cell[column] in row.cells: TableCell {
                        text: cell;
                        head: row.head;
                        align: block.aligns[column];
                        // A column of long text keeps room for whole sentences on a
                        // narrow screen; the table scrolls sideways instead.
                        column-width: max(104px, grid-scroll.width * block.weights[column], block.wide[column] ? max(260px, 600px * block.weights[column]) : 0px);
                    }
                }
            }
        }
        // Fades the cut edge while there is more to the right.
        if root.wide && grid-scroll.content-x > grid-scroll.width - grid-scroll.content-width + 1px: Rectangle {
            x: parent.width - self.width;
            y: 0;
            width: 28px;
            height: parent.height;
            background: @linear-gradient(90deg, Theme.code-bg.with-alpha(0) 0%, Theme.code-bg 100%);
        }
        }
    }
}

component BlockView inherits VerticalLayout {
    in property <RichBlockView> block;
    callback link(string);
    if block.kind == "p": Paragraph { block: root.block; link(u) => { root.link(u); } }
    if block.kind == "h1": VerticalLayout {
        padding-top: Theme.sp8;
        Paragraph { block: root.block; size: Theme.fs-xl; weight: Theme.w-semibold; link(u) => { root.link(u); } }
    }
    if block.kind == "h2": VerticalLayout {
        padding-top: Theme.sp6;
        Paragraph { block: root.block; size: Theme.fs-lg; weight: Theme.w-semibold; link(u) => { root.link(u); } }
    }
    if block.kind == "h3": VerticalLayout {
        padding-top: Theme.sp4;
        Paragraph { block: root.block; size: Theme.fs-md; weight: Theme.w-semibold; link(u) => { root.link(u); } }
    }
    // Placed by hand: Slint measured wrapped text inside a HorizontalLayout as
    // if it had the whole row, so long items got too little height and the end
    // of a reply was cut off.
    if block.kind == "li": Rectangle {
        private property <length> inset: Theme.sp14 * block.depth + 16px + Theme.sp8;
        height: item.preferred-height;
        Text {
            x: Theme.sp14 * block.depth;
            y: 0;
            width: 16px;
            text: block.marker;
            color: Theme.text-3;
            font-size: Theme.fs-md;
            horizontal-alignment: right;
        }
        item := Paragraph {
            x: parent.inset;
            y: 0;
            width: parent.width - parent.inset;
            block: root.block;
            link(u) => { root.link(u); }
        }
    }
    if block.kind == "quote": Rectangle {
        height: quoted.preferred-height;
        Rectangle { x: 0; y: 0; width: 2px; height: parent.height; background: Theme.border-strong; }
        quoted := Paragraph {
            x: 2px + Theme.sp12;
            y: 0;
            width: parent.width - self.x;
            block: root.block;
            tint: Theme.text-2;
            link(u) => { root.link(u); }
        }
    }
    if block.kind == "code": CodeBlock { block: root.block; }
    if block.kind == "table": TableView { block: root.block; }
    if block.kind == "hr": VerticalLayout {
        padding-top: Theme.sp4;
        padding-bottom: Theme.sp4;
        Rectangle { height: Theme.hair; background: Theme.border; }
    }
}

export component RichBlocks inherits VerticalLayout {
    in property <[RichBlockView]> blocks;
    callback link(string);
    spacing: Theme.sp9;
    for block in blocks: BlockView {
        block: block;
        link(u) => { root.link(u); }
    }
}

// Unified diff with line numbers, shared by agent changes and working tree.
export component DiffView inherits VerticalLayout {
    in property <[DiffLineView]> lines;
    for line in lines: Rectangle {
        background: line.kind == "add" ? Theme.diff-add-bg
            : line.kind == "del" ? Theme.diff-del-bg
            : line.kind == "hunk" ? Theme.hover
            : transparent;
        HorizontalLayout {
            padding-right: Theme.sp8;
            spacing: Theme.sp6;
            if line.kind == "add" || line.kind == "del" || line.kind == "ctx": Text {
                width: 34px;
                text: line.old-no;
                color: Theme.text-3;
                font-family: Theme.font-mono;
                font-size: Theme.fs-xs;
                horizontal-alignment: right;
            }
            if line.kind == "add" || line.kind == "del" || line.kind == "ctx": Text {
                width: 34px;
                text: line.new-no;
                color: Theme.text-3;
                font-family: Theme.font-mono;
                font-size: Theme.fs-xs;
                horizontal-alignment: right;
            }
            if line.kind == "add" || line.kind == "del" || line.kind == "ctx": Text {
                width: 10px;
                text: line.kind == "add" ? "+" : line.kind == "del" ? "-" : " ";
                color: line.kind == "add" ? Theme.diff-add-text : Theme.diff-del-text;
                font-family: Theme.font-mono;
                font-size: Theme.fs-xs + 0.5px;
            }
            Text {
                horizontal-stretch: 1;
                text: line.text;
                wrap: word-wrap;
                color: line.kind == "add" ? Theme.diff-add-text
                    : line.kind == "del" ? Theme.diff-del-text
                    : line.kind == "ctx" ? Theme.text-2
                    : Theme.text-3;
                font-family: Theme.font-mono;
                font-size: Theme.fs-xs + 0.5px;
            }
        }
    }
}
