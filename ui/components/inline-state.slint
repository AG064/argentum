import { AgTheme } from "../tokens.slint";

export component InlineState inherits Rectangle {
    in property <string> label: "Ready";
    in property <bool> active: false;
    in property <bool> attention: false;

    height: AgTheme.control-height;
    min-width: content.min-width;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    background: transparent;
    accessible-role: text;
    accessible-label: root.label;

    content := HorizontalLayout {
        spacing: AgTheme.space-2;
        alignment: center;

        Rectangle {
            width: AgTheme.space-1;
            height: AgTheme.space-1;
            background: root.attention
                ? AgTheme.state-attention
                : (root.active ? AgTheme.state-active : AgTheme.state-neutral);
        }

        Text {
            text: root.label;
            color: root.attention ? AgTheme.red-100 : AgTheme.text-secondary;
            font-family: AgTheme.font-ui;
            font-size: AgTheme.type-compact;
            font-weight: AgTheme.weight-semibold;
            vertical-alignment: center;
        }
    }
}
