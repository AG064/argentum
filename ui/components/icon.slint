import { AgTheme } from "../tokens.slint";

export component AgIcon inherits Rectangle {
    in property <string> name;
    in property <color> tint: AgTheme.silver-400;
    in property <length> size: 18px;

    width: root.size;
    height: root.size;
    background: transparent;

    if root.name == "new-task": Image {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        source: @image-url("../assets/icons/lucide/square-pen.svg");
        colorize: root.tint; image-fit: contain;
    }
    if root.name == "sessions" || root.name == "session": Image {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        source: @image-url("../assets/icons/lucide/message-square.svg");
        colorize: root.tint; image-fit: contain;
