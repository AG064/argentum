    in-out property <string> verification_review_scope: "";
    in-out property <string> verification_review_binding: "";
    in-out property <[VerificationEvidenceView]> verification_evidence: [];
    in-out property <bool> verification_evidence_loading: false;
    in-out property <string> verification_evidence_error: "";
    in-out property <string> active_run_id: "";
    in-out property <bool> running: false;
    in-out property <bool> submission_pending: false;
    in-out property <bool> drawer_open: false;
    in-out property <bool> inspector_collapsed: true;
    in-out property <string> active_inspector: "";
    in-out property <bool> approval_open: false;
    in-out property <string> approval_id: "";
    in-out property <string> approval_tool_id: "";
    in-out property <string> approval_action: "";
    in-out property <string> approval_target: "";
    in-out property <string> approval_reason: "";
    in-out property <string> approval_binding: "";
    in-out property <string> approval_capabilities: "";
    in-out property <string> approval_request_scope: "once";
    in-out property <string> approval_scope: "once";
    in-out property <[ApprovalScopeChoiceView]> approval_scope_choices: [];
    in-out property <bool> approval_response_pending: false;
    in-out property <[ApprovalGrantView]> approval_grants: [];
    in-out property <bool> approval_grants_loading: false;
    in-out property <string> approval_grants_error: "";
    in-out property <bool> approval_grants_incomplete: false;
    in-out property <string> approval_grant_pending: "";
    in-out property <bool> about_open: false;
    in-out property <bool> settings_open: false;
    in-out property <bool> command_palette_open: false;
    in-out property <bool> model_menu_open: false;
    in-out property <bool> context_menu_open: false;
    in-out property <bool> reduced_motion: false;
    // Platform hosts may project native insets here. Desktop defaults remain zero.
    in-out property <length> safe_area_top: 0px;
    in-out property <length> safe_area_bottom: 0px;
    in-out property <length> keyboard_inset: 0px;

    private property <bool> provider_dirty: root.provider_draft_label != root.provider_label
        || root.provider_draft_endpoint != root.provider_endpoint
        || root.provider_draft_model != root.provider_model;
    private property <bool> provider_valid: root.provider_label_error == ""
        && root.provider_endpoint_error == ""
        && root.provider_model_error == "";
    private property <bool> provider_busy: root.provider_loading
        || root.provider_saving
        || root.provider_selecting
        || root.provider_testing
        || root.provider_credential_saving
        || root.provider_credential_deleting
        || root.provider_credential_pending != ""
        || root.provider_models_loading
        || root.provider_model_selecting;
    private property <bool> provider_models_current: root.provider_id != ""
        && root.provider_models_provider_id == root.provider_id;
    private property <bool> harness_busy: root.harness_loading || root.harness_pending != "";
    private property <bool> inspector_presented: !root.inspector_collapsed && root.active_inspector != "";
    private property <bool> work_pane_open: root.inspector_presented;
    private property <string> provider_state_label: root.provider_model_selecting
        ? "Updating model"
        : (root.provider_models_loading
            ? "Loading models"
            : (root.provider_testing
                ? "Testing connection"
                : (root.provider_probe_state == "connected"
                    ? "Connected"
                    : (root.provider_probe_state == "failed" ? "Connection failed" : "Not tested"))));
    private property <string> verification_label: root.verification_state == "passed"
        ? "Passed"
        : (root.verification_state == "failed"
            ? "Failed"
            : (root.verification_state == "stale"
                ? "Stale"
                : (root.verification_state == "ready" ? "Ready" : "Not run")));
    private property <bool> phone_layout: root.width < AgTheme.tablet-breakpoint
        || (root.height < AgTheme.mobile-landscape-height-breakpoint
            && root.width < AgTheme.shell-navigation-breakpoint);
    private property <length> phone_gutter: root.width < AgTheme.mobile-standard-breakpoint
        ? AgTheme.mobile-gutter-compact
        : AgTheme.mobile-gutter;
    private property <bool> conversation_follow_tail: true;

    changed active_session_id => {
        root.conversation_follow_tail = true;
        conversation-scroll.viewport-y = min(
            0px,
            conversation-scroll.visible-height - conversation-scroll-content.height
        );
    }

    callback submit_task(string);
    callback cancel_run(string);
    callback new_session();
    callback select_session(string);
    callback search_sessions(string);
    callback set_session_filter(string);
    callback rename_session(string, string);
    callback set_session_pinned(string, bool);
    callback set_session_archived(string, bool);
    callback fork_session(string, string);
    callback set_goal(string, int, int, int);
    callback pause_goal();
    callback resume_goal();
    callback clear_goal();
    callback probe_provider(string);
    callback save_provider_credential(string, string);
    callback clear_provider_credential(string);
    callback install_and_load_local_model();
    callback unload_local_model();
    callback open_settings();
    callback save_provider_profile(string, string, string, string, string, bool);
    callback select_provider_profile(string);
    callback refresh_provider_models(string);
    callback select_provider_model(string, string);
    callback refresh_provider_presets();
    callback add_provider_preset(string);
    callback select_provider_preset(string);
    callback refresh_browser_status();
    callback refresh_desktop_status();
    callback refresh_harness();
    callback set_harness_module(string, string);
    callback set_local_backend_enabled(bool);
    callback select_harness_profile(string);
    callback set_harness_surface_visibility(string, bool);
    callback select_execution_profile(string);
    callback set_harness_capability_enabled(string, bool);
    callback validate_provider_label(string) -> string;
    callback validate_provider_endpoint(string) -> string;
    callback validate_provider_model(string) -> string;
    callback toggle_drawer();
    callback set_inspector_surface(string);
    callback refresh_trajectory(string);
    callback load_change_diff(string);
    callback request_restore(string);
    callback load_change_recovery();
    callback retry_change_recovery(string);
    callback request_recovery_restore(string);
    callback approve_tool(string, string);
    callback reject_tool(string);
    callback refresh_approval_grants();
    callback revoke_approval_grant(string);
    callback refresh_verification();
    callback review_verification_runner(string);
    callback approve_verification_runner(string);
    callback cancel_verification_review();

    app-keyboard := FocusScope {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        focus-on-click: false;
        focus-on-tab-navigation: false;

        capture-key-pressed(event) => {
            if event.text != Key.Escape {
                return reject;
            }
            if root.approval_open {
                return accept;
            }
            if root.settings_open {
                root.settings_open = false;
                return accept;
            }
            if root.session_actions_open {
                root.session_actions_open = false;
                return accept;
            }
            if root.verification_review_open {
                root.cancel_verification_review();
                return accept;
            }
            if root.about_open {
                root.about_open = false;
                return accept;
            }
            if root.command_palette_open {
                root.command_palette_open = false;
                return accept;
            }
            if root.model_menu_open {
                root.model_menu_open = false;
                return accept;
            }
            if root.context_menu_open {
                root.context_menu_open = false;
                return accept;
            }
            if root.drawer_open {
                root.drawer_open = false;
                root.toggle_drawer();
                return accept;
            }
            if root.work_pane_open && root.width < AgTheme.work-pane-docked-breakpoint {
                root.set_inspector_surface("");
                return accept;
            }
            return reject;
        }

        KeyBinding {
            keys: @keys(Control + K);
            enabled: !root.approval_open && !root.settings_open && !root.about_open;
            activated => {
                root.command_palette_open = !root.command_palette_open;
                root.model_menu_open = false;
                root.context_menu_open = false;
            }
        }

        KeyBinding {
            keys: @keys(Control + ",");
            enabled: !root.approval_open;
            activated => {
                root.settings_open = true;
                root.about_open = false;
                root.command_palette_open = false;
                root.model_menu_open = false;
                root.context_menu_open = false;
                root.provider_loading = true;
                root.provider_pending = "list";
                root.provider_error = "";
                root.provider_notice = "";
                root.open_settings();
                if root.provider_id != "" && !root.running {
                    root.provider_models_loading = true;
                    root.provider_models_pending = "list";
                    root.provider_models_provider_id = root.provider_id;
                    root.provider_models_error = "";
                    root.refresh_provider_models(root.provider_id);
                }
            }
        }

        Rectangle {
            width: parent.width;
            height: parent.height;
            background: AgTheme.canvas;
        }

        if !root.phone_layout && root.width >= AgTheme.shell-navigation-breakpoint: Rectangle {
            x: 0px;
            y: 0px;
            width: AgTheme.navigation-width;
            height: parent.height;
            background: AgTheme.navigation;
            border-width: 1px;
            border-color: AgTheme.border-faint;

            VerticalLayout {
                padding-left: AgTheme.space-3;
                padding-right: AgTheme.space-3;
                padding-bottom: AgTheme.space-3;
                spacing: AgTheme.space-3;

                ProductLabel { }

                ActionButton {
                    label: "New session";
                    icon: "new-task";
                    fill: AgTheme.surface-soft;
                    outline-color: AgTheme.border-default;
                    reduced-motion: root.reduced_motion;
                    clicked => {
                        root.new_session();
                    }
                }

                Rectangle { height: 6px; }

                SectionHeading { label: "Project"; detail: "Local"; }

                MenuRow {
                    icon: "workspace";
                    label: root.project_name;
                    detail: root.workspace_label;
                    active: true;
                }

                SectionHeading { label: "Sessions"; detail: root.session_items.length; }

                SettingsField {
                    label: "";
                    placeholder: "Search sessions";
                    field-height: AgTheme.control-height;
                    value <=> root.session_query;
                    edited(value) => { root.search_sessions(value); }
                }

                MenuRow {
                    icon: "sessions";
                    label: "Filter";
                    detail: root.session_filter == "active"
                        ? "Active"
                        : (root.session_filter == "archived" ? "Archived" : "All");
                    active: root.session_filter != "active";
                    reduced-motion: root.reduced_motion;
                    clicked => {
                        root.session_filter = root.session_filter == "active"
                            ? "archived"
                            : (root.session_filter == "archived" ? "all" : "active");
                        root.set_session_filter(root.session_filter);
                    }
                }

                ScrollView {
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    mouse-drag-pan-enabled: true;

                    VerticalLayout {
                        spacing: AgTheme.space-1;

                        if root.session_items.length == 0: Text {
                            text: root.session_query == "" ? "No sessions in this view" : "No sessions match";
                            color: AgTheme.text-muted;
                            font-size: AgTheme.type-compact;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }

                        for session in root.session_items: SessionItem {
                            active: session.active;
                            title: session.title;
                            detail: session.active ? root.run_state : session.detail;
                            pinned: session.pinned;
                            archived: session.archived;
                            reduced-motion: root.reduced_motion;
                            clicked => {
                                if (!session.active) {
                                    root.select_session(session.id);
                                }
                            }
                            actions => {
                                root.session_actions_id = session.id;
                                root.session_actions_title = session.title;
                                root.session_actions_pinned = session.pinned;
                                root.session_actions_archived = session.archived;
                                root.session_actions_active = session.active;
                                root.session_rename_open = false;
                                root.session_fork_open = false;
                                root.session_action_error = "";
                                root.session_actions_open = true;
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: AgTheme.border-faint; }

                Rectangle {
                    height: 62px;
                    border-radius: AgTheme.radius-xs;
                    border-width: 1px;
                    border-color: provider-focus.has-focus ? AgTheme.focus-ring : transparent;
                    background: provider-touch.has-hover ? AgTheme.hover : transparent;
                    accessible-role: button;
                    accessible-label: "Model, " + root.provider_label;
                    accessible-action-default => { root.model_menu_open = true; }
                    forward-focus: provider-focus;
                    animate background, border-color {
                        duration: root.reduced_motion ? 0ms : AgTheme.motion-fast;
                    }

                    Rectangle {
                        x: 0px;
                        y: 12px;
                        width: 2px;
                        height: parent.height - 24px;
                        background: root.provider_probe_state == "failed"
                            ? AgTheme.red-400
                            : (root.provider_connected ? AgTheme.silver-300 : AgTheme.silver-700);
                    }

                    HorizontalLayout {
                        padding-left: AgTheme.space-3;
                        padding-right: AgTheme.space-1;
                        spacing: AgTheme.space-3;
                        alignment: stretch;

                        Rectangle {
                            width: 30px;
                            background: transparent;

                            AgIcon {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                name: "provider";
                                size: 18px;
                                tint: AgTheme.silver-300;
                            }

                            Rectangle {
                                x: parent.width - self.width;
                                y: (parent.height + 16px) / 2;
                                width: 6px;
                                height: 6px;
                                background: root.provider_probe_state == "failed"
                                    ? AgTheme.red-400
                                    : (root.provider_connected ? AgTheme.silver-200 : AgTheme.silver-700);
                            }
                        }

                        VerticalLayout {
                            spacing: AgTheme.optical-tight-gap;
                            alignment: center;
                            Text { text: root.provider_label; color: AgTheme.text-secondary; font-size: AgTheme.type-compact; font-weight: AgTheme.weight-semibold; }
                            Text {
                                text: root.provider_state_label;
                                color: root.provider_probe_state == "failed" ? AgTheme.text-danger : AgTheme.text-muted;
                                font-size: AgTheme.type-compact;
                            }
                        }

                        Rectangle { horizontal-stretch: 1; }

                        Rectangle {
                            width: 18px;
                            background: transparent;

                            AgIcon {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                name: "chevron-right";
                                size: 14px;
                                tint: AgTheme.silver-500;
                            }
                        }
                    }

                    provider-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            provider-focus.focus();
                            root.model_menu_open = true;
                        }
                    }

                    provider-focus := FocusScope {
                        x: 0px;
                        width: 0px;
                        focus-on-click: false;
                        focus-on-tab-navigation: true;
                        key-pressed(event) => {
                            if (event.text == " " || event.text == "\n" || event.text == Key.Return) {
                                root.model_menu_open = true;
                                return accept;
                            }
                            return reject;
                        }
                    }
                }

                RailSettingsButton {
                    reduced-motion: root.reduced_motion;
                    clicked => {
                        root.settings_open = true;
                        root.provider_loading = true;
                        root.provider_pending = "list";
                        root.provider_error = "";
                        root.provider_notice = "";
                        root.open_settings();
                        if root.provider_id != "" && !root.running {
                            root.provider_models_loading = true;
                            root.provider_models_pending = "list";
                            root.provider_models_provider_id = root.provider_id;
                            root.provider_models_error = "";
                            root.refresh_provider_models(root.provider_id);
                        }
                    }
                }
            }
        }

        workbench := Rectangle {
            visible: !root.phone_layout;
            x: root.width >= AgTheme.shell-navigation-breakpoint ? AgTheme.navigation-width : 0px;
            y: 0px;
            width: root.width
                - (root.width >= AgTheme.shell-navigation-breakpoint ? AgTheme.navigation-width : 0px)
                - (root.work_pane_open && root.width >= AgTheme.work-pane-docked-breakpoint ? AgTheme.work-pane-width : 0px);
            height: root.height;
            background: AgTheme.canvas;

            header := Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: AgTheme.header-height;
                background: AgTheme.chrome;
                border-width: 1px;
                border-color: AgTheme.border-subtle;

                HorizontalLayout {
                    padding-left: workbench.width < AgTheme.composer-compact-breakpoint ? AgTheme.space-2 : AgTheme.space-4;
                    padding-right: workbench.width < AgTheme.composer-compact-breakpoint ? AgTheme.space-2 : AgTheme.space-3;
                    spacing: AgTheme.space-2;
                    alignment: stretch;

                    if root.width < AgTheme.shell-navigation-breakpoint: HeaderAction {
                        glyph: "menu";
                        hint: "Open navigation";
                        reduced-motion: root.reduced_motion;
                        clicked => {
                            root.drawer_open = true;
                            root.toggle_drawer();
                        }
                    }

                    VerticalLayout {
                        width: workbench.width < AgTheme.composer-compact-breakpoint ? 120px : 260px;
                        spacing: AgTheme.optical-tight-gap;
                        alignment: center;
                        horizontal-stretch: 0;

                        Text {
                            text: root.session_title;
                            color: AgTheme.white-100;
                            font-size: AgTheme.type-lead;
                            font-weight: AgTheme.weight-semibold;
                            overflow: elide;
                        }

                        if workbench.width >= AgTheme.session-detail-breakpoint: Text {
                            text: root.project_name + "  /  Local workspace";
                            color: AgTheme.text-muted;
                            font-size: AgTheme.type-compact;
                            overflow: elide;
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    if workbench.width >= AgTheme.header-divider-breakpoint: Rectangle {
                        width: 124px;
                        background: transparent;

                        InlineState {
                            width: 116px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            label: root.run_state;
                            active: root.running;
                            attention: root.approval_open || root.error_message != "";
                        }
                    }

                    HeaderAction {
                        glyph: root.active_inspector == "" ? "inspector" : root.active_inspector;
                        hint: root.inspector_modes.length == 0
                            ? "No inspector surface is enabled"
                            : "Open inspector";
                        selected: root.inspector_presented;
                        enabled: root.inspector_modes.length > 0;
                        reduced-motion: root.reduced_motion;
                        clicked => {
                            root.command_palette_open = false;
                            root.model_menu_open = false;
                            root.context_menu_open = false;
                            root.trajectory_error = "";
                            if root.inspector_presented {
                                root.set_inspector_surface("");
                            } else if root.active_inspector != "" {
                                root.set_inspector_surface(root.active_inspector);
                            } else if root.inspector_modes.length > 0 {
                                root.set_inspector_surface(root.inspector_modes[0].id);
                            }
                        }
                    }

                    HeaderAction {
                        glyph: "more";
                        hint: "More actions";
                        selected: root.command_palette_open;
                        reduced-motion: root.reduced_motion;
                        clicked => {
                            root.command_palette_open = !root.command_palette_open;
                            root.model_menu_open = false;
                            root.context_menu_open = false;
                        }
                    }
                }

                Rectangle {
                    x: workbench.width < AgTheme.composer-compact-breakpoint ? 8px : 16px;
                    y: parent.height - 2px;
                    width: 36px;
                    height: 2px;
                    background: root.approval_open
                        ? AgTheme.state-attention
                        : (root.running ? AgTheme.silver-300 : AgTheme.silver-700);
                }
            }

            conversation-scroll := ScrollView {
                x: 0px;
                y: AgTheme.header-height;
                width: parent.width;
                height: parent.height - AgTheme.header-height
                    - (workbench.width < AgTheme.composer-compact-breakpoint ? 172px : 160px);
                viewport-width: self.width;
                mouse-drag-pan-enabled: true;
                scrolled => {
                    root.conversation_follow_tail = self.viewport-y
                        <= min(0px, self.visible-height - conversation-scroll-content.height)
                            + AgTheme.space-12;
                }

                conversation-scroll-content := VerticalLayout {
                    padding-top: workbench.width < AgTheme.composer-compact-breakpoint ? AgTheme.space-6 : AgTheme.space-10;
                    padding-bottom: AgTheme.space-9;

                    changed height => {
                        if root.conversation_follow_tail {
                            conversation-scroll.viewport-y = min(
                                0px,
                                conversation-scroll.visible-height - self.height
                            );
                        }
                    }

                    HorizontalLayout {
                        padding-left: workbench.width < AgTheme.composer-compact-breakpoint ? AgTheme.space-4 : AgTheme.space-7;
                        padding-right: workbench.width < AgTheme.composer-compact-breakpoint ? AgTheme.space-4 : AgTheme.space-7;

                        Rectangle { horizontal-stretch: 1; }

                        Rectangle {
                            horizontal-stretch: 8;
                            max-width: AgTheme.work-content-max-width;
                            background: transparent;

                            ConversationSurface {
                                user-prompt: root.user_prompt;
                                messages: root.conversation_messages;
                                transcript: root.transcript;
                                error-message: root.error_message;
                                provider-connected: root.provider_connected;
                                provider-label: root.provider_label;
                                plan-summary: root.plan_summary;
                                plan-steps: root.plan_steps;
                                verification-state: root.verification_state;
                                verification-summary: root.verification_summary;
                                running: root.running;
                                run-state: root.run_state;
                                current-reasoning: root.current_reasoning;
                                current-reasoning-available: root.current_reasoning_available;
                                current-provider-label: root.current_run_provider_label;
                                current-model: root.current_run_model;
                                usage-reported: root.usage_reported;
                                input-tokens: root.usage_input_tokens;
                                output-tokens: root.usage_output_tokens;
                                total-tokens: root.usage_total_tokens;
                                context-window-reported: root.context_window_reported;
                                context-window-tokens: root.context_window_tokens;
                                reduced-motion: root.reduced_motion;
                            }
                        }

                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }

            Rectangle {
                x: 0px;
                y: parent.height - (workbench.width < AgTheme.composer-compact-breakpoint ? 172px : 160px);
                width: parent.width;
                height: workbench.width < AgTheme.composer-compact-breakpoint ? 172px : 160px;
                background: AgTheme.canvas;
                border-width: 0px;

                VerticalLayout {
                    padding-top: AgTheme.space-3;
                    padding-bottom: AgTheme.space-2;
                    spacing: AgTheme.space-2;

                    HorizontalLayout {
                        padding-left: workbench.width < AgTheme.composer-compact-breakpoint ? AgTheme.space-3 : AgTheme.space-6;
                        padding-right: workbench.width < AgTheme.composer-compact-breakpoint ? AgTheme.space-3 : AgTheme.space-6;

                        Rectangle { horizontal-stretch: 1; }

                        Composer {
                            horizontal-stretch: 8;
                            max-width: AgTheme.work-content-max-width;
                            draft <=> root.draft;
                            provider-label: root.provider_label;
                            workspace-label: root.project_name;
                            running: root.running;
                            approval-pending: root.approval_open;
                            submission-pending: root.submission_pending;
                            active-run-id: root.active_run_id;
                            reduced-motion: root.reduced_motion;
                            submit(prompt) => { root.draft = prompt; root.submit_task(prompt); }
                            cancel(run-id) => { root.cancel_run(run-id); }
                            open-model => {
                                root.model_menu_open = !root.model_menu_open;
                                root.context_menu_open = false;
                                root.command_palette_open = false;
                            }
                            open-context => {
                                root.context_menu_open = !root.context_menu_open;
                                root.model_menu_open = false;
                                root.command_palette_open = false;
                            }
                        }

                        Rectangle { horizontal-stretch: 1; }
                    }

                    Text {
                        text: root.approval_open
                            ? "Review the pending approval to continue"
                            : (root.execution_profile_id == "read-only"
                                ? "Read only. File changes are disabled"
                                : "Confirm before changes. File writes require approval");
                        color: root.approval_open ? AgTheme.red-100 : AgTheme.text-muted;
                        font-size: AgTheme.type-compact;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        if root.phone_layout: MobileShell {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
            draft <=> root.draft;
            session-title: root.session_title;
            run-state: root.run_state;
            running: root.running;
            attention: root.approval_open || root.error_message != "";
            inspector-enabled: root.inspector_modes.length > 0;
            user-prompt: root.user_prompt;
            messages: root.conversation_messages;
            transcript: root.transcript;
            error-message: root.error_message;
            provider-connected: root.provider_connected;
            provider-label: root.provider_label;
            workspace-label: root.project_name;
            plan-summary: root.plan_summary;
            plan-steps: root.plan_steps;
            verification-state: root.verification_state;
            verification-summary: root.verification_summary;
            current-reasoning: root.current_reasoning;
            current-reasoning-available: root.current_reasoning_available;
            current-provider-label: root.current_run_provider_label;
            current-model: root.current_run_model;
            usage-reported: root.usage_reported;
            usage-input-tokens: root.usage_input_tokens;
            usage-output-tokens: root.usage_output_tokens;
            usage-total-tokens: root.usage_total_tokens;
            context-window-reported: root.context_window_reported;
            context-window-tokens: root.context_window_tokens;
            approval-pending: root.approval_open;
            submission-pending: root.submission_pending;
            active-run-id: root.active_run_id;
            reduced-motion: root.reduced_motion;
            gutter: root.phone_gutter;
            safe-top: root.safe_area_top;
            safe-bottom: root.safe_area_bottom;
            keyboard-inset: root.keyboard_inset;
            open-sessions => {
                root.drawer_open = true;
                root.command_palette_open = false;
                root.model_menu_open = false;
                root.context_menu_open = false;
                root.toggle_drawer();
            }
            open-activity => {
                root.drawer_open = false;
                root.command_palette_open = false;
                root.model_menu_open = false;
                root.context_menu_open = false;
                if root.inspector_modes.length > 0 {
                    root.set_inspector_surface(
                        root.active_inspector != "" ? root.active_inspector : root.inspector_modes[0].id
                    );
                }
            }
            open-more => {
                root.command_palette_open = true;
                root.drawer_open = false;
                root.model_menu_open = false;
                root.context_menu_open = false;
            }
            open-model => {
                root.model_menu_open = true;
                root.context_menu_open = false;
                root.command_palette_open = false;
            }
            open-context => {
                root.context_menu_open = true;
                root.model_menu_open = false;
                root.command_palette_open = false;
            }
            submit(prompt) => { root.draft = prompt; root.submit_task(prompt); }
            cancel(run-id) => { root.cancel_run(run-id); }
        }

        if !root.phone_layout && root.work_pane_open && root.width >= AgTheme.work-pane-docked-breakpoint: Rectangle {
            x: root.width - AgTheme.work-pane-width;
            y: 0px;
            width: AgTheme.work-pane-width;
            height: root.height;
            background: AgTheme.navigation;
            border-width: 1px;
            border-color: AgTheme.border-subtle;

            InspectorSurface {
                x: AgTheme.space-5;
                y: AgTheme.space-3;
                width: parent.width - AgTheme.space-10;
                height: parent.height - AgTheme.space-7;
                modes: root.inspector_modes;
                active-mode: root.active_inspector;
                activity-items: root.activity_items;
                activity-summary: root.activity_summary;
                trajectory-items: root.trajectory_items;
                trajectory-summary: root.trajectory_summary;
                trajectory-loading: root.trajectory_loading;
                trajectory-truncated: root.trajectory_truncated;
                trajectory-error: root.trajectory_error;
                goal-available: root.goal_available;
                goal-objective: root.goal_objective;
                goal-draft <=> root.goal_draft;
                goal-state: root.goal_state;
                goal-next-action: root.goal_next_action;
                goal-iteration: root.goal_iteration;
                goal-tokens-used: root.goal_tokens_used;
                goal-token-budget: root.goal_token_budget;
                goal-token-budget-reported: root.goal_token_budget_reported;
                goal-tools-used: root.goal_tools_used;
                goal-tool-budget: root.goal_tool_budget;
                goal-tool-budget-reported: root.goal_tool_budget_reported;
                goal-time-budget-seconds: root.goal_time_budget_seconds;
                goal-time-budget-reported: root.goal_time_budget_reported;
                goal-verification-count: root.goal_verification_count;
                goal-busy: root.goal_action_pending || root.running;
                change-summary: root.change_summary;
                change-files: root.change_files;
                changed-files: root.changed_files;
                additions: root.additions;
                removals: root.removals;
                selected-file-change-id: root.selected_file_change_id;
                selected-change-path: root.selected_change_path;
                selected-diff: root.selected_diff;
                selected-diff-available: root.selected_diff_available;
                selected-diff-truncated: root.selected_diff_truncated;
                selected-diff-reason: root.selected_diff_reason;
                selected-restore-available: root.selected_restore_available;
                selected-restore-reason: root.selected_restore_reason;
                recovery-required: root.recovery_required;
                recovery-summary: root.recovery_summary;
                recovery-operation-id: root.recovery_operation_id;
                verification-state: root.verification_state;
                verification-label: root.verification_label;
                verification-summary: root.verification_summary;
                verification-runners: root.verification_runners;
                verification-runner-count: root.verification_runner_count;
                verification-runners-loading: root.verification_runners_loading;
                verification-runners-error: root.verification_runners_error;
                verification-approve-pending: root.verification_approve_pending;
                verification-review-open: root.verification_review_open;
                verification-review-runner: root.verification_review_runner;
                verification-review-command: root.verification_review_command;
                verification-review-scope: root.verification_review_scope;
                verification-review-binding: root.verification_review_binding;
                verification-evidence: root.verification_evidence;
                verification-evidence-loading: root.verification_evidence_loading;
                verification-evidence-error: root.verification_evidence_error;
                active-session-id: root.active_session_id;
                reduced-motion: root.reduced_motion;
                select-mode(mode) => { root.set_inspector_surface(mode); }
                close => { root.set_inspector_surface(""); }
                refresh-trajectory(session-id) => {
                    root.trajectory_loading = true;
                    root.trajectory_error = "";
                    root.refresh_trajectory(session-id);
                }
                load-change-diff(file-change-id) => { root.load_change_diff(file-change-id); }
                request-restore(file-change-id) => { root.request_restore(file-change-id); }
                load-change-recovery => { root.load_change_recovery(); }
                retry-change-recovery(operation-id) => { root.retry_change_recovery(operation-id); }
                request-recovery-restore(operation-id) => { root.request_recovery_restore(operation-id); }
                refresh-verification => { root.refresh_verification(); }
                review-verification-runner(runner) => { root.review_verification_runner(runner); }
                approve-verification-runner(runner) => { root.approve_verification_runner(runner); }
                cancel-verification-review => { root.cancel_verification_review(); }
                set-goal(objective, token-budget, tool-budget, time-budget-seconds) => {
                    root.set_goal(objective, token-budget, tool-budget, time-budget-seconds);
                }
                pause-goal => { root.pause_goal(); }
                resume-goal => { root.resume_goal(); }
                clear-goal => { root.clear_goal(); }
            }
        }

        general-scrim := Rectangle {
            visible: root.drawer_open
                || root.settings_open
                || root.about_open
                || root.session_actions_open
                || root.command_palette_open
                || root.model_menu_open
                || root.context_menu_open
                || (root.work_pane_open && root.width < AgTheme.work-pane-docked-breakpoint);
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
            background: AgTheme.scrim;

            TouchArea {
                enabled: !root.phone_layout;
                clicked => {
                    if root.drawer_open {
                        root.drawer_open = false;
                        root.toggle_drawer();
                    }
                    if root.inspector_presented && root.width < AgTheme.work-pane-docked-breakpoint {
                        root.set_inspector_surface("");
                    }
                    root.settings_open = false;
                    root.about_open = false;
                    root.session_actions_open = false;
                    root.command_palette_open = false;
                    root.model_menu_open = false;
                    root.context_menu_open = false;
                }
            }
        }

        if root.drawer_open: Rectangle {
            x: root.phone_layout ? root.phone_gutter : 0px;
            y: root.phone_layout ? root.safe_area_top + AgTheme.space-2 : 0px;
            width: root.phone_layout
                ? root.width - root.phone_gutter * 2
                : (root.width < AgTheme.navigation-drawer-breakpoint ? root.width - AgTheme.space-2 : 320px);
            height: root.phone_layout
                ? root.height - root.safe_area_top - root.safe_area_bottom - AgTheme.space-2
                : root.height;
            border-radius: root.phone_layout ? AgTheme.radius-lg : 0px;
            background: AgTheme.navigation;
            border-width: AgTheme.hairline;
            border-color: AgTheme.border-default;

            VerticalLayout {
                padding-left: AgTheme.space-3;
                padding-right: AgTheme.space-3;
                padding-bottom: AgTheme.space-4;
                spacing: AgTheme.space-3;

                HorizontalLayout {
                    height: AgTheme.header-height;
                    alignment: stretch;
                    ProductLabel { }
                    Rectangle { horizontal-stretch: 1; }

                    HeaderAction {
                        glyph: "close";
                        hint: "Close navigation";
                        target-size: root.phone_layout ? AgTheme.mobile-control-height : AgTheme.control-height;
                        clicked => {
                            root.drawer_open = false;
                            root.toggle_drawer();
                        }
                    }
                }

                ActionButton {
                    label: "New session";
                    icon: "new-task";
                    fill: AgTheme.surface-soft;
                    outline-color: AgTheme.border-default;
                    target-height: root.phone_layout ? AgTheme.mobile-control-height : AgTheme.control-height;
                    clicked => {
                        root.drawer_open = false;
                        root.new_session();
                    }
                }

                SectionHeading { label: "Project"; detail: "Local"; }
                MenuRow { icon: "workspace"; label: root.project_name; detail: root.workspace_label; active: true; }
                SectionHeading { label: "Sessions"; detail: root.session_items.length; }
                ScrollView {
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    mouse-drag-pan-enabled: true;

                    VerticalLayout {
                        spacing: AgTheme.space-1;

                        for session in root.session_items: SessionItem {
                            active: session.active;
                            title: session.title;
                            detail: session.active ? root.run_state : session.detail;
                            pinned: session.pinned;
                            archived: session.archived;
                            reduced-motion: root.reduced_motion;
                            clicked => {
                                if (!session.active) {
                                    root.drawer_open = false;
                                    root.select_session(session.id);
                                }
                            }
                            actions => {
                                root.drawer_open = false;
                                root.session_actions_id = session.id;
                                root.session_actions_title = session.title;
                                root.session_actions_pinned = session.pinned;
                                root.session_actions_archived = session.archived;
                                root.session_actions_active = session.active;
                                root.session_rename_open = false;
                                root.session_fork_open = false;
                                root.session_action_error = "";
                                root.session_actions_open = true;
                            }
                        }
                    }
                }
                MenuRow {
                    icon: "settings";
                    label: "Settings";
                    detail: "Provider and interface";
                    clicked => {
                        root.drawer_open = false;
                        root.settings_open = true;
                        root.provider_loading = true;
                        root.provider_pending = "list";
                        root.provider_error = "";
                        root.provider_notice = "";
                        root.open_settings();
                        if root.provider_id != "" && !root.running {
                            root.provider_models_loading = true;
                            root.provider_models_pending = "list";
                            root.provider_models_provider_id = root.provider_id;
                            root.provider_models_error = "";
                            root.refresh_provider_models(root.provider_id);
                        }
                    }
                }
            }
        }

        if root.work_pane_open && root.width < AgTheme.work-pane-docked-breakpoint: Rectangle {
            x: root.phone_layout ? root.phone_gutter : AgTheme.space-2;
            y: root.phone_layout
                ? max(root.safe_area_top + AgTheme.space-2, root.height - root.safe_area_bottom - AgTheme.mobile-sheet-height)
                : (root.height < AgTheme.review-overlay-height-breakpoint ? AgTheme.space-2 : root.height - 492px);
            width: root.phone_layout ? root.width - root.phone_gutter * 2 : root.width - AgTheme.space-4;
            height: root.phone_layout
                ? min(AgTheme.mobile-sheet-height, root.height - root.safe_area_top - root.safe_area_bottom - AgTheme.space-4)
                : 484px;
            border-radius: root.phone_layout ? AgTheme.radius-lg : AgTheme.radius-xs;
            border-width: AgTheme.hairline;
            border-color: AgTheme.silver-700;
            background: AgTheme.navigation;

            InspectorSurface {
                x: AgTheme.space-4;
                y: AgTheme.space-3;
                width: parent.width - AgTheme.space-8;
                height: parent.height - AgTheme.space-7;
                modes: root.inspector_modes;
                active-mode: root.active_inspector;
                activity-items: root.activity_items;
                activity-summary: root.activity_summary;
                trajectory-items: root.trajectory_items;
                trajectory-summary: root.trajectory_summary;
                trajectory-loading: root.trajectory_loading;
                trajectory-truncated: root.trajectory_truncated;
                trajectory-error: root.trajectory_error;
                goal-available: root.goal_available;
                goal-objective: root.goal_objective;
                goal-draft <=> root.goal_draft;
                goal-state: root.goal_state;
                goal-next-action: root.goal_next_action;
                goal-iteration: root.goal_iteration;
                goal-tokens-used: root.goal_tokens_used;
                goal-token-budget: root.goal_token_budget;
                goal-token-budget-reported: root.goal_token_budget_reported;
                goal-tools-used: root.goal_tools_used;
                goal-tool-budget: root.goal_tool_budget;
                goal-tool-budget-reported: root.goal_tool_budget_reported;
                goal-time-budget-seconds: root.goal_time_budget_seconds;
                goal-time-budget-reported: root.goal_time_budget_reported;
                goal-verification-count: root.goal_verification_count;
                goal-busy: root.goal_action_pending || root.running;
                change-summary: root.change_summary;
                change-files: root.change_files;
                changed-files: root.changed_files;
                additions: root.additions;
                removals: root.removals;
                selected-file-change-id: root.selected_file_change_id;
                selected-change-path: root.selected_change_path;
                selected-diff: root.selected_diff;
                selected-diff-available: root.selected_diff_available;
                selected-diff-truncated: root.selected_diff_truncated;
                selected-diff-reason: root.selected_diff_reason;
                selected-restore-available: root.selected_restore_available;
                selected-restore-reason: root.selected_restore_reason;
                recovery-required: root.recovery_required;
                recovery-summary: root.recovery_summary;
                recovery-operation-id: root.recovery_operation_id;
                verification-state: root.verification_state;
                verification-label: root.verification_label;
                verification-summary: root.verification_summary;
                verification-runners: root.verification_runners;
                verification-runner-count: root.verification_runner_count;
                verification-runners-loading: root.verification_runners_loading;
                verification-runners-error: root.verification_runners_error;
                verification-approve-pending: root.verification_approve_pending;
                verification-review-open: root.verification_review_open;
                verification-review-runner: root.verification_review_runner;
                verification-review-command: root.verification_review_command;
                verification-review-scope: root.verification_review_scope;
                verification-review-binding: root.verification_review_binding;
                verification-evidence: root.verification_evidence;
                verification-evidence-loading: root.verification_evidence_loading;
                verification-evidence-error: root.verification_evidence_error;
                active-session-id: root.active_session_id;
                touch-mode: root.phone_layout;
                reduced-motion: root.reduced_motion;
                select-mode(mode) => { root.set_inspector_surface(mode); }
                close => { root.set_inspector_surface(""); }
                refresh-trajectory(session-id) => {
                    root.trajectory_loading = true;
                    root.trajectory_error = "";
                    root.refresh_trajectory(session-id);
                }
                load-change-diff(file-change-id) => { root.load_change_diff(file-change-id); }
                request-restore(file-change-id) => { root.request_restore(file-change-id); }
                load-change-recovery => { root.load_change_recovery(); }
                retry-change-recovery(operation-id) => { root.retry_change_recovery(operation-id); }
                request-recovery-restore(operation-id) => { root.request_recovery_restore(operation-id); }
                refresh-verification => { root.refresh_verification(); }
                review-verification-runner(runner) => { root.review_verification_runner(runner); }
                approve-verification-runner(runner) => { root.approve_verification_runner(runner); }
                cancel-verification-review => { root.cancel_verification_review(); }
                set-goal(objective, token-budget, tool-budget, time-budget-seconds) => {
                    root.set_goal(objective, token-budget, tool-budget, time-budget-seconds);
                }
                pause-goal => { root.pause_goal(); }
                resume-goal => { root.resume_goal(); }
                clear-goal => { root.clear_goal(); }
            }
        }

        if root.command_palette_open: Rectangle {
            x: root.phone_layout ? root.phone_gutter : (root.width < AgTheme.command-palette-breakpoint ? AgTheme.space-3 : (root.width - 460px) / 2);
            y: root.phone_layout
                ? max(root.safe_area_top + AgTheme.space-2, root.height - root.safe_area_bottom - AgTheme.mobile-menu-sheet-height)
                : (root.width < AgTheme.command-palette-breakpoint ? 74px : 88px);
            width: root.phone_layout ? root.width - root.phone_gutter * 2 : (root.width < AgTheme.command-palette-breakpoint ? root.width - AgTheme.space-6 : 460px);
            height: root.phone_layout ? min(AgTheme.mobile-menu-sheet-height, root.height - root.safe_area_top - root.safe_area_bottom - AgTheme.space-4) : 390px;
            border-radius: root.phone_layout ? AgTheme.radius-lg : AgTheme.radius-xs;
            border-width: AgTheme.hairline;
            border-color: AgTheme.silver-600;
            background: AgTheme.raised;

            Rectangle { x: 12px; y: 0px; width: 42px; height: 2px; background: AgTheme.silver-300; }

            VerticalLayout {
                padding: AgTheme.space-3;
                spacing: AgTheme.space-1;

                PanelHeader { title: "Actions"; close => { root.command_palette_open = false; } }
                MenuRow { icon: "new-task"; label: "New session"; detail: "Start a new task session"; clicked => { root.command_palette_open = false; root.new_session(); } }
                MenuRow {
                    icon: root.active_inspector == "" ? "inspector" : root.active_inspector;
                    label: "Inspector";
                    detail: root.inspector_modes.length == 0
                        ? "No inspector surface is enabled"
                        : "Review, activity, and trajectory";
                    enabled: root.inspector_modes.length > 0;
                    clicked => {
                        root.command_palette_open = false;
                        root.trajectory_error = "";
                        if root.active_inspector != "" {
                            root.set_inspector_surface(root.active_inspector);
                        } else if root.inspector_modes.length > 0 {
                            root.set_inspector_surface(root.inspector_modes[0].id);
                        }
                    }
                }
                MenuRow {
                    icon: "settings";
                    label: "Settings";
                    detail: "Provider and interface";
                    clicked => {
                        root.command_palette_open = false;
                        root.settings_open = true;
                        root.provider_loading = true;
                        root.provider_pending = "list";
                        root.provider_error = "";
                        root.provider_notice = "";
                        root.open_settings();
                        if root.provider_id != "" && !root.running {
                            root.provider_models_loading = true;
                            root.provider_models_pending = "list";
                            root.provider_models_provider_id = root.provider_id;
                            root.provider_models_error = "";
                            root.refresh_provider_models(root.provider_id);
                        }
                    }
                }
                MenuRow { label: "About Argentum"; detail: "Identity and runtime"; clicked => { root.command_palette_open = false; root.about_open = true; } }
            }
        }

        if root.model_menu_open: Rectangle {
            x: root.phone_layout ? root.phone_gutter : (root.width < AgTheme.compact-menu-width-breakpoint ? AgTheme.space-3 : (root.width - AgTheme.model-menu-width) / 2);
            y: root.phone_layout
                ? max(root.safe_area_top + AgTheme.space-2, root.height - root.safe_area_bottom - AgTheme.mobile-menu-sheet-height)
                : max(AgTheme.space-3, root.height - AgTheme.model-menu-panel-height - AgTheme.space-10);
            width: root.phone_layout ? root.width - root.phone_gutter * 2 : (root.width < AgTheme.compact-menu-width-breakpoint ? root.width - AgTheme.space-6 : AgTheme.model-menu-width);
            height: root.phone_layout
                ? min(AgTheme.mobile-menu-sheet-height, root.height - root.safe_area_top - root.safe_area_bottom - AgTheme.space-4)
                : min(AgTheme.model-menu-panel-height, root.height - AgTheme.space-6);
            border-radius: root.phone_layout ? AgTheme.radius-lg : AgTheme.radius-xs;
            border-width: AgTheme.hairline;
            border-color: AgTheme.silver-600;
            background: AgTheme.raised;

            Rectangle { x: 12px; y: 0px; width: 42px; height: 2px; background: AgTheme.silver-300; }

            VerticalLayout {
                padding: AgTheme.space-3;
                spacing: AgTheme.space-2;
                PanelHeader { icon: "model"; title: "Model"; detail: root.provider_state_label; close => { root.model_menu_open = false; } }

                Rectangle {
                    height: AgTheme.provider-profile-picker-height;
                    border-radius: AgTheme.radius-md;
                    border-width: AgTheme.hairline;
                    border-color: AgTheme.border-subtle;
                    background: AgTheme.chrome;
                    clip: true;

                    ScrollView {
                        viewport-width: self.width;
                        mouse-drag-pan-enabled: true;

                        VerticalLayout {
                            padding: AgTheme.space-1;
                            spacing: AgTheme.optical-tight-gap;

                            if root.provider_profiles.length == 0: Text {
                                text: root.provider_loading ? "Loading profiles" : "No provider profiles available";
                                color: AgTheme.text-muted;
                                font-size: AgTheme.type-compact;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            for profile in root.provider_profiles: MenuRow {
                                icon: "provider";
                                label: profile.label;
                                detail: profile.model
                                    + (profile.credential_supported
                                        ? (profile.credential_configured ? " | Key saved" : " | Key missing")
                                        : "");
                                active: profile.selected;
                                enabled: !root.running
                                    && !root.provider_busy
                                    && (!root.provider_dirty || profile.selected);
                                reduced-motion: root.reduced_motion;
                                clicked => {
                                    if (!profile.selected) {
                                        root.provider_selecting = true;
                                        root.provider_pending = "select";
                                        root.provider_error = "";
                                        root.provider_notice = "";
                                        root.provider_models_loading = true;
                                        root.provider_models_pending = "list";
                                        root.provider_models_provider_id = profile.id;
                                        root.provider_models_error = "";
                                        root.select_provider_profile(profile.id);
                                        root.refresh_provider_models(profile.id);
                                    }
                                }
                            }
                        }
                    }
                }

                ContextUsagePanel {
                    usage-reported: root.usage_reported;
                    input-tokens: root.usage_input_tokens;
                    output-tokens: root.usage_output_tokens;
                    total-tokens: root.usage_total_tokens;
                    context-window-reported: root.context_window_reported;
                    context-window-tokens: root.context_window_tokens;
                }

                MenuRow {
                    icon: "settings";
                    label: "Provider settings";
                    detail: root.provider_dirty
                        ? "Unsaved changes need review"
                        : root.provider_label + " | " + root.provider_kind_label;
                    clicked => {
                        root.model_menu_open = false;
                        root.settings_open = true;
                        root.provider_loading = true;
                        root.provider_pending = "list";
                        root.provider_error = "";
                        root.provider_notice = "";
                        root.open_settings();
                        if root.provider_id != "" && !root.running {
                            root.provider_models_loading = true;
                            root.provider_models_pending = "list";
                            root.provider_models_provider_id = root.provider_id;
                            root.provider_models_error = "";
                            root.refresh_provider_models(root.provider_id);
                        }
                    }
                }
                ActionButton {
                    label: root.provider_testing ? "Testing connection" : "Test connection";
                    icon: "activity";
                    enabled: !root.running
                        && !root.provider_dirty
                        && root.provider_valid
                        && !root.provider_busy
                        && root.provider_id != "";
                    fill: AgTheme.surface-soft;
                    outline-color: AgTheme.border-default;
                    reduced-motion: root.reduced_motion;
                    clicked => {
                        root.provider_testing = true;
                        root.provider_pending = "probe";
                        root.provider_probe_state = "testing";
                        root.provider_error = "";
                        root.provider_notice = "";
                        root.probe_provider(root.provider_id);
                    }
                }
            }
        }

        if root.session_actions_open: Rectangle {
            x: root.phone_layout
                ? root.phone_gutter
                : min(root.width - AgTheme.model-menu-width - AgTheme.space-3, AgTheme.navigation-width + AgTheme.space-3);
            y: root.phone_layout
                ? max(root.safe_area_top + AgTheme.space-2, root.height - root.safe_area_bottom - AgTheme.mobile-menu-sheet-height)
                : AgTheme.header-height + AgTheme.space-2;
            width: root.phone_layout
                ? root.width - root.phone_gutter * 2
                : AgTheme.model-menu-width;
            height: root.phone_layout
                ? min(AgTheme.mobile-menu-sheet-height, root.height - root.safe_area_top - root.safe_area_bottom - AgTheme.space-4)
                : min(AgTheme.model-menu-panel-height, root.height - AgTheme.header-height - AgTheme.space-6);
            border-radius: root.phone_layout ? AgTheme.radius-lg : AgTheme.radius-xs;
            border-width: AgTheme.hairline;
            border-color: AgTheme.silver-600;
            background: AgTheme.raised;

            Rectangle { x: 12px; y: 0px; width: 42px; height: 2px; background: AgTheme.silver-300; }

            VerticalLayout {
                padding: AgTheme.space-3;
                spacing: AgTheme.space-2;

                PanelHeader {
                    icon: "sessions";
                    title: "Session actions";
                    detail: root.session_actions_title;
                    close => { root.session_actions_open = false; }
                }

                MenuRow {
                    icon: "command";
                    label: "Rename session";
                    detail: root.session_rename_open ? "Close title field" : "Change the session title";
                    active: root.session_rename_open;
                    reduced-motion: root.reduced_motion;
                    clicked => {
                        root.session_rename_open = !root.session_rename_open;
                        root.session_fork_open = false;
                        root.session_rename_draft = root.session_actions_title;
                        root.session_action_error = "";
                    }
                }

                if root.session_rename_open: VerticalLayout {
                    spacing: AgTheme.space-2;
                    SettingsField {
                        label: "Session title";
                        placeholder: "Session title";
                        value <=> root.session_rename_draft;
                    }
                    ActionButton {
                        label: "Save title";
                        enabled: root.session_rename_draft != "" && !root.session_action_pending;
                        primary: true;
                        reduced-motion: root.reduced_motion;
                        clicked => {
                            root.rename_session(root.session_actions_id, root.session_rename_draft);
                            root.session_rename_open = false;
                        }
                    }
                }

                MenuRow {
                    icon: "check";
                    label: root.session_actions_pinned ? "Unpin session" : "Pin session";
                    detail: root.session_actions_pinned ? "Pinned sessions stay at the top" : "Keep this session at the top";
                    active: root.session_actions_pinned;
                    enabled: !root.session_action_pending;
                    reduced-motion: root.reduced_motion;
                    clicked => {
                        root.set_session_pinned(root.session_actions_id, !root.session_actions_pinned);
                    }
                }

                MenuRow {
                    icon: "changes";
                    label: root.session_actions_archived ? "Unarchive session" : "Archive session";
                    detail: root.session_actions_active
                        ? "Select another session first"
                        : (root.session_actions_archived ? "Return it to the active list" : "Hide it from the active list");
                    active: root.session_actions_archived;
                    enabled: !root.session_actions_active && !root.session_action_pending;
                    reduced-motion: root.reduced_motion;
                    clicked => {
                        root.set_session_archived(root.session_actions_id, !root.session_actions_archived);
                    }
                }

                MenuRow {
                    icon: "new-task";
                    label: "Fork session";
                    detail: root.session_fork_open ? "Close fork field" : "Copy this session into a new branch";
                    active: root.session_fork_open;
                    enabled: !root.session_action_pending;
                    reduced-motion: root.reduced_motion;
                    clicked => {
                        root.session_fork_open = !root.session_fork_open;
                        root.session_rename_open = false;
                        root.session_fork_draft = root.session_actions_title + " fork";
                        root.session_action_error = "";
                    }
                }

                if root.session_fork_open: VerticalLayout {
                    spacing: AgTheme.space-2;
                    SettingsField {
                        label: "Fork title";
                        placeholder: "Fork title";
                        value <=> root.session_fork_draft;
                    }
                    ActionButton {
                        label: root.session_action_pending ? "Creating fork" : "Create fork";
                        enabled: root.session_fork_draft != "" && !root.session_action_pending;
                        primary: true;
                        reduced-motion: root.reduced_motion;
                        clicked => {
                            root.fork_session(root.session_actions_id, root.session_fork_draft);
                            root.session_fork_open = false;
                        }
                    }
                }

                if root.session_action_pending: Text {
                    text: "Applying session change";
                    color: AgTheme.text-muted;
                    font-size: AgTheme.type-compact;
                }

                if root.session_action_error != "": Text {
                    text: root.session_action_error;
                    color: AgTheme.red-100;
                    font-size: AgTheme.type-compact;
                    wrap: word-wrap;
                }
            }
        }

        if root.context_menu_open: Rectangle {
            x: root.phone_layout ? root.phone_gutter : (root.width < AgTheme.compact-menu-width-breakpoint ? AgTheme.space-3 : (root.width - 380px) / 2);
            y: root.phone_layout
                ? max(root.safe_area_top + AgTheme.space-2, root.height - root.safe_area_bottom - AgTheme.mobile-context-sheet-height)
                : (root.height < AgTheme.context-menu-height-breakpoint ? AgTheme.space-3 : root.height - 372px);
            width: root.phone_layout ? root.width - root.phone_gutter * 2 : (root.width < AgTheme.compact-menu-width-breakpoint ? root.width - AgTheme.space-6 : 380px);
            height: root.phone_layout ? min(AgTheme.mobile-context-sheet-height, root.height - root.safe_area_top - root.safe_area_bottom - AgTheme.space-4) : 246px;
            border-radius: root.phone_layout ? AgTheme.radius-lg : AgTheme.radius-xs;
            border-width: AgTheme.hairline;
            border-color: AgTheme.silver-600;
            background: AgTheme.raised;

            Rectangle { x: 12px; y: 0px; width: 42px; height: 2px; background: AgTheme.silver-300; }

            VerticalLayout {
                padding: AgTheme.space-3;
                spacing: AgTheme.space-2;
                PanelHeader { icon: "workspace"; title: "Execution scope"; detail: root.project_name; close => { root.context_menu_open = false; } }
                MenuRow { icon: "workspace"; label: root.project_name; detail: root.workspace_label; active: true; clicked => { root.context_menu_open = false; } }
                MenuRow {
                    icon: "approval";
                    label: root.execution_profile_label;
                    detail: root.execution_profile_id == "read-only"
                        ? "Workspace reads are allowed. File changes are disabled."
                        : "Workspace reads are allowed. Every file write needs approval.";
                    active: true;
                    clicked => { root.context_menu_open = false; }
                }
            }
        }

        if root.settings_open: Rectangle {
            x: root.phone_layout
                ? 0px
                : (root.width < AgTheme.settings-dialog-width-breakpoint
                ? AgTheme.space-3
                : (root.width - AgTheme.settings-dialog-width) / 2);
            y: root.phone_layout
                ? root.safe_area_top
                : (root.height < AgTheme.settings-dialog-height-breakpoint
                ? AgTheme.space-3
                : (root.height - AgTheme.settings-dialog-height) / 2);
            width: root.phone_layout
                ? root.width
                : (root.width < AgTheme.settings-dialog-width-breakpoint
                ? root.width - AgTheme.space-6
                : AgTheme.settings-dialog-width);
            height: root.phone_layout
                ? root.height - root.safe_area_top - root.safe_area_bottom
                : (root.height < AgTheme.settings-dialog-height-breakpoint
                ? root.height - AgTheme.space-6
                : AgTheme.settings-dialog-height);
            border-radius: root.phone_layout ? 0px : AgTheme.radius-xs;
            border-width: AgTheme.hairline;
            border-color: AgTheme.silver-700;
            background: AgTheme.navigation;

            Rectangle {
                x: AgTheme.space-5;
                y: 0px;
                width: AgTheme.space-10;
                height: AgTheme.accent-bar-width;
                background: root.provider_error == "" ? AgTheme.silver-400 : AgTheme.red-400;
            }

            VerticalLayout {
                padding: root.phone_layout ? AgTheme.space-4 : AgTheme.space-5;
                spacing: AgTheme.space-3;

                PanelHeader {
                    title: "Settings";
                    detail: "Provider and interface";
                    close => { root.settings_open = false; }
                }

                ScrollView {
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    mouse-drag-pan-enabled: true;

                    VerticalLayout {
                        padding-right: AgTheme.space-1;
                        spacing: AgTheme.space-3;

                Text {
                    text: "Choose the model provider Argentum uses for this workspace.";
                    color: AgTheme.text-muted;
                    font-size: AgTheme.type-body;
                    wrap: word-wrap;
                }

                        SectionHeading {
                            label: "Provider catalog";
                            detail: root.provider_presets.length;
                        }

                        Text {
                            text: "Choose a preset, review its requirements, then add it as a saved profile.";
                            color: AgTheme.text-muted;
                            font-size: AgTheme.type-compact;
                            wrap: word-wrap;
                        }

                        if root.provider_presets_loading: Text {
                            text: "Loading provider presets";
                            color: AgTheme.text-muted;
                            font-size: AgTheme.type-compact;
                        }

                        if root.provider_presets_error != "": Text {
                            text: root.provider_presets_error;
                            color: AgTheme.text-danger;
                            font-size: AgTheme.type-compact;
                            wrap: word-wrap;
                        }

                        VerticalLayout {
                            spacing: AgTheme.space-1;

                            SectionHeading { label: "Hosted"; detail: "Remote providers"; }
                            for preset in root.provider_presets_hosted: PresetRow { preset: preset; selected: root.provider_preset_detail.id == preset.id; reduced-motion: root.reduced_motion; clicked => { root.select_provider_preset(preset.id); } }

                            SectionHeading { label: "Aggregators"; detail: "Multi-model routes"; }
                            for preset in root.provider_presets_aggregator: PresetRow { preset: preset; selected: root.provider_preset_detail.id == preset.id; reduced-motion: root.reduced_motion; clicked => { root.select_provider_preset(preset.id); } }

                            SectionHeading { label: "Local"; detail: "On-device routes"; }
                            for preset in root.provider_presets_local: PresetRow { preset: preset; selected: root.provider_preset_detail.id == preset.id; reduced-motion: root.reduced_motion; clicked => { root.select_provider_preset(preset.id); } }

                            SectionHeading { label: "Custom"; detail: "Explicit configuration"; }
                            for preset in root.provider_presets_custom: PresetRow { preset: preset; selected: root.provider_preset_detail.id == preset.id; reduced-motion: root.reduced_motion; clicked => { root.select_provider_preset(preset.id); } }

                            SectionHeading { label: "Unsupported"; detail: "Reference only"; }
                            for preset in root.provider_presets_unsupported: PresetRow { preset: preset; selected: false; reduced-motion: root.reduced_motion; }
                        }


                        if root.provider_preset_detail.id != "": Rectangle {
                            border-radius: AgTheme.radius-md;
                            border-width: AgTheme.hairline;
                            border-color: AgTheme.border-subtle;
                            background: AgTheme.chrome;

                            VerticalLayout {
                                padding: AgTheme.space-3;
                                spacing: AgTheme.space-2;

                                Text {
                                    text: root.provider_preset_detail.label + " | " + root.provider_preset_detail.kind_label;
                                    color: AgTheme.white-100;
                                    font-size: AgTheme.type-section-title;
                                    font-weight: AgTheme.weight-semibold;
                                    wrap: word-wrap;
                                }

                                Text {
                                    text: "Endpoint: " + (root.provider_preset_detail.endpoint == "" ? "Set when saving the profile" : root.provider_preset_detail.endpoint);
                                    color: AgTheme.text-secondary;
                                    font-size: AgTheme.type-compact;
                                    wrap: word-wrap;
                                }

                                Text {
                                    text: "Default model: " + root.provider_preset_detail.default_model;
                                    color: AgTheme.text-secondary;
                                    font-size: AgTheme.type-compact;
                                    wrap: word-wrap;
                                }

                                Text {
                                    text: "Credential: " + root.provider_preset_detail.credential;
                                    color: AgTheme.text-secondary;
                                    font-size: AgTheme.type-compact;
                                    wrap: word-wrap;
                                }

                                if root.provider_preset_detail.api_key_env != "": Text {
                                    text: "Environment variable: " + root.provider_preset_detail.api_key_env;
                                    color: AgTheme.text-muted;
                                    font-size: AgTheme.type-compact;
                                    wrap: word-wrap;
                                }

                                if root.provider_preset_detail.notes != "": Text {
                                    text: root.provider_preset_detail.notes;
                                    color: AgTheme.text-muted;
                                    font-size: AgTheme.type-compact;
                                    wrap: word-wrap;
                                }

                                if root.provider_preset_detail.docs_url != "": Text {
                                    text: "Docs: " + root.provider_preset_detail.docs_url;
                                    color: AgTheme.text-tertiary;
                                    font-size: AgTheme.type-metadata;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    spacing: AgTheme.space-2;
                                    ActionButton {
                                        label: root.provider_preset_pending == root.provider_preset_detail.id
                                            ? "Adding provider"
                                            : "Add provider";
                                        enabled: root.provider_preset_detail.supported
                                            && root.provider_preset_pending == ""
                                            && !root.running;
                                        primary: true;
                                        reduced-motion: root.reduced_motion;
                                        clicked => { root.add_provider_preset(root.provider_preset_detail.id); }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    ActionButton {
                                        label: "Refresh catalog";
                                        enabled: !root.provider_presets_loading;
                                        fill: AgTheme.surface-soft;
                                        outline-color: AgTheme.border-default;
                                        reduced-motion: root.reduced_motion;
                                        clicked => { root.refresh_provider_presets(); }
                                    }
                                }
                            }
                        }

                        if root.provider_preset_notice != "": Text {
                            text: root.provider_preset_notice;
                            color: AgTheme.silver-300;
                            font-size: AgTheme.type-compact;
                            wrap: word-wrap;
                        }

                        Text {
                            text: "Budget and context limits are not available in this UI build. Use the CLI provider budget and provider context commands.";
                            color: AgTheme.text-muted;
                            font-size: AgTheme.type-compact;
                            wrap: word-wrap;
                        }

                        Text {
                            text: "ChatGPT account login and account selection remain CLI-only in this build. Use provider login chatgpt and provider accounts chatgpt.";
                            color: AgTheme.text-muted;
                            font-size: AgTheme.type-compact;
                            wrap: word-wrap;
                        }

                        Rectangle { height: AgTheme.hairline; background: AgTheme.border-faint; }

                SectionHeading { label: "Provider profiles"; detail: root.provider_profiles.length; }

                Rectangle {
                    height: AgTheme.provider-profile-list-height;
                    border-radius: AgTheme.radius-md;
                    border-width: AgTheme.hairline;
                    border-color: AgTheme.border-subtle;
                    background: AgTheme.chrome;
                    clip: true;

                    ScrollView {
                        viewport-width: self.width;
                        mouse-drag-pan-enabled: true;

                        VerticalLayout {
                            padding: AgTheme.space-1;
                            spacing: AgTheme.optical-tight-gap;

                            if root.provider_profiles.length == 0: Text {
                                text: root.provider_loading ? "Loading provider profiles" : "No provider profiles are available";
                                color: AgTheme.text-muted;
                                font-size: AgTheme.type-body;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }

                            for profile in root.provider_profiles: MenuRow {
                                icon: "provider";
                                label: profile.label;
                                detail: profile.kind_label + " | " + profile.model
                                    + (profile.credential_supported
                                        ? (profile.credential_configured ? " | Key saved" : " | Key missing")
                                        : "");
                                active: profile.selected;
                                enabled: !root.running
                                    && !root.provider_busy
                                    && (!root.provider_dirty || profile.selected);
                                reduced-motion: root.reduced_motion;
                                clicked => {
                                    if (!profile.selected) {
                                        root.provider_selecting = true;
                                        root.provider_pending = "select";
                                        root.provider_error = "";
                                        root.provider_notice = "";
                                        root.provider_models_loading = true;
                                        root.provider_models_pending = "list";
                                        root.provider_models_provider_id = profile.id;
                                        root.provider_models_error = "";
                                        root.select_provider_profile(profile.id);
                                        root.refresh_provider_models(profile.id);
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle { height: AgTheme.hairline; background: AgTheme.border-faint; }

                VerticalLayout {
                    padding-right: AgTheme.space-1;
                    spacing: AgTheme.space-3;

                        SectionHeading {
                            label: root.provider_id == "" ? "Selected profile" : root.provider_label;
                            detail: root.provider_id;
                        }

                        MenuRow {
                            icon: "model";
                            label: "Provider type";
                            detail: root.provider_kind_label;
                            active: true;
                            enabled: false;
                        }

                        SettingsField {
                            label: "Profile name";
                            placeholder: "LM Studio";
                            value: root.provider_draft_label;
                            error: root.provider_label_error;
                            enabled: root.provider_id != "" && !root.running && !root.provider_busy;
                            field-height: root.phone_layout ? AgTheme.mobile-control-height : AgTheme.control-height;
                            edited(value) => {
                                root.provider_draft_label = value;
                                root.provider_label_error = root.validate_provider_label(value);
                                root.provider_notice = "";
                            }
                        }

                        SettingsField {
                            label: "Endpoint";
                            placeholder: "http://127.0.0.1:1234/v1/";
                            value: root.provider_draft_endpoint;
                            error: root.provider_endpoint_error;
                            enabled: root.provider_id != "" && !root.running && !root.provider_busy;
                            field-height: root.phone_layout ? AgTheme.mobile-control-height : AgTheme.control-height;
                            edited(value) => {
                                root.provider_draft_endpoint = value;
                                root.provider_endpoint_error = root.validate_provider_endpoint(value);
                                root.provider_notice = "";
                            }
                        }

                        SectionHeading {
                            label: "Model catalog";
                            detail: root.provider_models_loading
                                ? "Refreshing"
                                : (root.provider_models_current
                                    ? root.provider_models.length + " available"
                                    : "Not loaded");
                        }

                        HorizontalLayout {
                            height: root.phone_layout ? AgTheme.mobile-control-height : AgTheme.control-height;
                            spacing: AgTheme.space-2;

                            Text {
                                text: root.provider_models_error != ""
                                    ? root.provider_models_error
                                    : "Models reported by this provider";
                                color: root.provider_models_error != "" ? AgTheme.text-danger : AgTheme.text-muted;
                                font-size: AgTheme.type-compact;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }

                            ActionButton {
                                label: root.provider_models_loading ? "Refreshing" : "Refresh models";
                                icon: "activity";
                                enabled: root.provider_id != ""
                                    && !root.running
                                    && !root.provider_dirty
                                    && !root.provider_busy;
                                target-height: root.phone_layout
                                    ? AgTheme.mobile-control-height
                                    : AgTheme.control-height;
                                fill: AgTheme.surface-soft;
                                outline-color: AgTheme.border-default;
                                reduced-motion: root.reduced_motion;
                                clicked => {
                                    root.provider_models_loading = true;
                                    root.provider_models_pending = "list";
                                    root.provider_models_provider_id = root.provider_id;
                                    root.provider_models_error = "";
                                    root.provider_notice = "";
                                    root.refresh_provider_models(root.provider_id);
                                }
                            }
                        }

                        Rectangle {
                            height: AgTheme.provider-model-list-height;
                            border-radius: AgTheme.radius-md;
                            border-width: AgTheme.hairline;
                            border-color: root.provider_models_error == ""
                                ? AgTheme.border-subtle
                                : AgTheme.red-700;
                            background: AgTheme.chrome;
                            clip: true;

                            ScrollView {
                                viewport-width: self.width;
                                mouse-drag-pan-enabled: true;

                                VerticalLayout {
                                    padding: AgTheme.space-1;
                                    spacing: AgTheme.optical-tight-gap;

                                    if root.provider_models_loading: Text {
                                        text: "Loading provider models";
                                        color: AgTheme.text-muted;
                                        font-size: AgTheme.type-body;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    if !root.provider_models_loading
                                        && (!root.provider_models_current || root.provider_models.length == 0): Text {
                                        text: root.provider_models_error != ""
                                            ? "The model catalog could not be loaded"
                                            : "No catalog models reported. Enter a custom model below.";
                                        color: root.provider_models_error != "" ? AgTheme.text-danger : AgTheme.text-muted;
                                        font-size: AgTheme.type-compact;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        wrap: word-wrap;
                                    }

                                    if root.provider_models_current: VerticalLayout {
                                        spacing: AgTheme.optical-tight-gap;

                                        for model in root.provider_models: MenuRow {
                                            icon: "model";
                                            label: model.label == "" ? model.id : model.label;
                                            detail: (model.label != "" && model.label != model.id ? model.id + " | " : "")
                                                + (model.context_window_reported
                                                    ? model.context_window_tokens + " token context"
                                                    : "Context limit unknown");
                                            active: model.selected;
                                            enabled: !root.running
                                                && !root.provider_dirty
                                                && !root.provider_busy;
                                            reduced-motion: root.reduced_motion;
                                            clicked => {
                                                if (!model.selected) {
                                                    root.provider_model_selecting = true;
                                                    root.provider_models_pending = "select";
                                                    root.provider_error = "";
                                                    root.provider_notice = "";
                                                    root.select_provider_model(root.provider_id, model.id);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        SettingsField {
                            label: "Custom model ID";
                            placeholder: "local-model";
                            value: root.provider_draft_model;
                            error: root.provider_model_error;
                            enabled: root.provider_id != "" && !root.running && !root.provider_busy;
                            field-height: root.phone_layout ? AgTheme.mobile-control-height : AgTheme.control-height;
                            edited(value) => {
                                root.provider_draft_model = value;
                                root.provider_model_error = root.validate_provider_model(value);
                                root.provider_notice = "";
                            }
                        }

                        Text {
                            text: "Catalog selection updates this profile only. Use the custom field when a model is not listed.";
                            color: AgTheme.text-muted;
                            font-size: AgTheme.type-compact;
                            wrap: word-wrap;
                        }

                        Rectangle {
                            min-height: AgTheme.space-16;
                            border-radius: AgTheme.radius-md;
                            border-width: AgTheme.hairline;
                            border-color: root.provider_error == "" ? AgTheme.border-subtle : AgTheme.red-600;
                            background: root.provider_error == "" ? AgTheme.surface-soft : AgTheme.attention-surface;

                            if root.provider_error != "": Rectangle {
                                x: 0px;
                                y: AgTheme.space-2;
                                width: AgTheme.accent-bar-width;
                                height: parent.height - AgTheme.space-4;
                                background: AgTheme.red-400;
                            }

                            VerticalLayout {
                                padding-left: AgTheme.space-3;
                                padding-right: AgTheme.space-3;
                                padding-top: AgTheme.space-2;
                                padding-bottom: AgTheme.space-2;
                                spacing: AgTheme.space-1;

                                Text {
                                    text: root.provider_dirty ? "Unsaved changes" : root.provider_state_label;
                                    color: root.provider_error == "" ? AgTheme.text-secondary : AgTheme.red-100;
                                    font-size: AgTheme.type-body;
                                    font-weight: AgTheme.weight-semibold;
                                }

                                Text {
                                    text: root.provider_error != ""
                                        ? root.provider_error
                                        : (root.provider_dirty
                                            ? "Save before testing or switching profiles."
                                            : (root.provider_notice != "" ? root.provider_notice : root.provider_detail));
                                    color: root.provider_error == "" ? AgTheme.text-muted : AgTheme.text-danger;
                                    font-size: AgTheme.type-compact;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        Text {
                            visible: root.provider_kind == "anthropic";
                            text: "Anthropic credentials are not stored in this profile. Configure credentials outside Argentum before testing.";
                            color: AgTheme.text-muted;
                            font-size: AgTheme.type-compact;
                            wrap: word-wrap;
                        }

                        if root.provider_credential_supported: VerticalLayout {
                            spacing: AgTheme.space-2;

                            SectionHeading {
                                label: "Provider API key";
                                detail: root.provider_credential_configured ? "Saved securely" : "Not configured";
                            }

                            Text {
                                text: "Keys are kept in the operating-system secure store and are never shown again after saving.";
                                color: AgTheme.text-muted;
                                font-size: AgTheme.type-compact;
                                wrap: word-wrap;
                            }

                            SettingsField {
                                label: "API key";
                                placeholder: root.provider_credential_configured ? "Enter a replacement key" : "Paste provider API key";
                                value: root.provider_credential_draft;
                                error: root.provider_credential_error;
                                password: true;
                                enabled: !root.running && !root.provider_busy;
                                field-height: root.phone_layout ? AgTheme.mobile-control-height : AgTheme.control-height;
                                edited(value) => {
                                    root.provider_credential_draft = value;
                                    root.provider_credential_error = "";
                                    root.provider_credential_notice = "";
                                }
                            }

                            HorizontalLayout {
                                height: root.phone_layout ? AgTheme.mobile-control-height : AgTheme.control-height;
                                spacing: AgTheme.space-2;

                                ActionButton {
                                    label: root.provider_credential_saving
                                        ? "Saving"
                                        : (root.provider_credential_configured ? "Replace key" : "Save key");
                                    icon: "check";
                                    primary: true;
                                    enabled: root.provider_credential_draft != ""
                                        && !root.running
                                        && !root.provider_busy;
                                    reduced-motion: root.reduced_motion;
                                    target-height: root.phone_layout ? AgTheme.mobile-control-height : AgTheme.control-height;
                                    clicked => {
                                        root.provider_credential_saving = true;
                                        root.provider_credential_pending = "save";
                                        root.provider_credential_error = "";
                                        root.provider_credential_notice = "";
                                        root.save_provider_credential(root.provider_id, root.provider_credential_draft);
                                    }
                                }

                                ActionButton {
                                    label: root.provider_credential_deleting ? "Removing" : "Delete saved key";
                                    icon: "close";
                                    enabled: root.provider_credential_configured
                                        && !root.running
                                        && !root.provider_busy;
                                    fill: AgTheme.chrome;
                                    outline-color: AgTheme.border-subtle;
                                    reduced-motion: root.reduced_motion;
                                    target-height: root.phone_layout ? AgTheme.mobile-control-height : AgTheme.control-height;
                                    clicked => {
                                        root.provider_credential_deleting = true;
                                        root.provider_credential_pending = "delete";
                                        root.provider_credential_error = "";
                                        root.provider_credential_notice = "";
                                        root.clear_provider_credential(root.provider_id);
                                    }
                                }
                            }

                            Text {
                                visible: root.provider_credential_notice != "";
                                text: root.provider_credential_notice;
                                color: AgTheme.text-muted;
                                font-size: AgTheme.type-compact;
                                wrap: word-wrap;
                            }
                        }

                        if root.local_inference_available: VerticalLayout {
                            spacing: AgTheme.space-2;

                            Rectangle { height: AgTheme.hairline; background: AgTheme.border-faint; }

                            SectionHeading {
                                label: "On-device model";
                                detail: root.local_inference_active
                                    ? "Loaded"
                                    : (root.local_inference_busy ? "Working" : "Optional");
                            }

                            Text {
                                text: root.local_inference_detail;
                                color: AgTheme.text-muted;
                                font-size: AgTheme.type-compact;
                                wrap: word-wrap;
                            }

                            HorizontalLayout {
                                height: root.phone_layout ? AgTheme.mobile-control-height : AgTheme.control-height;
                                spacing: AgTheme.space-2;

                                ActionButton {
                                    label: root.local_inference_busy
                                        ? "Preparing"
                                        : (root.local_inference_active ? "Reload model" : "Download and load");
                                    icon: "model";
                                    primary: true;
                                    enabled: !root.running && !root.local_inference_busy
                                        && (!root.local_backend_available || root.local_backend_ready);
                                    reduced-motion: root.reduced_motion;
                                    target-height: root.phone_layout ? AgTheme.mobile-control-height : AgTheme.control-height;
                                    clicked => {
                                        root.local_inference_busy = true;
                                        root.local_inference_detail = "Verifying and preparing the pinned model.";
                                        root.install_and_load_local_model();
                                    }
                                }

                                ActionButton {
                                    label: "Unload";
                                    icon: "close";
                                    enabled: root.local_inference_active
                                        && !root.running
                                        && !root.local_inference_busy;
                                    fill: AgTheme.chrome;
                                    outline-color: AgTheme.border-subtle;
                                    reduced-motion: root.reduced_motion;
                                    target-height: root.phone_layout ? AgTheme.mobile-control-height : AgTheme.control-height;
                                    clicked => {
                                        root.local_inference_busy = true;
                                        root.local_inference_detail = "Stopping active inference and unloading the model.";
                                        root.unload_local_model();
                                    }
                                }
                            }
                        }

                        Rectangle { height: AgTheme.hairline; background: AgTheme.border-faint; }

                        SectionHeading {
                            label: "Browser";
                            detail: root.browser_extensions_built
                                ? (root.browser_configured
                                    ? (root.browser_saved_active ? "Configured, active" : "Configured, inactive")
                                    : "Not configured")
                                : "Not built";
                        }

                        Text {
                            text: "Optional first-party Playwright adapter for reviewed loopback local development. Status only: no Node process, browser or preview is started.";
                            color: AgTheme.text-muted;
                            font-size: AgTheme.type-compact;
                            wrap: word-wrap;
                        }

                        Text {
                            text: "Extensions build: " + (root.browser_extensions_built ? "included" : "not included");
                            color: AgTheme.text-secondary;
                            font-size: AgTheme.type-compact;
                            wrap: word-wrap;
                        }

                        Text {
                            text: "Configuration: " + (root.browser_configured
                                ? (root.browser_saved_active ? "saved and marked active" : "saved but inactive")
                                : "no browser extension record");
                            color: AgTheme.text-secondary;
                            font-size: AgTheme.type-compact;
                            wrap: word-wrap;
                        }

                        if root.browser_configured: Text {
                            text: "Definition readiness: " + (root.browser_definition_ready ? "ready" : "not ready")
                                + (root.browser_readiness_detail == "" ? "" : " | " + root.browser_readiness_detail);
                            color: AgTheme.text-muted;
                            font-size: AgTheme.type-compact;
                            wrap: word-wrap;
                        }

                        if root.browser_allowed_tools != "": Text {
                            text: "Allowed tools: " + root.browser_allowed_tools;
                            color: AgTheme.text-muted;
                            font-size: AgTheme.type-compact;
                            wrap: word-wrap;
                        }

                        Text {
                            text: "Setup: argentum extensions browser setup --source DIR --node FILE --origin http://127.0.0.1:PORT";
                            color: AgTheme.text-tertiary;
                            font-family: AgTheme.font-code;
                            font-size: AgTheme.type-metadata;
                            wrap: word-wrap;
                        }

                        Text {
                            text: "Status: argentum extensions browser status";
                            color: AgTheme.text-tertiary;
                            font-family: AgTheme.font-code;
                            font-size: AgTheme.type-metadata;
                            wrap: word-wrap;
                        }

                        Text {
                            text: "Loopback origins only. Activation requires the local owner console. Saved activation is not a running process.";
                            color: AgTheme.text-muted;
                            font-size: AgTheme.type-compact;
                            wrap: word-wrap;
                        }

                        if root.browser_qualification != "": Text {
                            text: root.browser_qualification;
                            color: AgTheme.text-tertiary;
                            font-size: AgTheme.type-metadata;
                            wrap: word-wrap;
                        }

                        if root.browser_status_error != "": Text {
                            text: root.browser_status_error;
                            color: AgTheme.text-danger;
                            font-size: AgTheme.type-compact;
                            wrap: word-wrap;
                        }

                        ActionButton {
                            label: root.browser_status_loading ? "Loading browser status" : "Refresh browser status";
                            enabled: !root.browser_status_loading;
                            fill: AgTheme.surface-soft;
                            outline-color: AgTheme.border-default;
                            reduced-motion: root.reduced_motion;
                            clicked => { root.refresh_browser_status(); }
                        }

                        Rectangle { height: AgTheme.hairline; background: AgTheme.border-faint; }

                        SectionHeading {
                            label: "Desktop control";
                            detail: root.desktop_summary;
                        }

                        Text {
                            text: root.desktop_capability_text;
                            color: AgTheme.text-secondary;
                            font-size: AgTheme.type-compact;
                            wrap: word-wrap;
                        }

                        Text {
                            text: root.desktop_reason;
                            color: AgTheme.text-muted;
                            font-size: AgTheme.type-compact;
                            wrap: word-wrap;
                        }

                        for tool in root.desktop_tools: Text {
                            text: tool.id + " | " + tool.risk + " | " + tool.summary;
                            color: AgTheme.text-secondary;
                            font-size: AgTheme.type-compact;
                            wrap: word-wrap;
                        }

                        Text {
                            text: "Every desktop call requires a current owner grant. Input is approval-gated. No desktop window was enumerated and no input was sent by this status view.";
                            color: AgTheme.text-tertiary;
                            font-size: AgTheme.type-metadata;
                            wrap: word-wrap;
                        }

                        if root.desktop_status_error != "": Text {
                            text: root.desktop_status_error;
                            color: AgTheme.text-danger;
                            font-size: AgTheme.type-compact;
                            wrap: word-wrap;
                        }

                        ActionButton {
                            label: root.desktop_status_loading ? "Loading desktop status" : "Refresh desktop status";
                            enabled: !root.desktop_status_loading;
                            fill: AgTheme.surface-soft;
                            outline-color: AgTheme.border-default;
                            reduced-motion: root.reduced_motion;
                            clicked => { root.refresh_desktop_status(); }
                        }

                        Rectangle { height: AgTheme.hairline; background: AgTheme.border-faint; }

                        SectionHeading {
                            label: "Execution policy";
                            detail: root.harness_loading ? "Loading" : root.execution_profile_label;
                        }

                        Text {
                            text: "Execution policy is saved for this project and enforced by the Rust tool boundary.";
                            color: AgTheme.text-muted;
                            font-size: AgTheme.type-compact;
                            wrap: word-wrap;
                        }

                        for profile in root.harness_execution_profiles: MenuRow {
                            icon: profile.id == "read-only" ? "approval" : "check";
                            label: profile.label;
                            detail: profile.detail;
                            active: profile.selected;
                            enabled: profile.selectable
                                && !profile.selected
                                && !root.running
                                && !root.harness_busy;
                            reduced-motion: root.reduced_motion;
                            clicked => {
                                root.harness_error = "";
                                root.select_execution_profile(profile.id);
                            }
                        }

                        Rectangle { height: AgTheme.hairline; background: AgTheme.border-faint; }

                        SectionHeading { label: "Modules"; detail: "Optional features"; }

                        if root.local_backend_available: VerticalLayout {
                            spacing: AgTheme.space-2;
                            SectionHeading { label: "Local inference backend"; detail: root.local_backend_enabled ? "Enabled" : "Disabled"; }
                            Text { text: root.local_backend_detail; color: AgTheme.text-muted; font-size: AgTheme.type-compact; wrap: word-wrap; }
                            if root.local_backend_toggle_supported: ActionButton {
                                label: root.local_backend_enabled ? "Disable backend" : "Enable backend";
                                enabled: !root.running && !root.harness_busy && !root.local_inference_busy;
                                reduced-motion: root.reduced_motion;
                                clicked => { root.set_local_backend_enabled(!root.local_backend_enabled); }
                            }
                        }

                        for module in root.harness_modules: VerticalLayout {
                            spacing: AgTheme.space-2;
                            Text {
                                text: module.label + " | " + (module.recovery_pending ? "Cleanup needed" : (module.enabled ? "Enabled" : (module.installed ? "Disabled" : "Not installed")));
                                color: AgTheme.text-primary;
                                font-size: AgTheme.type-body;
                                wrap: word-wrap;
                            }
                            Text { text: module.detail; color: AgTheme.text-muted; font-size: AgTheme.type-compact; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: AgTheme.space-2;
                                height: root.phone_layout ? AgTheme.mobile-control-height : AgTheme.control-height;
                                ActionButton {
                                    label: module.recovery_pending ? "Retry cleanup" : (!module.installed ? "Install" : (module.enabled ? "Disable" : "Enable"));
                                    enabled: !root.running && !root.harness_busy;
                                    reduced-motion: root.reduced_motion;
                                    clicked => { root.set_harness_module(module.id, module.recovery_pending ? "disable" : (!module.installed ? "install" : (module.enabled ? "disable" : "enable"))); }
                                }
                                if module.installed: ActionButton {
                                    label: "Remove";
                                    enabled: !root.running && !root.harness_busy && !module.recovery_pending;
                                    reduced-motion: root.reduced_motion;
                                    clicked => { root.set_harness_module(module.id, "remove"); }
                                }
                            }
                        }

                        if root.diagnostics_enabled: VerticalLayout {
                            spacing: AgTheme.space-2;
                            MenuRow {
                                icon: "activity";
                                label: "Session diagnostics";
                                detail: root.diagnostics_detail;
                                active: root.diagnostics_open;
                                clicked => { root.diagnostics_open = !root.diagnostics_open; }
                            }
                            if root.diagnostics_open: VerticalLayout {
                                spacing: AgTheme.space-2;
                                Text { text: "Metadata only. Memory capture is cleared when disabled or the app closes."; color: AgTheme.text-muted; font-size: AgTheme.type-compact; wrap: word-wrap; }
                                ActionButton { label: "Refresh capture"; enabled: !root.harness_busy; reduced-motion: root.reduced_motion; clicked => { root.refresh_harness(); } }
                                for record in root.diagnostic_records: VerticalLayout {
                                    Text { text: record.code; color: AgTheme.text-primary; font-size: AgTheme.type-body; wrap: word-wrap; }
                                    Text { text: record.detail; color: AgTheme.text-muted; font-size: AgTheme.type-compact; wrap: word-wrap; }
                                }
                            }
                        }

                        SectionHeading {
                            label: "Harness profile";
                            detail: root.harness_loading ? "Loading" : root.harness_profile_id;
                        }

                        Text {
                            text: "Profiles change presentation only. They do not grant tools or permissions.";
                            color: AgTheme.text-muted;
                            font-size: AgTheme.type-compact;
                            wrap: word-wrap;
                        }

                        if root.harness_error != "": Text {
                            text: root.harness_error;
                            color: AgTheme.text-danger;
                            font-size: AgTheme.type-compact;
                            wrap: word-wrap;
                        }

                        if root.harness_profiles.length == 0: Text {
                            text: root.harness_loading
                                ? "Loading harness profiles"
                                : "Harness state is not available";
                            color: AgTheme.text-muted;
                            font-size: AgTheme.type-body;
                            wrap: word-wrap;
                        }

                        for profile in root.harness_profiles: MenuRow {
                            icon: "workspace";
                            label: profile.label;
                            detail: profile.detail;
                            active: profile.selected;
                            enabled: profile.selectable
                                && !profile.selected
                                && !root.harness_busy;
                            reduced-motion: root.reduced_motion;
                            clicked => {
                                root.harness_error = "";
                                root.select_harness_profile(profile.id);
                            }
                        }

                        MenuRow {
                            icon: "inspector";
                            label: "Surfaces";
                            detail: root.harness_surfaces.length + " registered | "
                                + (root.harness_surfaces_open ? "Hide details" : "Show details");
                            active: root.harness_surfaces_open;
                            enabled: !root.harness_loading;
                            reduced-motion: root.reduced_motion;
                            clicked => {
                                root.harness_surfaces_open = !root.harness_surfaces_open;
                            }
                        }

                        if root.harness_surfaces_open: VerticalLayout {
                            spacing: AgTheme.optical-tight-gap;

                            for surface in root.harness_surfaces: MenuRow {
                                icon: surface.state == "unavailable" ? "alert" : "inspector";
                                label: surface.label;
                                detail: surface.state + " | " + surface.detail;
                                active: surface.visible;
                                enabled: surface.configurable
                                    && !root.harness_busy;
                                reduced-motion: root.reduced_motion;
                                clicked => {
                                    root.harness_error = "";
                                    root.set_harness_surface_visibility(surface.id, !surface.visible);
                                }
                            }
                        }

                        MenuRow {
                            icon: "activity";
                            label: "Capability catalog";
                            detail: root.harness_capabilities.length + " registered | "
                                + (root.harness_capabilities_open ? "Hide details" : "Show details");
                            active: root.harness_capabilities_open;
                            enabled: !root.harness_loading;
                            reduced-motion: root.reduced_motion;
                            clicked => {
                                root.harness_capabilities_open = !root.harness_capabilities_open;
                            }
                        }

                        if root.harness_capabilities_open: VerticalLayout {
                            spacing: AgTheme.optical-tight-gap;

                            for capability in root.harness_capabilities: MenuRow {
                                icon: capability.state == "unavailable"
                                    ? "alert"
                                    : (capability.enabled ? "check" : "approval");
                                label: capability.label;
                                detail: capability.state + " | " + capability.detail;
                                active: capability.enabled;
                                enabled: capability.configurable
                                    && !root.running
                                    && !root.harness_busy;
                                reduced-motion: root.reduced_motion;
                                clicked => {
                                    root.harness_error = "";
                                    root.set_harness_capability_enabled(
                                        capability.id,
                                        !capability.enabled
                                    );
                                }
                            }
                        }

                        SectionHeading {
                            label: "Approval grants";
                            detail: root.approval_grants_incomplete
                                ? root.approval_grants.length + " shown"
                                : root.approval_grants.length;
                        }

                        Text {
                            text: "Persistent grants issued by this owner. Revoking takes effect immediately.";
                            color: AgTheme.text-muted;
                            font-size: AgTheme.type-compact;
                            wrap: word-wrap;
                        }

                        if root.approval_grants_loading: Text {
                            text: "Loading approval grants";
                            color: AgTheme.text-muted;
                            font-size: AgTheme.type-compact;
                        }

                        if root.approval_grants_error != "": Text {
                            text: root.approval_grants_error;
                            color: AgTheme.text-danger;
                            font-size: AgTheme.type-compact;
                            wrap: word-wrap;
                        }

                        if !root.approval_grants_loading && root.approval_grants.length == 0: Text {
                            text: "No approval grants recorded.";
                            color: AgTheme.text-muted;
                            font-size: AgTheme.type-compact;
                            wrap: word-wrap;
                        }

                        for grant in root.approval_grants: Rectangle {
                            min-height: 112px;
                            border-radius: AgTheme.radius-md;
                            border-width: AgTheme.hairline;
                            border-color: AgTheme.border-subtle;
                            background: AgTheme.chrome;

                            VerticalLayout {
                                padding: AgTheme.space-3;
                                spacing: AgTheme.space-1;

                                Text {
                                    text: grant.capability + " | " + grant.scope;
                                    color: AgTheme.white-100;
                                    font-size: AgTheme.type-body;
                                    font-weight: AgTheme.weight-semibold;
                                }

                                Text {
                                    text: grant.subject;
                                    color: AgTheme.text-secondary;
                                    font-size: AgTheme.type-compact;
                                    wrap: word-wrap;
                                    overflow: elide;
                                }

                                Text {
                                    text: grant.reason;
                                    color: AgTheme.text-muted;
                                    font-size: AgTheme.type-compact;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    spacing: AgTheme.space-2;
                                    Text {
                                        text: grant.created;
                                        color: AgTheme.text-tertiary;
                                        font-size: AgTheme.type-metadata;
                                        vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    ActionButton {
                                        label: root.approval_grant_pending == grant.id ? "Revoking" : "Revoke";
                                        enabled: root.approval_grant_pending == "";
                                        fill: AgTheme.surface-soft;
                                        outline-color: AgTheme.border-default;
                                        reduced-motion: root.reduced_motion;
                                        clicked => { root.revoke_approval_grant(grant.id); }
                                    }
                                }
                            }
                        }

                        SectionHeading { label: "Interface"; detail: "Local preferences"; }

                        Text {
                            text: "Workspace: " + root.workspace_label;
                            color: AgTheme.text-muted;
                            font-size: AgTheme.type-compact;
                            wrap: word-wrap;
                        }

                        MenuRow {
                            icon: "motion";
                            label: "Reduced motion";
                            detail: root.reduced_motion ? "On" : "Off";
                            active: root.reduced_motion;
                            reduced-motion: root.reduced_motion;
                            clicked => { root.reduced_motion = !root.reduced_motion; }
                        }

                        MenuRow {
                            icon: root.active_inspector == "" ? "inspector" : root.active_inspector;
                            label: "Inspector";
                            detail: root.inspector_presented ? "Open" : "Closed";
                            active: root.inspector_presented;
                            enabled: root.inspector_modes.length > 0;
                            reduced-motion: root.reduced_motion;
                            clicked => {
                                root.trajectory_error = "";
                                if root.inspector_presented {
                                    root.set_inspector_surface("");
                                } else if root.active_inspector != "" {
                                    root.set_inspector_surface(root.active_inspector);
                                } else if root.inspector_modes.length > 0 {
                                    root.set_inspector_surface(root.inspector_modes[0].id);
                                }
                            }
                        }

                if !root.phone_layout: HorizontalLayout {
                    height: AgTheme.control-height;
                    spacing: AgTheme.space-2;

                    ActionButton {
                        label: "Revert";
                        enabled: root.provider_dirty && !root.running && !root.provider_busy;
                        fill: AgTheme.chrome;
                        outline-color: AgTheme.border-subtle;
                        reduced-motion: root.reduced_motion;
                        clicked => {
                            root.provider_draft_label = root.provider_label;
                            root.provider_draft_endpoint = root.provider_endpoint;
                            root.provider_draft_model = root.provider_model;
                            root.provider_label_error = "";
                            root.provider_endpoint_error = "";
                            root.provider_model_error = "";
                            root.provider_error = "";
                            root.provider_notice = "Changes reverted.";
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    ActionButton {
                        label: root.provider_testing ? "Testing" : "Test connection";
                        icon: "activity";
                        enabled: root.provider_id != ""
                            && !root.running
                            && !root.provider_dirty
                            && root.provider_valid
                            && !root.provider_busy;
                        fill: AgTheme.surface-soft;
                        outline-color: AgTheme.border-default;
                        reduced-motion: root.reduced_motion;
                        clicked => {
                            root.provider_testing = true;
                            root.provider_pending = "probe";
                            root.provider_probe_state = "testing";
                            root.provider_error = "";
                            root.provider_notice = "";
                            root.probe_provider(root.provider_id);
                        }
                    }

                    ActionButton {
                        label: root.provider_saving ? "Saving" : "Save";
                        icon: "check";
                        primary: true;
                        enabled: root.provider_id != ""
                            && !root.running
                            && root.provider_dirty
                            && root.provider_valid
                            && !root.provider_busy;
                        reduced-motion: root.reduced_motion;
                        clicked => {
                            root.provider_saving = true;
                            root.provider_pending = "save";
                            root.provider_error = "";
                            root.provider_notice = "";
                            root.save_provider_profile(
                                root.provider_id,
                                root.provider_draft_label,
                                root.provider_kind,
                                root.provider_draft_endpoint,
                                root.provider_draft_model,
                                true
                            );
                        }
                    }
                }

                if root.phone_layout: VerticalLayout {
                    spacing: AgTheme.space-2;

                    HorizontalLayout {
                        height: AgTheme.mobile-control-height;
                        spacing: AgTheme.space-2;

                        ActionButton {
                            label: "Revert";
                            enabled: root.provider_dirty && !root.running && !root.provider_busy;
                            fill: AgTheme.chrome;
                            outline-color: AgTheme.border-subtle;
                            reduced-motion: root.reduced_motion;
                            target-height: AgTheme.mobile-control-height;
                            clicked => {
                                root.provider_draft_label = root.provider_label;
                                root.provider_draft_endpoint = root.provider_endpoint;
                                root.provider_draft_model = root.provider_model;
                                root.provider_label_error = "";
                                root.provider_endpoint_error = "";
                                root.provider_model_error = "";
                                root.provider_error = "";
                                root.provider_notice = "Changes reverted.";
                            }
                        }

                        Rectangle { horizontal-stretch: 1; }

                        ActionButton {
                            label: root.provider_testing ? "Testing" : "Test connection";
                            icon: "activity";
                            enabled: root.provider_id != ""
                                && !root.running
                                && !root.provider_dirty
                                && root.provider_valid
                                && !root.provider_busy;
                            fill: AgTheme.surface-soft;
                            outline-color: AgTheme.border-default;
                            reduced-motion: root.reduced_motion;
                            target-height: AgTheme.mobile-control-height;
                            clicked => {
                                root.provider_testing = true;
                                root.provider_pending = "probe";
                                root.provider_probe_state = "testing";
                                root.provider_error = "";
                                root.provider_notice = "";
                                root.probe_provider(root.provider_id);
                            }
                        }
                    }

                    ActionButton {
                        label: root.provider_saving ? "Saving" : "Save provider";
                        icon: "check";
                        primary: true;
                        enabled: root.provider_id != ""
                            && !root.running
                            && root.provider_dirty
                            && root.provider_valid
                            && !root.provider_busy;
                        reduced-motion: root.reduced_motion;
                        target-height: AgTheme.mobile-control-height;
                        horizontal-stretch: 1;
                        clicked => {
                            root.provider_saving = true;
                            root.provider_pending = "save";
                            root.provider_error = "";
                            root.provider_notice = "";
                            root.save_provider_profile(
                                root.provider_id,
                                root.provider_draft_label,
                                root.provider_kind,
                                root.provider_draft_endpoint,
                                root.provider_draft_model,
                                true
                            );
                        }
                    }
                }
                    }
                }
            }
        }
        }

        if root.about_open: Rectangle {
            x: root.width < AgTheme.about-dialog-width-breakpoint ? 12px : (root.width - 500px) / 2;
            y: root.height < AgTheme.about-dialog-height-breakpoint ? 12px : (root.height - 370px) / 2;
            width: root.width < AgTheme.about-dialog-width-breakpoint ? root.width - 24px : 500px;
            height: 370px;
            border-radius: AgTheme.radius-xs;
            border-width: 1px;
            border-color: AgTheme.silver-700;
            background: AgTheme.navigation;

            Rectangle { x: 20px; y: 0px; width: 42px; height: 2px; background: AgTheme.silver-300; }

            VerticalLayout {
                padding: AgTheme.space-5;
                spacing: AgTheme.space-4;

                PanelHeader { brand: true; title: "Argentum"; detail: "0.1.0 draft. Native task workbench"; close => { root.about_open = false; } }
                Text { text: "A local-first desktop app for running model tasks and reviewing runtime activity."; color: AgTheme.white-100; font-size: AgTheme.type-lead; font-weight: AgTheme.weight-semibold; wrap: word-wrap; }
                Text { text: "A Rust runtime manages storage, model providers, tools, and workspace permissions. Slint renders the native interface."; color: AgTheme.text-secondary; font-size: AgTheme.type-body; wrap: word-wrap; }
                Rectangle { height: 1px; background: AgTheme.border-faint; }
                HorizontalLayout {
                    spacing: AgTheme.space-2;
                    alignment: stretch;

                    Rectangle {
                        width: 17px;
                        background: transparent;

                        AgIcon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            name: "approval";
                            size: 15px;
                            tint: AgTheme.silver-500;
                        }
                    }

                    Text { text: "Native interface. No WebView or JavaScript runtime."; color: AgTheme.text-muted; font-size: AgTheme.type-compact; vertical-alignment: center; }
                }
                Rectangle { vertical-stretch: 1; }
                ActionButton { label: "Close"; fill: AgTheme.surface-soft; outline-color: AgTheme.border-default; clicked => { root.about_open = false; } }
            }
        }

        if root.approval_open: Rectangle {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
            background: AgTheme.scrim;

            TouchArea { mouse-cursor: default; }
        }

        if root.approval_open: Rectangle {
            x: root.phone_layout ? root.phone_gutter : (root.width < AgTheme.approval-dialog-width-breakpoint ? AgTheme.space-2 : (root.width - 520px) / 2);
            y: root.phone_layout
                ? max(root.safe_area_top + AgTheme.space-2, root.height - root.safe_area_bottom - AgTheme.mobile-approval-sheet-height)
                : (root.height < AgTheme.approval-dialog-height-breakpoint ? AgTheme.space-2 : (root.height - 472px) / 2);
            width: root.phone_layout ? root.width - root.phone_gutter * 2 : (root.width < AgTheme.approval-dialog-width-breakpoint ? root.width - AgTheme.space-4 : 520px);
            height: root.phone_layout
                ? min(AgTheme.mobile-approval-sheet-height, root.height - root.safe_area_top - root.safe_area_bottom - AgTheme.space-4)
                : (root.height < AgTheme.approval-dialog-height-breakpoint ? root.height - AgTheme.space-4 : 472px);
            border-radius: root.phone_layout ? AgTheme.radius-lg : AgTheme.radius-xs;
            border-width: AgTheme.hairline;
            border-color: AgTheme.red-600;
            background: AgTheme.navigation;

            Rectangle {
                x: 20px;
                y: 0px;
                width: 56px;
                height: 2px;
                background: AgTheme.red-400;
            }

            approval-focus-timer := Timer {
                interval: 1ms;
                running: true;
                triggered => {
                    self.running = false;
                    reject-button.focus();
                }
            }

            VerticalLayout {
                padding: root.phone_layout ? AgTheme.space-4 : AgTheme.space-5;
                spacing: AgTheme.space-4;

                HorizontalLayout {
                    spacing: AgTheme.space-3;
                    alignment: stretch;

                    Rectangle {
                        width: 40px;
                        background: transparent;

                        Rectangle {
                            x: 0px;
                            y: (parent.height - 28px) / 2;
                            width: 2px;
                            height: 28px;
                            background: AgTheme.red-400;
                        }

                        AgIcon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            name: "approval";
                            size: 18px;
                            tint: AgTheme.red-400;
                        }
                    }

                    VerticalLayout {
                        spacing: AgTheme.optical-tight-gap;
                        alignment: center;
                        Text { text: "Approval needed"; color: AgTheme.white-100; font-size: AgTheme.type-dialog-title; font-weight: AgTheme.weight-title; }
                        Text { text: "Review the action before Argentum continues."; color: AgTheme.text-muted; font-size: AgTheme.type-compact; wrap: word-wrap; }
                    }
                }

                Rectangle { height: 1px; background: AgTheme.border-faint; }

                ScrollView {
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    mouse-drag-pan-enabled: true;

                    VerticalLayout {
                        padding-right: AgTheme.space-1;
                        spacing: AgTheme.space-4;

                        VerticalLayout {
                            spacing: AgTheme.space-2;
                            Text { text: "Action"; color: AgTheme.text-muted; font-size: AgTheme.type-compact; font-weight: AgTheme.weight-semibold; }
                            Text { text: root.approval_action; color: AgTheme.white-100; font-size: AgTheme.type-body; font-weight: AgTheme.weight-semibold; wrap: word-wrap; }
                        }

                        VerticalLayout {
                            spacing: AgTheme.space-2;
                            Text { text: "Target"; color: AgTheme.text-muted; font-size: AgTheme.type-compact; font-weight: AgTheme.weight-semibold; }
                            Rectangle {
                                height: 84px;
                                border-radius: AgTheme.radius-xs;
                                border-width: 1px;
                                border-color: AgTheme.silver-700;
                                background: AgTheme.chrome;
                                Text { x: 12px; y: 10px; width: parent.width - 24px; height: parent.height - 20px; text: root.approval_target; color: AgTheme.text-secondary; font-size: AgTheme.type-compact; wrap: word-wrap; vertical-alignment: center; overflow: elide; }
                            }
                        }

                        VerticalLayout {
                            spacing: AgTheme.space-2;
                            Text { text: "Binding"; color: AgTheme.text-muted; font-size: AgTheme.type-compact; font-weight: AgTheme.weight-semibold; }
                            Text { text: root.approval_binding; color: AgTheme.text-secondary; font-family: AgTheme.font-code; font-size: AgTheme.type-metadata; wrap: word-wrap; }
                            if root.approval_capabilities != "": Text {
                                text: "Capabilities: " + root.approval_capabilities;
                                color: AgTheme.text-muted;
                                font-size: AgTheme.type-compact;
                                wrap: word-wrap;
                            }
                        }

                        VerticalLayout {
                            spacing: AgTheme.space-2;
                            Text { text: "Scope"; color: AgTheme.text-muted; font-size: AgTheme.type-compact; font-weight: AgTheme.weight-semibold; }
                            Text {
                                text: root.approval_request_scope == root.approval_scope
                                    ? "The runtime requested this scope."
                                    : "Requested " + root.approval_request_scope + "; the owner is choosing a different scope.";
                                color: AgTheme.text-muted;
                                font-size: AgTheme.type-compact;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: AgTheme.space-2;
                                for choice in root.approval_scope_choices: ContextButton {
                                    label: choice.label;
                                    selected: root.approval_scope == choice.id;
                                    enabled: !root.approval_response_pending;
                                    reduced-motion: root.reduced_motion;
                                    clicked => { root.approval_scope = choice.id; }
                                }
                            }
                        }

                        Text { text: root.approval_reason; color: AgTheme.text-muted; font-size: AgTheme.type-compact; wrap: word-wrap; }
                    }
                }

                HorizontalLayout {
                    spacing: AgTheme.space-2;
                    reject-button := ActionButton { label: root.approval_response_pending ? "Responding" : "Reject"; enabled: !root.approval_response_pending; fill: AgTheme.surface-soft; outline-color: AgTheme.border-default; target-height: root.phone_layout ? AgTheme.mobile-control-height : AgTheme.control-height; clicked => { root.reject_tool(root.approval_id); } }
                    Rectangle { horizontal-stretch: 1; }
                    ActionButton { label: root.approval_response_pending ? "Responding" : "Approve"; icon: "check"; enabled: !root.approval_response_pending; primary: true; target-height: root.phone_layout ? AgTheme.mobile-control-height : AgTheme.control-height; clicked => { root.approve_tool(root.approval_id, root.approval_scope); } }
                }
            }
        }
    }
}
