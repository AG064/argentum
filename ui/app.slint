import { ScrollView } from "std-widgets.slint";
import { ActionButton, IconButton } from "components/buttons.slint";
import { AgIcon } from "components/icon.slint";
import { BrandLockup, BrandMark } from "components/brand.slint";
import { ContextButton, ContextUsagePanel, MenuRow, SectionHeading, SettingsField } from "components/surfaces.slint";
import { MobileShell } from "shells/mobile.slint";
import { ConversationSurface } from "surfaces/conversation.slint";
import { ActivityItemView, ConversationMessageView, HarnessCapabilityView, HarnessExecutionProfileView, HarnessProfileView, HarnessSurfaceView, PlanStepView, ProviderModelView, ProviderProfileView, SessionItemView } from "view-models.slint";
import { AgTheme } from "tokens.slint";

component RailSettingsButton inherits Rectangle {
    in property <bool> reduced-motion: false;
    out property <bool> has-focus: rail-settings-focus.has-focus;
    callback clicked();

    height: 44px;
    border-radius: AgTheme.radius-xs;
    border-width: 1px;
    border-color: root.has-focus ? AgTheme.focus-ring : transparent;
    background: rail-settings-touch.pressed
        ? AgTheme.control-pressed
        : (rail-settings-touch.has-hover ? AgTheme.control-hover : transparent);
    accessible-role: button;
    accessible-label: "Settings";
    accessible-action-default => { root.clicked(); }
    forward-focus: rail-settings-focus;
    animate background, border-color {
        duration: root.reduced-motion ? 0ms : AgTheme.motion-fast;
    }

    HorizontalLayout {
        padding-left: AgTheme.space-3;
        padding-right: AgTheme.space-3;
        spacing: AgTheme.space-3;
        alignment: stretch;

        Rectangle {
            width: 20px;
            background: transparent;

            AgIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                name: "sliders";
                size: 18px;
                tint: rail-settings-touch.has-hover ? AgTheme.white-100 : AgTheme.silver-400;
            }
        }

        Text { text: "Settings"; color: AgTheme.text-secondary; font-size: AgTheme.type-body; font-weight: AgTheme.weight-medium; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
    }

    rail-settings-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            rail-settings-focus.focus();
            root.clicked();
        }
    }

    rail-settings-focus := FocusScope {
        x: 0px;
        width: 0px;
        focus-on-click: false;
        focus-on-tab-navigation: true;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n" || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

component SessionItem inherits Rectangle {
    in property <bool> active: false;
    in property <string> title;
    in property <string> detail;
    in property <bool> reduced-motion: false;
    out property <bool> has-focus: key-focus.has-focus;
    callback clicked();

    height: AgTheme.space-16;
    border-radius: AgTheme.radius-xs;
    border-width: 1px;
    border-color: root.has-focus
        ? AgTheme.focus-ring
        : (root.active ? AgTheme.border-subtle : transparent);
    background: root.active
        ? AgTheme.surface-soft
        : (touch.pressed ? AgTheme.elevated : (touch.has-hover ? AgTheme.hover : transparent));
    accessible-role: button;
    accessible-label: root.title + ", " + root.detail;
    accessible-action-default => { root.clicked(); }
    forward-focus: key-focus;
    animate background, border-color {
        duration: root.reduced-motion ? 0ms : AgTheme.motion-fast;
    }

    if root.active: Rectangle {
        x: 0px;
        y: 10px;
        width: 2px;
        height: parent.height - 20px;
        background: AgTheme.silver-300;
    }

    HorizontalLayout {
        padding-left: AgTheme.space-3;
        padding-right: AgTheme.space-3;
        spacing: AgTheme.space-3;
        alignment: stretch;

        Rectangle {
            width: 30px;
            background: transparent;

            AgIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                name: "session";
                size: 18px;
                tint: root.active ? AgTheme.silver-200 : AgTheme.silver-500;
            }
        }

        VerticalLayout {
            spacing: AgTheme.space-1;
            alignment: center;

            Text {
                text: root.title;
                color: root.active ? AgTheme.white-100 : AgTheme.text-secondary;
                font-size: AgTheme.type-body;
                font-weight: root.active ? AgTheme.weight-semibold : AgTheme.weight-medium;
                overflow: elide;
            }

            Text {
                text: root.detail;
                color: AgTheme.text-muted;
                font-size: AgTheme.type-compact;
                overflow: elide;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            key-focus.focus();
            root.clicked();
        }
    }

    key-focus := FocusScope {
        x: 0px;
        width: 0px;
        focus-on-click: false;
        focus-on-tab-navigation: true;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n" || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

component StateBadge inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <bool> attention: false;
    in property <bool> reduced-motion: false;

    height: 30px;
    min-width: 86px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: AgTheme.radius-xs;
    border-width: 1px;
    border-color: root.attention
        ? AgTheme.red-600
        : (root.active ? AgTheme.silver-500 : AgTheme.silver-700);
    background: root.attention ? AgTheme.attention-surface : AgTheme.chrome;

    HorizontalLayout {
        padding-left: AgTheme.space-3;
        padding-right: AgTheme.space-3;
        spacing: AgTheme.space-2;
        alignment: center;

        Rectangle {
            width: 3px;
            background: transparent;

            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 3px;
                height: 14px;
                background: root.attention
                    ? AgTheme.red-400
                    : (root.active ? AgTheme.white-100 : AgTheme.silver-500);
            }
        }

        Text {
            text: root.label;
            color: root.attention ? AgTheme.red-100 : AgTheme.text-secondary;
            font-size: AgTheme.type-compact;
            font-weight: AgTheme.weight-semibold;
            vertical-alignment: center;
        }
    }
}

component GoalCard inherits Rectangle {
    in property <bool> available: false;
    in property <string> objective: "";
    in property <string> state: "";
    in property <string> next-action: "";
    in property <int> iteration: 0;
    in property <int> tokens-used: 0;
    in property <int> token-budget: 0;
    in property <bool> token-budget-reported: false;
    in property <int> tools-used: 0;
    in property <int> tool-budget: 0;
    in property <bool> tool-budget-reported: false;
    in property <int> time-budget-seconds: 0;
    in property <bool> time-budget-reported: false;
    in property <int> verification-count: 0;
    in property <bool> busy: false;
    in-out property <string> objective-draft: "";
    in property <bool> reduced-motion: false;
    callback set-goal(string, int, int, int);
    callback pause-goal();
    callback resume-goal();
    callback clear-goal();

    min-height: 160px;
    border-radius: AgTheme.radius-xs;
    border-width: 1px;
    border-color: root.state == "Budget limited" ? AgTheme.red-700 : AgTheme.silver-700;
    background: root.state == "Budget limited" ? AgTheme.attention-surface : AgTheme.chrome;

    VerticalLayout {
        padding: AgTheme.space-4;
        spacing: AgTheme.space-3;

        HorizontalLayout {
            height: AgTheme.space-8;
            spacing: AgTheme.space-2;
            Text { text: "Goal"; color: AgTheme.white-100; font-size: AgTheme.type-body; font-weight: AgTheme.weight-semibold; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            if root.available: StateBadge { label: root.state; active: root.state == "Active"; attention: root.state == "Budget limited"; reduced-motion: root.reduced-motion; }
        }

        if root.available: VerticalLayout {
            spacing: AgTheme.space-1;
            Text { text: root.objective; color: AgTheme.text-primary; font-size: AgTheme.type-body; wrap: word-wrap; }
            Text { text: "Next: " + root.next-action; color: AgTheme.text-muted; font-size: AgTheme.type-compact; wrap: word-wrap; }
            Text { text: "Iteration " + root.iteration + "  |  Verifications " + root.verification-count; color: AgTheme.text-muted; font-size: AgTheme.type-compact; }
            if root.token-budget-reported: Text { text: "Tokens " + root.tokens-used + " / " + root.token-budget; color: AgTheme.text-muted; font-size: AgTheme.type-compact; }
            if root.tool-budget-reported: Text { text: "Tools " + root.tools-used + " / " + root.tool-budget; color: AgTheme.text-muted; font-size: AgTheme.type-compact; }
            if root.time-budget-reported: Text { text: "Time " + root.time-budget-seconds + " seconds"; color: AgTheme.text-muted; font-size: AgTheme.type-compact; }
        }

        if !root.available: Text {
            text: "Set an objective for this session. It stays under your control until you start a run through the shared command host.";
            color: AgTheme.text-muted;
            font-size: AgTheme.type-compact;
            wrap: word-wrap;
        }

        SettingsField {
            label: "Objective";
            placeholder: root.available ? "Replace the objective" : "Describe the objective";
            value <=> root.objective-draft;
            enabled: !root.busy;
        }

        HorizontalLayout {
            spacing: AgTheme.space-2;
            ActionButton {
                label: root.available ? "Replace goal" : "Set goal";
                icon: root.available ? "review" : "plus";
                primary: !root.available;
                enabled: !root.busy && root.objective-draft != "";
                reduced-motion: root.reduced-motion;
                clicked => {
                    root.set-goal(
                        root.objective-draft,
                        root.token-budget-reported ? root.token-budget : -1,
                        root.tool-budget-reported ? root.tool-budget : -1,
                        root.time-budget-reported ? root.time-budget-seconds : -1
                    );
                }
            }
            if root.available: ActionButton {
                label: "Pause";
                enabled: !root.busy && root.state == "Active";
                reduced-motion: root.reduced-motion;
                clicked => { root.pause-goal(); }
            }
            if root.available && root.state == "Paused": ActionButton {
                label: "Resume";
                enabled: !root.busy;
                reduced-motion: root.reduced-motion;
                clicked => { root.resume-goal(); }
            }
            if root.available: ActionButton {
                label: "Clear";
                enabled: !root.busy;
                foreground: AgTheme.red-100;
                outline-color: AgTheme.red-700;
                reduced-motion: root.reduced-motion;
                clicked => { root.clear-goal(); }
            }
        }
    }
}

component ActivityItem inherits Rectangle {
    in property <ActivityItemView> item;

    height: AgTheme.space-16;
    vertical-stretch: 0;
    border-radius: AgTheme.radius-xs;
    background: item-touch.has-hover ? AgTheme.hover : transparent;

    Rectangle {
        x: 0px;
        y: 9px;
        width: 2px;
        height: parent.height - 18px;
        background: root.item.state == "error" || root.item.state == "attention"
            ? AgTheme.red-500
            : AgTheme.silver-700;
    }

    HorizontalLayout {
        padding-left: AgTheme.space-3;
        padding-right: AgTheme.space-3;
        padding-top: AgTheme.space-2;
        padding-bottom: AgTheme.space-2;
        spacing: AgTheme.space-3;
        alignment: stretch;

        Rectangle {
            width: 28px;
            background: transparent;

            AgIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                name: root.item.state == "success"
                    ? "check"
                    : ((root.item.state == "error" || root.item.state == "attention") ? "alert" : "activity");
                size: 14px;
                tint: root.item.state == "error" || root.item.state == "attention"
                    ? AgTheme.red-400
                    : AgTheme.silver-400;
            }
        }

        VerticalLayout {
            spacing: AgTheme.space-1;
            alignment: center;

            Text {
                text: root.item.title;
                color: AgTheme.text-secondary;
                font-size: AgTheme.type-compact;
                font-weight: AgTheme.weight-medium;
                wrap: word-wrap;
            }

            Text {
                text: root.item.detail;
                color: AgTheme.text-muted;
                font-size: AgTheme.type-compact;
                wrap: word-wrap;
            }
        }
    }

    item-touch := TouchArea { mouse-cursor: default; }
}

component Composer inherits Rectangle {
    in-out property <string> draft: "";
    in property <string> provider-label: "LM Studio";
    in property <string> workspace-label: "Local workspace";
    in property <bool> running: false;
    in property <bool> approval-pending: false;
    in property <bool> submission-pending: false;
    in property <string> active-run-id: "";
    in property <bool> reduced-motion: false;
    callback submit(string);
    callback cancel(string);
    callback open-model();
    callback open-context();

    height: root.width < AgTheme.composer-compact-breakpoint ? 128px : 116px;
    border-radius: AgTheme.radius-xs;
    border-width: 1px;
    border-color: editor.has-focus ? AgTheme.red-600 : AgTheme.silver-700;
    background: AgTheme.navigation;
    clip: true;

    Rectangle {
        x: 12px;
        y: 0px;
        width: editor.has-focus ? 48px : 28px;
        height: 2px;
        background: editor.has-focus ? AgTheme.red-500 : AgTheme.silver-600;
    }

    Text {
        visible: root.draft == "";
        x: 16px;
        y: 14px;
        width: parent.width - 32px;
        height: 34px;
        text: "Describe a task or ask a question";
        color: AgTheme.text-muted;
        font-size: AgTheme.type-body;
        vertical-alignment: top;
    }

    editor := TextInput {
        x: 16px;
        y: 12px;
        width: parent.width - 32px;
        height: root.width < AgTheme.composer-compact-breakpoint ? 54px : 46px;
        text <=> root.draft;
        color: AgTheme.white-100;
        selection-foreground-color: AgTheme.white-000;
        selection-background-color: AgTheme.silver-700;
        font-size: AgTheme.type-body;
        font-weight: AgTheme.weight-regular;
        single-line: false;
        wrap: word-wrap;
        enabled: !root.approval-pending && !root.submission-pending;
        accessible-label: "Task prompt";
        key-pressed(event) => {
            if event.text == "\n"
                && !event.modifiers.shift
                && !root.running
                && root.draft != ""
            {
                root.submit(root.draft);
                return accept;
            }
            return reject;
        }
    }

    Rectangle {
        x: 12px;
        y: root.width < AgTheme.composer-compact-breakpoint ? 69px : 58px;
        width: parent.width - 24px;
        height: 1px;
        background: AgTheme.border-subtle;
    }

    HorizontalLayout {
        x: 8px;
        y: root.width < AgTheme.composer-compact-breakpoint ? 74px : 63px;
        width: parent.width - 16px;
        height: 46px;
        spacing: AgTheme.space-2;
        alignment: stretch;

        ContextButton {
            icon: "model";
            label: "Model";
            detail: root.provider-label;
            reduced-motion: root.reduced-motion;
            clicked => { root.open-model(); }
        }

        if root.width >= AgTheme.composer-context-actions-breakpoint: ContextButton {
            icon: "folder";
            label: "Scope";
            detail: root.workspace-label;
            reduced-motion: root.reduced-motion;
            clicked => { root.open-context(); }
        }

        Rectangle { horizontal-stretch: 1; }

        ActionButton {
            label: root.approval-pending ? "Approval needed" : (root.submission-pending ? "Starting" : (root.running ? "Stop" : "Start"));
            icon: root.running ? "stop" : "play";
            enabled: !root.approval-pending && !root.submission-pending && (root.running || root.draft != "");
            primary: !root.running;
            fill: root.running ? AgTheme.raised : AgTheme.primary-fill;
            outline-color: root.running ? AgTheme.border-strong : AgTheme.primary-hover;
            reduced-motion: root.reduced-motion;
            clicked => {
                if root.running {
                    root.cancel(root.active-run-id);
                } else {
                    root.submit(root.draft);
                }
            }
        }
    }
}

component PanelHeader inherits Rectangle {
    in property <string> icon: "";
    in property <bool> brand: false;
    in property <string> title;
    in property <string> detail: "";
    callback close();

    height: 56px;

    HorizontalLayout {
        spacing: AgTheme.space-3;
        alignment: stretch;

        Rectangle {
            visible: root.brand || root.icon != "";
            width: 24px;
            background: transparent;

            if root.brand: BrandMark {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                size: AgTheme.brand-mark-sm;
                accessible-name: "";
            }

            if !root.brand && root.icon != "": AgIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                name: root.icon;
                size: AgTheme.icon-navigation;
                tint: AgTheme.silver-300;
            }
        }

        VerticalLayout {
            spacing: AgTheme.optical-tight-gap;
            alignment: center;
            Text { text: root.title; color: AgTheme.white-100; font-size: AgTheme.type-section-title; font-weight: AgTheme.weight-title; }
            Text { visible: root.detail != ""; text: root.detail; color: AgTheme.text-muted; font-size: AgTheme.type-compact; }
        }

        Rectangle { horizontal-stretch: 1; }

        Rectangle {
            width: AgTheme.control-height;
            background: transparent;

            IconButton {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                glyph: "close";
                hint: "Close " + root.title;
                clicked => { root.close(); }
            }
        }
    }
}

component HeaderAction inherits Rectangle {
    in property <string> glyph;
    in property <string> hint;
    in property <bool> selected: false;
    in property <bool> reduced-motion: false;
    in property <length> target-size: AgTheme.control-height;
    callback clicked();

    width: root.target-size;
    height: AgTheme.header-height;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    background: transparent;

    IconButton {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        glyph: root.glyph;
        hint: root.hint;
        selected: root.selected;
        reduced-motion: root.reduced-motion;
        target-size: root.target-size;
        clicked => { root.clicked(); }
    }
}

export component MainWindow inherits Window {
    title: "Argentum";
    icon: @image-url("../assets/brand/argentum-256.png");
    preferred-width: 1400px;
    preferred-height: 820px;
    min-width: 360px;
    min-height: 360px;
    background: AgTheme.canvas;
    default-font-family: AgTheme.font-ui;

    in-out property <string> draft: "";
    in-out property <string> run_state: "Ready";
    in-out property <string> transcript: "";
    in-out property <string> current_reasoning: "";
    in-out property <bool> current_reasoning_available: false;
    in-out property <string> current_run_provider_label: "";
    in-out property <string> current_run_model: "";
    in-out property <bool> usage_reported: false;
    in-out property <int> usage_input_tokens: 0;
    in-out property <int> usage_output_tokens: 0;
    in-out property <int> usage_total_tokens: 0;
    in-out property <bool> context_window_reported: false;
    in-out property <int> context_window_tokens: 0;
    in-out property <string> error_message: "";
