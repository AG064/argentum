    in-out property <string> provider_endpoint: "";
    in-out property <string> provider_model: "local-model";
    in-out property <string> provider_detail: "Model is configured";
    in-out property <bool> provider_connected: false;
    in-out property <bool> provider_testing: false;
    in-out property <bool> provider_loading: false;
    in-out property <bool> provider_saving: false;
    in-out property <bool> provider_selecting: false;
    in-out property <string> provider_pending: "";
    in-out property <string> provider_probe_state: "untested";
    in-out property <string> provider_error: "";
    in-out property <string> provider_notice: "";
    in-out property <bool> provider_error_consumes_next: false;
