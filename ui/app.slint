// Argentum window. State and commands live in the App global so each module can
// read what it needs directly. These aliases are the surface the Rust bridge uses.
import { App, Mods } from "workbench/state.slint";
import { Theme } from "workbench/theme.slint";
import { Workbench } from "workbench/shell.slint";
import { PlanStepView, ActivityItemView, FileChangeView, TrajectoryItemView, InspectorModeView, ConversationMessageView, SessionItemView, RecordLineView, ApprovalGrantView, ToolCatalogView, SkillCatalogView, ApprovalScopeChoiceView, VerificationRunnerView, VerificationEvidenceView, ProviderProfileView, ProviderModelView, ProviderPresetView, DesktopToolView, ProviderContextChoiceView, HarnessProfileView, HarnessExecutionProfileView, HarnessSurfaceView, HarnessCapabilityView, HarnessModuleView, DiagnosticRecordView, RichBlockView, DiffLineView, GitFileView, ProviderUsageView, ThemePresetView, PaletteItemView } from "view-models.slint";

export { App, Mods, Theme }

