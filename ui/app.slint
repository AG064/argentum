import { ScrollView } from "std-widgets.slint";
import { AgTheme } from "tokens.slint";
import {
    ActivityItemView,
    ConversationMessageView,
    DiagnosticRecordView,
    FileChangeView,
    HarnessCapabilityView,
    HarnessExecutionProfileView,
    HarnessModuleView,
    HarnessProfileView,
    HarnessSurfaceView,
    InspectorModeView,
    PlanStepView,
    ProviderModelView,
    ProviderProfileView,
    SessionItemView,
    TrajectoryItemView,
} from "view-models.slint";

component ShowcaseIcon inherits Rectangle {
    in property <string> name: "plus";
    in property <color> tint: AgTheme.bone-dim;
    in property <length> size: 16px;

    width: root.size;
    height: root.size;
    background: transparent;

    Image {
        width: parent.width;
        height: parent.height;
        source: root.name == "play" ? @image-url("assets/icons/play.svg")
            : (root.name == "stop" ? @image-url("assets/icons/stop.svg")
            : (root.name == "plus" ? @image-url("assets/icons/plus.svg")
            : (root.name == "settings" ? @image-url("assets/icons/sliders.svg")
            : (root.name == "folder" ? @image-url("assets/icons/folder.svg")
            : (root.name == "workspace" ? @image-url("assets/icons/workspace.svg")
            : (root.name == "session" ? @image-url("assets/icons/session.svg")
            : (root.name == "changes" ? @image-url("assets/icons/diff.svg")
            : (root.name == "terminal" ? @image-url("assets/icons/terminal.svg")
            : (root.name == "verify" ? @image-url("assets/icons/verify.svg")
            : (root.name == "activity" ? @image-url("assets/icons/activity.svg")
            : (root.name == "panel" ? @image-url("assets/icons/panel.svg")
            : (root.name == "timeline" ? @image-url("assets/icons/timeline.svg")
            : (root.name == "check" ? @image-url("assets/icons/check.svg")
            : (root.name == "alert" ? @image-url("assets/icons/alert.svg")
            : (root.name == "close" ? @image-url("assets/icons/close.svg")
            : (root.name == "chevron-right" ? @image-url("assets/icons/chevron-right.svg")
            : (root.name == "file" ? @image-url("assets/icons/file.svg")
            : (root.name == "lock" ? @image-url("assets/icons/lock.svg")
            : (root.name == "model" ? @image-url("assets/icons/model.svg")
            : @image-url("assets/icons/command.svg"))))))))))))))))))));
        colorize: root.tint;
        image-fit: contain;
    }
}

component BrandLockup inherits Rectangle {
    height: 46px;
    background: transparent;

    HorizontalLayout {
        spacing: 12px;
        alignment: center;

        Rectangle {
            width: 34px;
            height: 34px;
            background: AgTheme.accent;
            border-radius: AgTheme.radius-sm;

            Text {
                text: "A";
                width: parent.width;
                height: parent.height;
                color: AgTheme.accent-ink;
                font-family: AgTheme.font-display;
                font-size: 23px;
                font-weight: AgTheme.weight-bold;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            spacing: 3px;
            alignment: center;

            Text {
                text: "ARGENTUM";
                color: AgTheme.bone-strong;
                font-family: AgTheme.font-ui;
                font-size: 13px;
                font-weight: AgTheme.weight-bold;
                letter-spacing: 3.2px;
            }

            Text {
                text: "LOCAL AGENT WORKBENCH";
                color: AgTheme.muted;
                font-family: AgTheme.font-ui;
                font-size: 8px;
                font-weight: AgTheme.weight-medium;
                letter-spacing: 1.1px;
            }
        }
    }
}

component OutlineButton inherits Rectangle {
    in property <string> label;
    in property <string> icon: "";
    in property <bool> enabled: true;
    in property <bool> reduced-motion: false;
    out property <bool> has-focus: key-focus.has-focus;
    callback clicked();
    public function take-focus() { key-focus.focus(); }

    height: 38px;
    min-width: 96px;
    border-radius: AgTheme.radius-sm;
    border-width: AgTheme.hairline;
    border-color: root.has-focus
        ? AgTheme.bone
        : (touch.has-hover ? AgTheme.line-strong : AgTheme.line);
    forward-focus: key-focus;
    background: touch.pressed
        ? AgTheme.panel
        : (touch.has-hover ? AgTheme.panel-hover : transparent);
    opacity: root.enabled ? 1.0 : 0.38;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    animate background, border-color {
        duration: root.reduced-motion ? 0ms : AgTheme.motion-fast;
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        alignment: center;

        if root.icon != "": ShowcaseIcon {
            name: root.icon;
            size: 13px;
            tint: AgTheme.bone-dim;
        }

        Text {
            text: root.label;
            color: AgTheme.bone;
            font-family: AgTheme.font-ui;
            font-size: AgTheme.type-small;
            font-weight: AgTheme.weight-medium;
            letter-spacing: 0.4px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            key-focus.focus();
            root.clicked();
        }
    }

    key-focus := FocusScope {
        x: 0px;
        width: 0px;
        focus-on-click: false;
        focus-on-tab-navigation: true;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n" || event.text == Key.Return) {
                if (root.enabled) {
                    root.clicked();
                }
                return accept;
            }
            return reject;
        }
    }
}

component SolidButton inherits Rectangle {
    in property <string> label;
    in property <string> icon: "";
    in property <bool> enabled: true;
    in property <bool> reduced-motion: false;
    in property <color> fill: AgTheme.accent;
    in property <color> foreground: AgTheme.accent-ink;
    in property <color> hover-fill: AgTheme.accent-hover;
    out property <bool> has-focus: key-focus.has-focus;
    callback clicked();
    public function take-focus() { key-focus.focus(); }

    height: 40px;
    min-width: 108px;
    border-radius: AgTheme.radius-sm;
    background: touch.pressed
        ? AgTheme.accent-press
        : (touch.has-hover ? root.hover-fill : root.fill);
    forward-focus: key-focus;
    opacity: root.enabled ? 1.0 : 0.72;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    animate background {
        duration: root.reduced-motion ? 0ms : AgTheme.motion-fast;
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 18px;
        spacing: 9px;
        alignment: center;

        if root.icon != "": ShowcaseIcon {
            name: root.icon;
            size: 13px;
            tint: root.foreground;
        }

        Text {
            text: root.label;
            color: root.foreground;
            font-family: AgTheme.font-ui;
            font-size: AgTheme.type-small;
            font-weight: AgTheme.weight-bold;
            letter-spacing: 0.7px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            key-focus.focus();
            root.clicked();
        }
    }

    key-focus := FocusScope {
        x: 0px;
        width: 0px;
        focus-on-click: false;
        focus-on-tab-navigation: true;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n" || event.text == Key.Return) {
                if (root.enabled) {
                    root.clicked();
                }
                return accept;
            }
            return reject;
        }
    }
}

component SessionRow inherits Rectangle {
    in property <SessionItemView> item;
    in property <bool> reduced-motion: false;
    callback clicked();

    height: 58px;
    border-radius: AgTheme.radius-sm;
    background: root.item.active
        ? AgTheme.panel-raised
        : (touch.has-hover ? AgTheme.panel : transparent);
    accessible-role: button;
    accessible-label: root.item.title;
    accessible-action-default => { root.clicked(); }
    animate background {
        duration: root.reduced-motion ? 0ms : AgTheme.motion-fast;
    }

    if root.item.active: Rectangle {
        x: 0px;
        y: 13px;
        width: 2px;
        height: 32px;
        background: AgTheme.accent;
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        spacing: 11px;
        alignment: stretch;

        Rectangle {
            width: 14px;
            background: transparent;

            ShowcaseIcon {
                x: 0px;
                y: (parent.height - self.height) / 2;
                name: "session";
                size: 14px;
                tint: root.item.active ? AgTheme.accent : AgTheme.quiet;
            }
        }

        VerticalLayout {
            spacing: 3px;
            alignment: center;
            horizontal-stretch: 1;

            Text {
                text: root.item.title;
                color: root.item.active ? AgTheme.bone-strong : AgTheme.bone-dim;
                font-family: AgTheme.font-ui;
                font-size: 12px;
                font-weight: root.item.active ? AgTheme.weight-semibold : AgTheme.weight-regular;
                overflow: elide;
            }

            Text {
                text: root.item.detail;
                color: AgTheme.quiet;
                font-family: AgTheme.font-ui;
                font-size: AgTheme.type-micro;
                overflow: elide;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component PromptRow inherits Rectangle {
    in property <string> index;
    in property <string> label;
    in property <bool> reduced-motion: false;
    callback clicked();

    height: 54px;
    background: touch.has-hover ? AgTheme.accent-wash : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    animate background {
        duration: root.reduced-motion ? 0ms : AgTheme.motion-fast;
    }

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: AgTheme.hairline;
        background: AgTheme.line;
    }

    HorizontalLayout {
        padding-left: 2px;
        padding-right: 8px;
        spacing: 18px;

        Text {
            text: root.index;
            width: 24px;
            color: AgTheme.accent;
            font-family: AgTheme.font-mono;
            font-size: AgTheme.type-micro;
            vertical-alignment: center;
        }

        Text {
            text: root.label;
            color: touch.has-hover ? AgTheme.bone-strong : AgTheme.bone-dim;
            font-family: AgTheme.font-ui;
            font-size: AgTheme.type-body;
            font-weight: AgTheme.weight-medium;
            vertical-alignment: center;
            horizontal-alignment: left;
        }

        Rectangle { horizontal-stretch: 1; }

        ShowcaseIcon {
            name: "chevron-right";
            size: 13px;
            tint: touch.has-hover ? AgTheme.accent : AgTheme.quiet;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component EmptyHero inherits Rectangle {
    in property <string> project-name: "Argentum";
    in property <string> workspace-label: "Local workspace";
    in property <bool> reduced-motion: false;
    in property <bool> compact: false;
    callback suggest(string);

    background: transparent;

    Rectangle {
        x: parent.width - 150px;
        y: 40px;
        width: 118px;
        height: 118px;
        background: transparent;

        Text {
            text: "01";
            width: parent.width;
            height: parent.height;
            color: #F2EBDD0C;
            font-family: AgTheme.font-display;
            font-size: 104px;
            font-weight: AgTheme.weight-bold;
            horizontal-alignment: right;
            vertical-alignment: top;
        }
    }

    VerticalLayout {
        padding-left: AgTheme.gutter;
        padding-right: AgTheme.gutter;
        padding-top: root.compact ? 34px : 58px;
        padding-bottom: root.compact ? 20px : 36px;
        spacing: 0;

        Rectangle {
            width: 28px;
            height: 2px;
            background: AgTheme.accent;
        }

        Rectangle { height: root.compact ? 12px : 18px; }

        Text {
            text: "ARGENTUM / LOCAL AGENT";
            color: AgTheme.accent;
            font-family: AgTheme.font-ui;
            font-size: AgTheme.type-micro;
            font-weight: AgTheme.weight-semibold;
            letter-spacing: 1.8px;
        }

        VerticalLayout {
            padding-top: root.compact ? 10px : 16px;
            spacing: 0;

            Text {
                text: "Build what";
                color: AgTheme.bone-strong;
                font-family: AgTheme.font-display;
                font-size: root.width < 720px ? AgTheme.type-hero-compact : AgTheme.type-hero;
                font-weight: AgTheme.weight-bold;
                letter-spacing: -1.6px;
                overflow: elide;
            }

            Text {
                text: "holds up.";
                color: AgTheme.accent;
                font-family: AgTheme.font-display;
                font-size: root.width < 720px ? AgTheme.type-hero-compact : AgTheme.type-hero;
                font-weight: AgTheme.weight-bold;
                letter-spacing: -1.6px;
                overflow: elide;
            }
        }

        Rectangle { height: root.compact ? 14px : 22px; }

        Text {
            text: "A deliberate workbench for changes that survive review. Tools stay inside "
                + root.project-name
                + "; writes wait for you; verification stays in view.";
            width: min(parent.width, 560px);
            color: AgTheme.bone-dim;
            font-family: AgTheme.font-ui;
            font-size: AgTheme.type-lead;
            font-weight: AgTheme.weight-regular;
            wrap: word-wrap;
        }

        Rectangle { height: root.compact ? 8px : 12px; }

        Text {
            text: root.workspace-label;
            color: AgTheme.quiet;
            font-family: AgTheme.font-mono;
            font-size: AgTheme.type-micro;
            overflow: elide;
        }

        VerticalLayout {
            padding-top: root.compact ? 22px : 42px;
            spacing: 0;
            width: min(parent.width, 620px);

            PromptRow {
                index: "01";
                label: "Map the workspace";
                reduced-motion: root.reduced-motion;
                clicked => { root.suggest("Map this workspace and explain the architecture, the main crates, and where a change would start."); }
            }

            PromptRow {
                index: "02";
                label: "Fix a failing check";
                reduced-motion: root.reduced-motion;
                clicked => { root.suggest("Find the failing check, explain the cause, and propose the smallest safe fix before editing."); }
            }

            PromptRow {
                index: "03";
                label: "Review uncommitted changes";
                reduced-motion: root.reduced-motion;
                clicked => { root.suggest("Review the uncommitted changes for correctness, security boundaries, and missing verification."); }
            }
        }

        HorizontalLayout {
            padding-top: root.compact ? 24px : 44px;
            spacing: 12px;

            Text {
                text: "LOCAL FIRST";
                color: AgTheme.quiet;
                font-family: AgTheme.font-ui;
                font-size: AgTheme.type-micro;
                font-weight: AgTheme.weight-semibold;
                letter-spacing: 1.2px;
            }

            Text {
                text: "/";
                color: AgTheme.accent;
                font-family: AgTheme.font-ui;
                font-size: AgTheme.type-micro;
            }

            Text {
                text: "APPROVAL GATED";
                color: AgTheme.quiet;
                font-family: AgTheme.font-ui;
                font-size: AgTheme.type-micro;
                font-weight: AgTheme.weight-semibold;
                letter-spacing: 1.2px;
            }

            Text {
                text: "/";
                color: AgTheme.accent;
                font-family: AgTheme.font-ui;
                font-size: AgTheme.type-micro;
            }

            Text {
                text: "PROOF IN VIEW";
                color: AgTheme.quiet;
                font-family: AgTheme.font-ui;
                font-size: AgTheme.type-micro;
                font-weight: AgTheme.weight-semibold;
                letter-spacing: 1.2px;
            }
        }
    }
}

component MessageBlock inherits Rectangle {
    in property <ConversationMessageView> message;
    in property <bool> reduced-motion: false;

    background: transparent;

    VerticalLayout {
        padding-top: 26px;
        padding-bottom: 26px;
        spacing: 0;

        HorizontalLayout {
            spacing: 24px;

            Rectangle {
                width: 78px;
                background: transparent;

                VerticalLayout {
                    spacing: 7px;
                    alignment: start;

                    Rectangle {
                        width: 2px;
                        height: 18px;
                        background: root.message.role == "user" ? AgTheme.accent : AgTheme.line-strong;
                    }

                    Text {
                        text: root.message.role == "user"
                            ? "YOU"
                            : (root.message.role == "assistant" ? "ARGENTUM" : root.message.role);
                        color: root.message.role == "user" ? AgTheme.bone : AgTheme.muted;
                        font-family: AgTheme.font-ui;
                        font-size: 9px;
                        font-weight: AgTheme.weight-bold;
                        letter-spacing: 1.4px;
                        vertical-stretch: 0;
                    }

                    Text {
                        text: root.message.state;
                        color: AgTheme.quiet;
                        font-family: AgTheme.font-mono;
                        font-size: 9px;
                        overflow: elide;
                        vertical-stretch: 0;
                    }
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 12px;

                Text {
                    text: root.message.text;
                    color: root.message.role == "user" ? AgTheme.bone-strong : AgTheme.bone-dim;
                    font-family: AgTheme.font-ui;
                    font-size: 15px;
                    wrap: word-wrap;
                }

                if root.message.role == "assistant"
                    && (root.message.provider_label != "" || root.message.model != ""): Text {
                    text: root.message.provider_label + (root.message.model != "" ? " / " + root.message.model : "")
                        + (root.message.usage_reported ? " / " + root.message.total_tokens + " tokens" : "");
                    color: AgTheme.quiet;
                    font-family: AgTheme.font-mono;
                    font-size: 9px;
                    overflow: elide;
                }

                if root.message.reasoning_available: VerticalLayout {
                    spacing: 5px;
                    alignment: start;

                    Text {
                        text: "REASONING ATTACHED";
                        color: AgTheme.amber;
                        font-family: AgTheme.font-ui;
                        font-size: 9px;
                        font-weight: AgTheme.weight-semibold;
                        letter-spacing: 1.2px;
                    }

                    Text {
                        text: root.message.reasoning;
                        color: AgTheme.quiet;
                        font-family: AgTheme.font-ui;
                        font-size: 11px;
                        overflow: elide;
                    }
                }
            }
        }

        Rectangle {
            width: parent.width;
            height: AgTheme.hairline;
            background: AgTheme.line-faint;
        }
    }
}

component TabButton inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <bool> reduced-motion: false;
    callback clicked();

    height: 44px;
    min-width: 48px;
    background: touch.has_hover ? AgTheme.panel : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    animate background {
        duration: root.reduced-motion ? 0ms : AgTheme.motion-fast;
    }

    Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height - 2px;
        text: root.label;
        color: root.active ? AgTheme.bone-strong : AgTheme.muted;
        font-family: AgTheme.font-ui;
        font-size: 9px;
        font-weight: root.active ? AgTheme.weight-bold : AgTheme.weight-medium;
        letter-spacing: 0.2px;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    Rectangle {
        x: 0px;
        y: parent.height - 2px;
        width: parent.width;
        height: 2px;
        background: root.active ? AgTheme.accent : transparent;
        animate background {
            duration: root.reduced-motion ? 0ms : AgTheme.motion-fast;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component ComposerPanel inherits Rectangle {
    in-out property <string> draft: "";
    in property <string> provider-label: "LM Studio";
    in property <string> project-name: "Argentum";
    in property <string> workspace-label: "Local workspace";
    in property <bool> running: false;
    in property <bool> approval-pending: false;
    in property <bool> submission-pending: false;
    in property <string> active-run-id: "";
    in property <bool> reduced-motion: false;
    callback submit(string);
    callback cancel(string);

    height: 132px;
    border-radius: AgTheme.radius-sm;
    border-width: AgTheme.hairline;
    border-color: editor.has-focus ? AgTheme.accent-line : AgTheme.line;
    background: AgTheme.panel;
    clip: true;

    Rectangle {
        x: 0px;
        y: 0px;
        width: 2px;
        height: parent.height;
        background: editor.has-focus
            ? AgTheme.accent
            : (root.approval-pending ? AgTheme.amber : AgTheme.line-strong);
    }

    Text {
        visible: root.draft == "";
        x: 20px;
        y: 18px;
        width: parent.width - 40px;
        height: 48px;
        text: "Tell Argentum what to change...";
        color: AgTheme.quiet;
        font-family: AgTheme.font-ui;
        font-size: 15px;
        vertical-alignment: top;
    }

    editor := TextInput {
        x: 20px;
        y: 16px;
        width: parent.width - 40px;
        height: 56px;
        text <=> root.draft;
        color: AgTheme.bone-strong;
        selection-foreground-color: AgTheme.accent-ink;
        selection-background-color: AgTheme.accent;
        font-family: AgTheme.font-ui;
        font-size: 15px;
        single-line: false;
        wrap: word-wrap;
        enabled: !root.approval-pending && !root.submission-pending;
        accessible-label: "Task prompt";
        key-pressed(event) => {
            if event.text == "\n"
                && !event.modifiers.shift
                && !root.running
                && !root.approval-pending
                && !root.submission-pending
                && root.draft != ""
            {
                root.submit(root.draft);
                return accept;
            }
            return reject;
        }
    }

    Rectangle {
        x: 20px;
        y: 81px;
        width: parent.width - 40px;
        height: AgTheme.hairline;
        background: AgTheme.line;
    }

    HorizontalLayout {
        x: 20px;
        y: 85px;
        width: parent.width - 40px;
        height: 36px;
        spacing: 12px;

        ShowcaseIcon {
            name: "model";
            size: 13px;
            tint: AgTheme.muted;
        }

        Text {
            text: root.provider-label;
            color: AgTheme.bone-dim;
            font-family: AgTheme.font-ui;
            font-size: AgTheme.type-micro;
            font-weight: AgTheme.weight-medium;
            overflow: elide;
            max-width: 140px;
            horizontal-alignment: left;
        }

        Rectangle {
            width: AgTheme.hairline;
            height: 14px;
            background: AgTheme.line;
        }

        ShowcaseIcon {
            name: "folder";
            size: 12px;
            tint: AgTheme.quiet;
        }

        Text {
            text: root.project-name;
            color: AgTheme.quiet;
            font-family: AgTheme.font-ui;
            font-size: AgTheme.type-micro;
            overflow: elide;
            max-width: 160px;
        }

        Rectangle { horizontal-stretch: 1; }

        Text {
            text: root.approval-pending
                ? "APPROVAL BLOCKS THIS RUN"
                : (root.submission-pending
                    ? "STARTING"
                    : (root.running ? "ENTER STOPS THE RUN" : "ENTER RUNS / SHIFT+ENTER BREAKS"));
            color: root.approval-pending ? AgTheme.amber : AgTheme.quiet;
            font-family: AgTheme.font-ui;
            font-size: 8px;
            font-weight: AgTheme.weight-semibold;
            letter-spacing: 0.7px;
            vertical-alignment: center;
            overflow: elide;
        }

        SolidButton {
            width: 116px;
            height: 34px;
            label: root.approval-pending
                ? "Awaiting"
                : (root.submission-pending
                    ? "Starting"
                    : (root.running ? "Stop run" : "Run task"));
            icon: root.running ? "stop" : "play";
            enabled: !root.approval-pending
                && !root.submission-pending
                && (root.running || root.draft != "");
            fill: root.approval-pending
                ? AgTheme.amber
                : (root.running ? AgTheme.bone : AgTheme.accent);
            hover-fill: root.approval-pending
                ? AgTheme.amber
                : (root.running ? AgTheme.bone-strong : AgTheme.accent-hover);
            foreground: AgTheme.accent-ink;
            reduced-motion: root.reduced-motion;
            clicked => {
                if (root.running) {
                    root.cancel(root.active-run-id);
                } else {
                    root.submit(root.draft);
                }
            }
        }
    }
}

component ApprovalPanel inherits Rectangle {
    in property <string> action;
    in property <string> target;
    in property <string> reason;
    in property <bool> pending: false;
    in property <bool> reduced-motion: false;
    callback approve();
    callback reject();

    height: 98px;
    border-radius: AgTheme.radius-sm;
    border-width: AgTheme.hairline;
    border-color: AgTheme.amber;
    background: #1B1710;
    clip: true;

    Rectangle {
        x: 0px;
        y: 0px;
        width: 3px;
        height: parent.height;
        background: AgTheme.amber;
    }

    HorizontalLayout {
        padding-left: 22px;
        padding-right: 18px;
        spacing: 18px;

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 5px;

            Text {
                text: "APPROVAL REQUIRED";
                color: AgTheme.amber;
                font-family: AgTheme.font-ui;
                font-size: 9px;
                font-weight: AgTheme.weight-bold;
                letter-spacing: 1.6px;
            }

            Text {
                text: root.action + "  /  " + root.target;
                color: AgTheme.bone-strong;
                font-family: AgTheme.font-ui;
                font-size: 13px;
                font-weight: AgTheme.weight-semibold;
                overflow: elide;
            }

            Text {
                text: root.reason;
                color: AgTheme.bone-dim;
                font-family: AgTheme.font-ui;
                font-size: AgTheme.type-micro;
                overflow: elide;
            }
        }

        OutlineButton {
            label: "Reject";
            enabled: !root.pending;
            reduced-motion: root.reduced-motion;
            clicked => { root.reject(); }
        }

        SolidButton {
            width: 136px;
            label: root.pending ? "Sending" : "Approve once";
            icon: "check";
            enabled: !root.pending;
            fill: AgTheme.amber;
            hover-fill: #FFC98C;
            foreground: AgTheme.accent-ink;
            reduced-motion: root.reduced-motion;
            clicked => { root.approve(); }
        }
    }
}

component ErrorPanel inherits Rectangle {
    in property <string> message;

    height: 46px;
    border-width: AgTheme.hairline;
    border-color: AgTheme.coral;
    background: AgTheme.coral-wash;
    border-radius: AgTheme.radius-sm;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 10px;
        alignment: center;

        ShowcaseIcon {
            name: "alert";
            size: 14px;
            tint: AgTheme.coral;
        }

        Text {
            text: root.message;
            color: AgTheme.bone;
            font-family: AgTheme.font-ui;
            font-size: AgTheme.type-small;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
}

component SettingsSectionRow inherits Rectangle {
    in property <string> index;
    in property <string> label;
    in property <bool> active: false;
    in property <bool> reduced-motion: false;
    callback clicked();

    height: 46px;
    border-radius: AgTheme.radius-sm;
    background: root.active
        ? AgTheme.accent-wash
        : (touch.has-hover ? AgTheme.panel : transparent);
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    animate background {
        duration: root.reduced-motion ? 0ms : AgTheme.motion-fast;
    }

    if root.active: Rectangle {
        x: 0px;
        y: 10px;
        width: 2px;
        height: 26px;
        background: AgTheme.accent;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;

        Text {
            text: root.index;
            width: 20px;
            color: root.active ? AgTheme.accent : AgTheme.quiet;
            font-family: AgTheme.font-mono;
            font-size: 9px;
            vertical-alignment: center;
        }

        Text {
            text: root.label;
            color: root.active ? AgTheme.bone-strong : AgTheme.bone-dim;
            font-family: AgTheme.font-ui;
            font-size: 12px;
            font-weight: root.active ? AgTheme.weight-semibold : AgTheme.weight-regular;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        ShowcaseIcon {
            name: "chevron-right";
            size: 11px;
            tint: root.active ? AgTheme.accent : AgTheme.quiet;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component SettingsInfoLine inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> detail: "";
    in property <color> value-color: AgTheme.bone;

    background: transparent;

    HorizontalLayout {
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 16px;

        Text {
            width: 122px;
            text: root.label;
            color: AgTheme.quiet;
            font-family: AgTheme.font-ui;
            font-size: 9px;
            font-weight: AgTheme.weight-semibold;
            letter-spacing: 1px;
            vertical-alignment: top;
            wrap: word-wrap;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 3px;

            Text {
                text: root.value != "" ? root.value : "Not reported";
                color: root.value != "" ? root.value-color : AgTheme.quiet;
                font-family: AgTheme.font-mono;
                font-size: 10px;
                wrap: word-wrap;
            }

            if root.detail != "": Text {
                text: root.detail;
                color: AgTheme.quiet;
                font-family: AgTheme.font-ui;
                font-size: 9px;
                wrap: word-wrap;
            }
        }
    }
}

component SettingsToggle inherits Rectangle {
    in property <bool> checked: false;
    in property <bool> reduced-motion: false;
    callback toggled();

    width: 44px;
    height: 24px;
    border-radius: 12px;
    border-width: AgTheme.hairline;
    border-color: root.checked ? AgTheme.accent : AgTheme.line-strong;
    background: root.checked ? AgTheme.accent : AgTheme.panel;
    accessible-role: checkbox;
    accessible-label: "Reduced motion";
    accessible-checked: root.checked;
    accessible-action-default => { root.toggled(); }
    animate background, border-color {
        duration: root.reduced-motion ? 0ms : AgTheme.motion-fast;
    }

    Rectangle {
        x: root.checked ? parent.width - self.width - 3px : 3px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.checked ? AgTheme.accent-ink : AgTheme.bone-dim;
        animate x {
            duration: root.reduced-motion ? 0ms : AgTheme.motion-fast;
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

component CommandRow inherits Rectangle {
    in property <string> index;
    in property <string> label;
    in property <string> detail;
    in property <string> icon;
    in property <bool> selected: false;
    in property <bool> row-visible: true;
    in property <bool> reduced-motion: false;
    callback clicked();

    visible: root.row-visible;
    height: 50px;
    border-radius: AgTheme.radius-sm;
    background: root.selected
        ? AgTheme.accent-wash
        : (touch.has-hover ? AgTheme.panel : transparent);
    accessible-role: button;
    accessible-label: root.label + ". " + root.detail;
    accessible-action-default => { root.clicked(); }
    animate background {
        duration: root.reduced-motion ? 0ms : AgTheme.motion-fast;
    }

    if root.selected: Rectangle {
        x: 0px;
        y: 10px;
        width: 2px;
        height: 30px;
        background: AgTheme.accent;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 11px;

        Text {
            width: 20px;
            text: root.index;
            color: root.selected ? AgTheme.accent : AgTheme.quiet;
            font-family: AgTheme.font-mono;
            font-size: 9px;
            vertical-alignment: center;
        }

        ShowcaseIcon {
            name: root.icon;
            size: 14px;
            tint: root.selected ? AgTheme.accent : AgTheme.muted;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 3px;
            alignment: center;

            Text {
                text: root.label;
                color: root.selected ? AgTheme.bone-strong : AgTheme.bone-dim;
                font-family: AgTheme.font-ui;
                font-size: 12px;
                font-weight: root.selected ? AgTheme.weight-semibold : AgTheme.weight-medium;
            }

            Text {
                text: root.detail;
                color: AgTheme.quiet;
                font-family: AgTheme.font-ui;
                font-size: 9px;
                overflow: elide;
            }
        }

        if root.selected: Text {
            text: "ENTER";
            color: AgTheme.accent;
            font-family: AgTheme.font-mono;
            font-size: 8px;
            letter-spacing: 0.8px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

