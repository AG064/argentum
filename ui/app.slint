    in-out property <[PlanStepView]> plan_steps: [];
    in-out property <string> activity_summary: "No activity yet";
    in-out property <[ActivityItemView]> activity_items: [];
    in-out property <string> trajectory_summary: "No durable records";
    in-out property <[TrajectoryItemView]> trajectory_items: [];
    in-out property <[InspectorModeView]> inspector_modes: [];
    in-out property <bool> trajectory_loading: false;
    in-out property <bool> trajectory_truncated: false;
    in-out property <string> trajectory_error: "";
    in-out property <string> change_summary: "No files changed";
    in-out property <[FileChangeView]> change_files: [];
    in-out property <int> changed_files: 0;
    in-out property <int> additions: 0;
    in-out property <int> removals: 0;
    in-out property <string> selected_file_change_id: "";
    in-out property <string> selected_change_path: "";
    in-out property <string> selected_diff: "";
    in-out property <bool> selected_diff_available: false;
    in-out property <bool> selected_diff_truncated: false;
    in-out property <string> selected_diff_reason: "Select a file to load its diff.";
    in-out property <bool> selected_restore_available: false;
    in-out property <string> selected_restore_reason: "Select a file to inspect restore availability.";
    in-out property <bool> recovery_required: false;
    in-out property <string> recovery_summary: "";
    in-out property <string> recovery_operation_id: "";
    in-out property <string> verification_state: "pending";
    in-out property <string> verification_summary: "No automated checks were run";
    in-out property <string> active_run_id: "";
    in-out property <bool> running: false;
    in-out property <bool> submission_pending: false;
    in-out property <bool> drawer_open: false;
    in-out property <bool> inspector_collapsed: true;
    in-out property <string> active_inspector: "";
    in-out property <bool> approval_open: false;
    in-out property <string> approval_id: "";
    in-out property <string> approval_action: "";
    in-out property <string> approval_target: "";
    in-out property <string> approval_reason: "";
    in-out property <bool> approval_response_pending: false;
    in-out property <bool> about_open: false;
    in-out property <bool> settings_open: false;
    in-out property <bool> command_palette_open: false;
    in-out property <bool> model_menu_open: false;
    in-out property <bool> context_menu_open: false;
    in-out property <bool> reduced_motion: false;
    // Platform hosts may project native insets here. Desktop defaults remain zero.
    in-out property <length> safe_area_top: 0px;
    in-out property <length> safe_area_bottom: 0px;
    in-out property <length> keyboard_inset: 0px;

    callback submit_task(string);
    callback cancel_run(string);
    callback new_session();
    callback select_session(string);
    callback set_goal(string, int, int, int);
    callback pause_goal();
    callback resume_goal();
    callback clear_goal();
    callback probe_provider(string);
    callback save_provider_credential(string, string);
    callback clear_provider_credential(string);
    callback install_and_load_local_model();
    callback unload_local_model();
    callback open_settings();
    callback save_provider_profile(string, string, string, string, string, bool);
    callback select_provider_profile(string);
    callback refresh_provider_models(string);
    callback select_provider_model(string, string);
    callback refresh_harness();
    callback set_harness_module(string, string);
    callback set_local_backend_enabled(bool);
    callback select_harness_profile(string);
    callback set_harness_surface_visibility(string, bool);
    callback select_execution_profile(string);
    callback set_harness_capability_enabled(string, bool);
    callback validate_provider_label(string) -> string;
    callback validate_provider_endpoint(string) -> string;
    callback validate_provider_model(string) -> string;
    callback toggle_drawer();
    callback set_inspector_surface(string);
    callback refresh_trajectory(string);
    callback load_change_diff(string);
    callback request_restore(string);
    callback load_change_recovery();
    callback retry_change_recovery(string);
    callback request_recovery_restore(string);
    callback approve_tool(string);
    callback reject_tool(string);

    private property <bool> compact-mode: false;
    private property <bool> inspector-visible: root.width >= 1200px && !root.compact-mode;
    private property <length> inspector-slot: root.inspector-visible ? AgTheme.inspector-width : 0px;
    private property <length> center-width: root.width - AgTheme.rail-width - root.inspector-slot;
    private property <string> display-verification-label: root.verification_state == "passed"
        ? "Passed"
        : (root.verification_state == "failed"
            ? "Failed"
            : (root.verification_state == "ready" ? "Ready" : "Not run"));
    private property <string> inspector-tab: "changes";
    private property <string> inspector-heading: root.inspector-tab == "changes"
        ? "Changes"
        : (root.inspector-tab == "tools"
            ? "Tools"
            : (root.inspector-tab == "verification" ? "Verification" : "Activity"));
    private property <bool> showcase-pulse: false;
    private property <bool> has-conversation: root.conversation_messages.length > 0
        || root.user_prompt != ""
        || root.transcript != "";
    private property <int> settings-section-index: 0;
    private property <string> settings-section-label: root.settings-section-index == 0
        ? "Workspace"
        : (root.settings-section-index == 1
            ? "Provider"
            : (root.settings-section-index == 2
                ? "Model"
                : (root.settings-section-index == 3 ? "Appearance" : "About / Version")));
    private property <int> settings-focus-index: 0;
    private property <string> settings-primary-label: root.settings-section-index == 0
        ? "About this build"
        : (root.settings-section-index == 1
            ? (root.provider_testing ? "Testing" : "Test connection")
            : (root.settings-section-index == 2
                ? (root.provider_models_loading ? "Refreshing" : "Refresh models")
                : (root.settings-section-index == 3
                    ? (root.reduced_motion ? "Enable motion" : "Reduce motion")
                    : "Open About panel")));
    private property <string> settings-primary-icon: root.settings-section-index == 0
        ? "session"
        : (root.settings-section-index == 1
            ? "verify"
            : (root.settings-section-index == 2
                ? "model"
                : (root.settings-section-index == 3 ? "motion" : "alert")));
    private property <bool> settings-primary-enabled: root.settings-section-index == 1
        ? root.provider_id != "" && !root.provider_testing
        : (root.settings-section-index == 2
            ? root.provider_id != "" && !root.provider_models_loading
            : true);
    private property <string> command-filter: "";
    private property <string> command-filter-lower: root.command-filter.to-lowercase();
    private property <bool> show-new: root.command-filter-lower == ""
        || root.command-filter-lower == "n"
        || root.command-filter-lower == "ne"
        || root.command-filter-lower == "new";
    private property <bool> show-settings: root.command-filter-lower == ""
        || root.command-filter-lower == "s"
        || root.command-filter-lower == "se"
        || root.command-filter-lower == "set"
        || root.command-filter-lower == "sett"
        || root.command-filter-lower == "setti"
        || root.command-filter-lower == "settin"
        || root.command-filter-lower == "setting"
        || root.command-filter-lower == "settings";
    private property <bool> show-model: root.command-filter-lower == ""
        || root.command-filter-lower == "m"
        || root.command-filter-lower == "mo"
        || root.command-filter-lower == "mod"
        || root.command-filter-lower == "mode"
        || root.command-filter-lower == "model"
        || root.command-filter-lower == "ch"
        || root.command-filter-lower == "cho"
        || root.command-filter-lower == "choo"
        || root.command-filter-lower == "choos"
        || root.command-filter-lower == "choose";
    private property <bool> show-context: root.command-filter-lower == ""
        || root.command-filter-lower == "c"
        || root.command-filter-lower == "co"
        || root.command-filter-lower == "con"
        || root.command-filter-lower == "cont"
        || root.command-filter-lower == "conte"
        || root.command-filter-lower == "contex"
        || root.command-filter-lower == "context";
    private property <bool> show-compact: root.command-filter-lower == ""
        || root.command-filter-lower == "c"
        || root.command-filter-lower == "co"
        || root.command-filter-lower == "com"
        || root.command-filter-lower == "comp"
        || root.command-filter-lower == "compa"
        || root.command-filter-lower == "compac"
        || root.command-filter-lower == "compact";
    private property <bool> show-status: root.command-filter-lower == ""
        || root.command-filter-lower == "st"
        || root.command-filter-lower == "sta"
        || root.command-filter-lower == "stat"
        || root.command-filter-lower == "statu"
        || root.command-filter-lower == "status";
    private property <bool> show-about: root.command-filter-lower == ""
        || root.command-filter-lower == "a"
        || root.command-filter-lower == "ab"
        || root.command-filter-lower == "abo"
        || root.command-filter-lower == "abou"
        || root.command-filter-lower == "about";
    private property <bool> show-close: root.command-filter-lower == ""
        || root.command-filter-lower == "c"
        || root.command-filter-lower == "cl"
        || root.command-filter-lower == "clo"
        || root.command-filter-lower == "clos"
        || root.command-filter-lower == "close";
    private property <int> command-selected: 0;
    private property <bool> keyboard-focus-pending: true;

    function open-settings-at(section-index: int) {
        root.command-palette-open = false;
        root.settings-section-index = section-index;
        root.settings-open = true;
        root.open-settings();
        if root.provider_id != "" {
            root.refresh-provider-models(root.provider_id);
        }
    }

    function settings-primary-action() {
        if root.settings-section-index == 0 || root.settings-section-index == 4 {
            root.about-open = true;
        } else if root.settings-section-index == 1 {
            if root.provider_id != "" {
                root.probe-provider(root.provider_id);
            }
        } else if root.settings-section-index == 2 {
            if root.provider_id != "" {
                root.refresh-provider-models(root.provider_id);
            }
        } else if root.settings-section-index == 3 {
            root.reduced-motion = !root.reduced-motion;
        }
    }

    function command-visible(index: int) -> bool {
        if index == 0 { return root.show-new; }
        if index == 1 { return root.show-settings; }
        if index == 2 { return root.show-model; }
        if index == 3 { return root.show-context; }
        if index == 4 { return root.show-compact; }
        if index == 5 { return root.show-status; }
        if index == 6 { return root.show-about; }
        if index == 7 { return root.show-close; }
        return false;
    }

    function first-visible() -> int {
        if root.show-new { return 0; }
        if root.show-settings { return 1; }
        if root.show-model { return 2; }
        if root.show-context { return 3; }
        if root.show-compact { return 4; }
        if root.show-status { return 5; }
        if root.show-about { return 6; }
        if root.show-close { return 7; }
        return 0;
    }

    function next-visible(start: int) -> int {
        if start == 0 {
            if root.show-settings { return 1; }
            if root.show-model { return 2; }
            if root.show-context { return 3; }
            if root.show-compact { return 4; }
            if root.show-status { return 5; }
            if root.show-about { return 6; }
            if root.show-close { return 7; }
            if root.show-new { return 0; }
            return root.first-visible();
        }
        if start == 1 {
            if root.show-model { return 2; }
            if root.show-context { return 3; }
            if root.show-compact { return 4; }
            if root.show-status { return 5; }
            if root.show-about { return 6; }
            if root.show-close { return 7; }
            if root.show-new { return 0; }
            if root.show-settings { return 1; }
            return root.first-visible();
        }
        if start == 2 {
            if root.show-context { return 3; }
            if root.show-compact { return 4; }
            if root.show-status { return 5; }
            if root.show-about { return 6; }
            if root.show-close { return 7; }
            if root.show-new { return 0; }
            if root.show-settings { return 1; }
            if root.show-model { return 2; }
            return root.first-visible();
        }
        if start == 3 {
            if root.show-compact { return 4; }
            if root.show-status { return 5; }
            if root.show-about { return 6; }
            if root.show-close { return 7; }
            if root.show-new { return 0; }
            if root.show-settings { return 1; }
            if root.show-model { return 2; }
            if root.show-context { return 3; }
            return root.first-visible();
        }
        if start == 4 {
            if root.show-status { return 5; }
            if root.show-about { return 6; }
            if root.show-close { return 7; }
            if root.show-new { return 0; }
            if root.show-settings { return 1; }
            if root.show-model { return 2; }
            if root.show-context { return 3; }
            if root.show-compact { return 4; }
            return root.first-visible();
        }
        if start == 5 {
            if root.show-about { return 6; }
            if root.show-close { return 7; }
            if root.show-new { return 0; }
            if root.show-settings { return 1; }
            if root.show-model { return 2; }
            if root.show-context { return 3; }
            if root.show-compact { return 4; }
            if root.show-status { return 5; }
            return root.first-visible();
        }
        if start == 6 {
            if root.show-close { return 7; }
            if root.show-new { return 0; }
            if root.show-settings { return 1; }
            if root.show-model { return 2; }
            if root.show-context { return 3; }
            if root.show-compact { return 4; }
            if root.show-status { return 5; }
            if root.show-about { return 6; }
            return root.first-visible();
        }
        if start == 7 {
            if root.show-new { return 0; }
            if root.show-settings { return 1; }
            if root.show-model { return 2; }
            if root.show-context { return 3; }
            if root.show-compact { return 4; }
            if root.show-status { return 5; }
            if root.show-about { return 6; }
            if root.show-close { return 7; }
            return root.first-visible();
        }
        return root.first-visible();
    }

    function previous-visible(start: int) -> int {
        if start == 0 {
            if root.show-close { return 7; }
            if root.show-about { return 6; }
            if root.show-status { return 5; }
            if root.show-compact { return 4; }
            if root.show-context { return 3; }
            if root.show-model { return 2; }
            if root.show-settings { return 1; }
            if root.show-new { return 0; }
            return root.last-visible();
        }
        if start == 1 {
            if root.show-new { return 0; }
            if root.show-close { return 7; }
            if root.show-about { return 6; }
            if root.show-status { return 5; }
            if root.show-compact { return 4; }
            if root.show-context { return 3; }
            if root.show-model { return 2; }
            if root.show-settings { return 1; }
            return root.last-visible();
        }
        if start == 2 {
            if root.show-settings { return 1; }
            if root.show-new { return 0; }
            if root.show-close { return 7; }
            if root.show-about { return 6; }
            if root.show-status { return 5; }
            if root.show-compact { return 4; }
            if root.show-context { return 3; }
            if root.show-model { return 2; }
            return root.last-visible();
        }
        if start == 3 {
            if root.show-model { return 2; }
            if root.show-settings { return 1; }
            if root.show-new { return 0; }
            if root.show-close { return 7; }
            if root.show-about { return 6; }
            if root.show-status { return 5; }
            if root.show-compact { return 4; }
            if root.show-context { return 3; }
            return root.last-visible();
        }
        if start == 4 {
            if root.show-context { return 3; }
            if root.show-model { return 2; }
            if root.show-settings { return 1; }
            if root.show-new { return 0; }
            if root.show-close { return 7; }
            if root.show-about { return 6; }
            if root.show-status { return 5; }
            if root.show-compact { return 4; }
            return root.last-visible();
        }
        if start == 5 {
            if root.show-compact { return 4; }
            if root.show-context { return 3; }
            if root.show-model { return 2; }
            if root.show-settings { return 1; }
            if root.show-new { return 0; }
            if root.show-close { return 7; }
            if root.show-about { return 6; }
            if root.show-status { return 5; }
            return root.last-visible();
        }
        if start == 6 {
            if root.show-status { return 5; }
            if root.show-compact { return 4; }
            if root.show-context { return 3; }
            if root.show-model { return 2; }
            if root.show-settings { return 1; }
            if root.show-new { return 0; }
            if root.show-close { return 7; }
            if root.show-about { return 6; }
            return root.last-visible();
        }
        if start == 7 {
            if root.show-about { return 6; }
            if root.show-status { return 5; }
            if root.show-compact { return 4; }
            if root.show-context { return 3; }
            if root.show-model { return 2; }
            if root.show-settings { return 1; }
            if root.show-new { return 0; }
            if root.show-close { return 7; }
            return root.last-visible();
        }
        return root.last-visible();
    }
    function last-visible() -> int {
        if root.show-close { return 7; }
        if root.show-about { return 6; }
        if root.show-status { return 5; }
        if root.show-compact { return 4; }
        if root.show-context { return 3; }
        if root.show-model { return 2; }
        if root.show-settings { return 1; }
        if root.show-new { return 0; }
        return 0;
    }

    function execute-command(index: int) {
        if index == 0 {
            root.command-palette-open = false;
            root.new_session();
        } else if index == 1 {
            root.open-settings-at(0);
        } else if index == 2 {
            root.open-settings-at(2);
        } else if index == 3 {
            root.open-settings-at(0);
        } else if index == 4 {
            root.compact-mode = !root.compact-mode;
            root.command-palette-open = false;
        } else if index == 5 {
            root.open-settings-at(4);
        } else if index == 6 {
            root.command-palette-open = false;
            root.about-open = true;
        } else {
            root.command-palette-open = false;
        }
    }

    changed settings_open => {
        if root.settings_open {
            root.settings-focus-index = 0;
            settings-focus.focus();
        } else if !root.about_open && !root.command_palette_open {
            root.keyboard-focus-pending = true;
        }
    }

    changed about_open => {
        if root.about_open {
            about-focus.focus();
        } else if root.settings_open {
            settings-focus.focus();
        } else if !root.command_palette_open {
            root.keyboard-focus-pending = true;
        }
    }

    changed command_palette_open => {
        if root.command_palette_open {
            root.command-filter = "";
            root.command-selected = root.first-visible();
            palette-filter-input.focus();
        } else if root.settings_open {
            settings-focus.focus();
        } else if root.about_open {
            about-focus.focus();
        } else {
            root.keyboard-focus-pending = true;
        }
    }

    changed command_filter => {
        root.command-selected = root.first-visible();
    }

    changed active_inspector => {
        if root.active_inspector == "changes" {
            root.inspector-tab = "changes";
        } else if root.active_inspector == "activity" || root.active_inspector == "trajectory" {
            root.inspector-tab = "activity";
        } else if root.active_inspector == "terminal" || root.active_inspector == "tools" {
            root.inspector-tab = "tools";
        } else if root.active_inspector == "plan" || root.active_inspector == "verification" {
            root.inspector-tab = "verification";
        }
    }

    Timer {
        interval: AgTheme.motion-pulse;
        running: (root.running || root.approval_open) && !root.reduced_motion;
        triggered => { root.showcase-pulse = !root.showcase-pulse; }
    }

    Timer {
        interval: 200ms;
        running: root.keyboard-focus-pending;
        triggered => {
            root.keyboard-focus-pending = false;
            app-keyboard.focus();
        }
    }

    app-keyboard := FocusScope {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        focus-on-click: false;
        focus-on-tab-navigation: false;

        capture-key-pressed(event) => {
            if event.text != Key.Escape {
                return reject;
            }
            if root.command_palette_open {
                root.command_palette_open = false;
                return accept;
            }
            if root.about_open {
                root.about_open = false;
                return accept;
            }
            if root.settings_open {
                root.settings_open = false;
                return accept;
            }
            return reject;
        }

        KeyBinding {
            keys: @keys(Control + K);
            activated => {
                root.settings_open = false;
                root.about_open = false;
                root.command_palette_open = !root.command_palette_open;
                root.command_filter = "";
            }
        }

        KeyBinding {
            keys: @keys(Control + ",");
            activated => {
                root.command_palette_open = false;
                root.open-settings-at(0);
            }
        }
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: AgTheme.canvas;

        // Left navigation rail
        Rectangle {
            x: 0px;
            y: 0px;
            width: AgTheme.rail-width;
            height: parent.height;
            background: AgTheme.rail;

            Rectangle {
                x: parent.width - 1px;
                y: 0px;
                width: AgTheme.hairline;
                height: parent.height;
                background: AgTheme.line;
            }

            VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 22px;
                padding-bottom: 18px;
                spacing: 0;

                BrandLockup { }

                Rectangle { height: 28px; }

                Rectangle {
                    height: 70px;
                    border-radius: AgTheme.radius-sm;
                    border-width: AgTheme.hairline;
                    border-color: AgTheme.line;
                    background: AgTheme.panel;

                    HorizontalLayout {
                        padding-left: 13px;
                        padding-right: 12px;
                        spacing: 11px;
                        alignment: center;

                        Rectangle {
                            width: 26px;
                            height: 26px;
                            background: AgTheme.accent-wash;
                            border-radius: AgTheme.radius-sm;

                            ShowcaseIcon {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                name: "workspace";
                                size: 14px;
                                tint: AgTheme.accent;
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            alignment: center;
                            horizontal-stretch: 1;

                            Text {
                                text: "WORKSPACE";
                                color: AgTheme.quiet;
                                font-family: AgTheme.font-ui;
                                font-size: 8px;
                                font-weight: AgTheme.weight-semibold;
                                letter-spacing: 1.2px;
                            }

                            Text {
                                text: root.project_name;
                                color: AgTheme.bone;
                                font-family: AgTheme.font-ui;
                                font-size: 13px;
                                font-weight: AgTheme.weight-semibold;
                                overflow: elide;
                            }

                            Text {
                                text: root.workspace_label;
                                color: AgTheme.muted;
                                font-family: AgTheme.font-mono;
                                font-size: 8px;
                                overflow: elide;
                            }
                        }
                    }
                }

                Rectangle { height: 14px; }

                OutlineButton {
                    label: "New session";
                    icon: "plus";
                    height: 42px;
                    horizontal-stretch: 1;
                    reduced-motion: root.reduced_motion;
                    clicked => { root.new_session(); }
                }

                Rectangle { height: 26px; }

                HorizontalLayout {
                    height: 20px;
                    spacing: 8px;

                    Text {
                        text: "SESSIONS";
                        color: AgTheme.muted;
                        font-family: AgTheme.font-ui;
                        font-size: 9px;
                        font-weight: AgTheme.weight-semibold;
                        letter-spacing: 1.4px;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Text {
                        text: root.session_items.length + " total";
                        color: AgTheme.quiet;
                        font-family: AgTheme.font-mono;
                        font-size: 8px;
                        vertical-alignment: center;
                    }
                }

                Rectangle { height: 8px; }

                ScrollView {
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    mouse-drag-pan-enabled: true;

                    VerticalLayout {
                        spacing: 3px;

                        if root.session_items.length == 0: Text {
                            text: "No sessions yet.\nStart with a task.";
                            color: AgTheme.quiet;
                            font-family: AgTheme.font-ui;
                            font-size: AgTheme.type-micro;
                            wrap: word-wrap;
                        }

                        for session in root.session_items: SessionRow {
                            item: session;
                            reduced-motion: root.reduced_motion;
                            clicked => {
                                if (!session.active) {
                                    root.select_session(session.id);
                                }
                            }
                        }
                    }
                }

                Rectangle { height: 16px; }

                Rectangle {
                    height: AgTheme.hairline;
                    background: AgTheme.line;
                }

                Rectangle { height: 12px; }

                HorizontalLayout {
                    height: 36px;
                    spacing: 9px;
                    alignment: center;

                    ShowcaseIcon {
                        name: "model";
                        size: 14px;
                        tint: root.provider_connected ? AgTheme.accent : AgTheme.muted;
                    }

                    VerticalLayout {
                        spacing: 3px;
                        alignment: center;
                        horizontal-stretch: 1;

                        Text {
                            text: root.provider_label;
                            color: AgTheme.bone-dim;
                            font-family: AgTheme.font-ui;
                            font-size: 10px;
                            font-weight: AgTheme.weight-medium;
                            overflow: elide;
                        }

                        Text {
                            text: root.provider_connected ? "CONNECTED" : "NOT TESTED";
                            color: root.provider_connected ? AgTheme.accent : AgTheme.quiet;
                            font-family: AgTheme.font-ui;
                            font-size: 7px;
                            font-weight: AgTheme.weight-semibold;
                            letter-spacing: 1.1px;
                        }
                    }
                }

                Rectangle { height: 8px; }

                Rectangle {
                    height: 42px;
                    border-radius: AgTheme.radius-sm;
                    background: settings-touch.has-hover ? AgTheme.panel : transparent;
                    accessible-role: button;
                    accessible-label: "Settings";
                    accessible-action-default => { root.open-settings-at(0); }
                    animate background {
                        duration: root.reduced_motion ? 0ms : AgTheme.motion-fast;
                    }

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 10px;

                        ShowcaseIcon {
                            name: "settings";
                            size: 14px;
                            tint: settings-touch.has-hover ? AgTheme.bone : AgTheme.muted;
                        }

                        Text {
                            text: "Settings";
                            color: settings-touch.has-hover ? AgTheme.bone : AgTheme.bone-dim;
                            font-family: AgTheme.font-ui;
                            font-size: AgTheme.type-micro;
                            font-weight: AgTheme.weight-medium;
                            vertical-alignment: center;
                        }

                        Rectangle { horizontal-stretch: 1; }

                        Text {
                            text: "CTRL ,";
                            color: AgTheme.quiet;
                            font-family: AgTheme.font-mono;
                            font-size: 8px;
                            vertical-alignment: center;
                        }
                    }

                    settings-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.open-settings-at(0); }
                    }
                }

                Rectangle { height: 12px; }

                Text {
                    text: "ARGENTUM 0.1 / SLICE 01";
                    color: AgTheme.quiet;
                    font-family: AgTheme.font-mono;
                    font-size: 8px;
                    letter-spacing: 0.5px;
                }
            }
        }

        // Central conversation surface
        Rectangle {
            x: AgTheme.rail-width;
            y: 0px;
            width: root.center-width;
            height: parent.height;
            background: AgTheme.canvas;

            VerticalLayout {
                width: parent.width;
                height: parent.height;
                spacing: 0;

                Rectangle {
                    height: AgTheme.header-height;
                    horizontal-stretch: 1;
                    background: AgTheme.canvas;

                Rectangle {
                    x: 0px;
                    y: parent.height - 1px;
                    width: parent.width;
                    height: AgTheme.hairline;
                    background: AgTheme.line;
                }

                VerticalLayout {
                    x: AgTheme.gutter;
                    y: 0px;
                    width: min(parent.width - 330px, 500px);
                    height: parent.height;
                    spacing: 5px;
                    alignment: center;

                    Text {
                        text: "ACTIVE SESSION  /  " + root.project_name;
                        color: AgTheme.muted;
                        font-family: AgTheme.font-ui;
                        font-size: 9px;
                        font-weight: AgTheme.weight-semibold;
                        letter-spacing: 1.5px;
                        horizontal-alignment: left;
                        overflow: elide;
                    }

                    Text {
                        text: root.session_title;
                        color: AgTheme.bone-strong;
                        font-family: AgTheme.font-display;
                        font-size: AgTheme.type-title;
                        font-weight: AgTheme.weight-semibold;
                        letter-spacing: -0.3px;
                        horizontal-alignment: left;
                        overflow: elide;
                    }
                }

                Rectangle {
                    x: parent.width - 272px;
                    y: (parent.height - 34px) / 2;
                    width: 156px;
                    height: 34px;
                    border-radius: AgTheme.radius-sm;
                    border-width: AgTheme.hairline;
                    border-color: root.approval_open
                        ? AgTheme.amber
                        : (root.running ? AgTheme.accent-line : AgTheme.line);
                    background: root.approval_open
                        ? AgTheme.amber-wash
                        : (root.running ? AgTheme.accent-wash : AgTheme.panel);
                    animate background, border-color {
                        duration: root.reduced_motion ? 0ms : AgTheme.motion-state;
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 14px;
                        spacing: 8px;
                        alignment: start;

                        Rectangle {
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: root.approval_open
                                ? AgTheme.amber
                                : (root.error_message != ""
                                    ? AgTheme.coral
                                    : (root.running ? AgTheme.accent : AgTheme.state-idle));
                            opacity: (root.running || root.approval_open)
                                && root.showcase-pulse
                                && !root.reduced_motion
                                ? 0.35
                                : 1.0;
                            animate opacity {
                                duration: root.reduced_motion ? 0ms : AgTheme.motion-pulse;
                            }
                        }

                        Text {
                            text: root.error_message != ""
                                ? "Needs attention"
                                : (root.running || root.approval_open
                                    ? (root.approval_open ? "Waiting for approval" : root.run_state)
                                    : root.run_state);
                            color: root.approval_open
                                ? AgTheme.amber
                                : (root.error_message != "" ? AgTheme.coral : AgTheme.bone-dim);
                            font-family: AgTheme.font-ui;
                            font-size: 9px;
                            font-weight: AgTheme.weight-semibold;
                            letter-spacing: 1.1px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                }

                Text {
                    visible: root.inspector-visible;
                    x: parent.width - 94px;
                    y: 0px;
                    width: 70px;
                    height: parent.height;
                    text: "LOCAL";
                    color: AgTheme.quiet;
                    font-family: AgTheme.font-mono;
                    font-size: 8px;
                    letter-spacing: 0.7px;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }
            }

            conversation := ScrollView {
                width: parent.width;
                vertical-stretch: 1;
                viewport-width: self.width;
                mouse-drag-pan-enabled: true;

                VerticalLayout {
                    width: parent.width;
                    padding-bottom: 24px;

                    if !root.has-conversation: EmptyHero {
                        project-name: root.project_name;
                        workspace-label: root.workspace_label;
                        reduced-motion: root.reduced_motion;
                        compact: root.height < 940px;
                        suggest(prompt) => { root.draft = prompt; }
                    }

                    if root.has-conversation: VerticalLayout {
                        padding-left: AgTheme.gutter;
                        padding-right: AgTheme.gutter;
                        padding-top: 24px;
                        padding-bottom: 28px;
                        spacing: 0;

                        HorizontalLayout {
                            height: 22px;
                            spacing: 12px;

                            Text {
                                text: "CONVERSATION";
                                color: AgTheme.accent;
                                font-family: AgTheme.font-ui;
                                font-size: 9px;
                                font-weight: AgTheme.weight-semibold;
                                letter-spacing: 1.6px;
                                vertical-alignment: center;
                            }

                            Rectangle { horizontal-stretch: 1; }

                            Text {
                                text: root.conversation_messages.length + " messages  /  "
                                    + root.change_summary;
                                color: AgTheme.quiet;
                                font-family: AgTheme.font-mono;
                                font-size: 8px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        Rectangle {
                            height: AgTheme.hairline;
                            background: AgTheme.line;
                        }

                        if root.user_prompt != "" && root.conversation_messages.length == 0: Rectangle {
                            background: transparent;

                            VerticalLayout {
                                padding-top: 26px;
                                padding-bottom: 26px;
                                spacing: 12px;

                                HorizontalLayout {
                                    spacing: 24px;
                                    Rectangle {
                                        width: 78px;
                                        background: transparent;
                                        VerticalLayout {
                                            spacing: 7px;
                                            Rectangle { width: 2px; height: 18px; background: AgTheme.accent; }
                                            Text {
                                                text: "YOU";
                                                color: AgTheme.bone;
                                                font-family: AgTheme.font-ui;
                                                font-size: 9px;
                                                font-weight: AgTheme.weight-bold;
                                                letter-spacing: 1.4px;
                                                vertical-stretch: 0;
                                            }
                                            Text {
                                                text: root.run_state;
                                                color: AgTheme.quiet;
                                                font-family: AgTheme.font-mono;
                                                font-size: 9px;
                                                overflow: elide;
                                                vertical-stretch: 0;
                                            }
                                        }
                                    }
                                    Text {
                                        text: root.user_prompt;
                                        color: AgTheme.bone-strong;
                                        font-family: AgTheme.font-ui;
                                        font-size: 15px;
                                        wrap: word-wrap;
                                        horizontal-stretch: 1;
                                    }
                                }

                                Rectangle { height: AgTheme.hairline; background: AgTheme.line-faint; }
                            }
                        }

                        for message in root.conversation_messages: MessageBlock {
                            message: message;
                            reduced-motion: root.reduced_motion;
                        }

                        if root.transcript != "": Rectangle {
                            background: transparent;

                            VerticalLayout {
                                padding-top: 26px;
                                padding-bottom: 26px;
                                spacing: 12px;

                                HorizontalLayout {
                                    spacing: 24px;
                                    Rectangle {
                                        width: 78px;
                                        background: transparent;
                                        VerticalLayout {
                                            spacing: 7px;
                                            Rectangle { width: 2px; height: 18px; background: AgTheme.accent-line; }
                                            Text {
                                                text: "ARGENTUM";
                                                color: AgTheme.muted;
                                                font-family: AgTheme.font-ui;
                                                font-size: 9px;
                                                font-weight: AgTheme.weight-bold;
                                                letter-spacing: 1.4px;
                                                vertical-stretch: 0;
                                            }
                                            Text {
                                                text: root.run_state;
                                                color: root.running ? AgTheme.accent : AgTheme.quiet;
                                                font-family: AgTheme.font-mono;
                                                font-size: 9px;
                                                overflow: elide;
                                                vertical-stretch: 0;
                                            }
                                        }
                                    }
                                    Text {
                                        text: root.transcript;
                                        color: AgTheme.bone-dim;
                                        font-family: AgTheme.font-ui;
                                        font-size: 15px;
                                        wrap: word-wrap;
                                        horizontal-stretch: 1;
                                    }
                                }

                                Rectangle { height: AgTheme.hairline; background: AgTheme.line-faint; }
                            }
                        }

                        if root.current_reasoning_available: Rectangle {
                            background: transparent;

                            VerticalLayout {
                                padding-top: 16px;
                                padding-bottom: 20px;
                                spacing: 10px;

                                Text {
                                    text: "REASONING  /  LIVE NOTES";
                                    color: AgTheme.amber;
                                    font-family: AgTheme.font-ui;
                                    font-size: 9px;
                                    font-weight: AgTheme.weight-semibold;
                                    letter-spacing: 1.4px;
                                }

                                Text {
                                    text: root.current_reasoning;
                                    color: AgTheme.muted;
                                    font-family: AgTheme.font-ui;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }

                if root.error_message != "" && !root.approval_open: Rectangle {
                    height: 56px;
                    horizontal-stretch: 1;

                    ErrorPanel {
                        x: AgTheme.gutter;
                        y: 5px;
                        width: parent.width - AgTheme.gutter - AgTheme.gutter;
                        height: 46px;
                        message: root.error_message;
                    }
                }

                if root.approval_open: Rectangle {
                    height: 110px;
                    horizontal-stretch: 1;

                    ApprovalPanel {
                        x: AgTheme.gutter;
                        y: 6px;
                        width: parent.width - AgTheme.gutter - AgTheme.gutter;
                        height: 98px;
                        action: root.approval_action;
                        target: root.approval_target;
                        reason: root.approval_reason;
                        pending: root.approval_response_pending;
                        reduced-motion: root.reduced_motion;
                        approve => { root.approve_tool(root.approval_id); }
                        reject => { root.reject_tool(root.approval_id); }
                    }
                }

                Rectangle {
                    height: AgTheme.composer-height;
                    horizontal-stretch: 1;
                    background: AgTheme.canvas;

                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: AgTheme.hairline;
                        background: AgTheme.line-faint;
                    }

                    ComposerPanel {
                        x: AgTheme.gutter;
                        y: 10px;
                        width: parent.width - AgTheme.gutter - AgTheme.gutter;
                        draft <=> root.draft;
                        provider-label: root.provider_label;
                        project-name: root.project_name;
                        workspace-label: root.workspace_label;
                        running: root.running;
                        approval-pending: root.approval_open;
                        submission-pending: root.submission_pending;
                        active-run-id: root.active_run_id;
                        reduced-motion: root.reduced_motion;
                        submit(prompt) => {
                            root.draft = prompt;
                            root.submit_task(prompt);
                        }
                        cancel(run-id) => { root.cancel_run(run-id); }
                    }
                }
            }
        }

        // Right inspector rail
        if root.inspector-visible: Rectangle {
            x: root.width - AgTheme.inspector-width;
            y: 0px;
            width: AgTheme.inspector-width;
            height: parent.height;
            background: AgTheme.rail;

            Rectangle {
                x: 0px;
                y: 0px;
                width: AgTheme.hairline;
                height: parent.height;
                background: AgTheme.line;
            }

            VerticalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 22px;
                padding-bottom: 20px;
                spacing: 0;

                HorizontalLayout {
                    height: 20px;
                    spacing: 10px;

                    Text {
                        text: "INSPECTOR";
                        color: AgTheme.accent;
                        font-family: AgTheme.font-ui;
                        font-size: 9px;
                        font-weight: AgTheme.weight-bold;
                        letter-spacing: 1.6px;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    Text {
                        text: root.inspector_modes.length + " SURFACES";
                        color: AgTheme.quiet;
                        font-family: AgTheme.font-mono;
                        font-size: 8px;
                        vertical-alignment: center;
                    }
                }

                Rectangle { height: 10px; }

                Text {
                    text: root.inspector-heading;
                    color: AgTheme.bone-strong;
                    font-family: AgTheme.font-display;
                    font-size: AgTheme.type-display;
                    font-weight: AgTheme.weight-bold;
                    letter-spacing: -0.8px;
                    height: 38px;
                }

                Rectangle { height: 12px; }

                HorizontalLayout {
                    height: 44px;
                    spacing: 0;

                    TabButton {
                        label: "Changes";
                        active: root.inspector-tab == "changes";
                        reduced-motion: root.reduced_motion;
                        horizontal-stretch: 1;
                        clicked => {
                            root.inspector-tab = "changes";
                            root.set_inspector_surface("changes");
                        }
                    }

                    TabButton {
                        label: "Tools";
                        active: root.inspector-tab == "tools";
                        reduced-motion: root.reduced_motion;
                        horizontal-stretch: 1;
                        clicked => { root.inspector-tab = "tools"; }
                    }

                    TabButton {
                        label: "Verification";
                        active: root.inspector-tab == "verification";
                        reduced-motion: root.reduced_motion;
                        horizontal-stretch: 1;
                        clicked => { root.inspector-tab = "verification"; }
                    }

                    TabButton {
                        label: "Activity";
                        active: root.inspector-tab == "activity";
                        reduced-motion: root.reduced_motion;
                        horizontal-stretch: 1;
                        clicked => {
                            root.inspector-tab = "activity";
                            root.set_inspector_surface("activity");
                        }
                    }
                }

                Rectangle {
                    height: AgTheme.hairline;
                    background: AgTheme.line;
                }

                ScrollView {
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    mouse-drag-pan-enabled: true;

                    VerticalLayout {
                        padding-top: 20px;
                        padding-bottom: 24px;
                        spacing: 14px;
                        alignment: start;

                        if root.inspector-tab == "changes": VerticalLayout {
                            spacing: 12px;
                            alignment: start;

                            Text {
                                text: "WORKING TREE";
                                color: AgTheme.muted;
                                font-family: AgTheme.font-ui;
                                font-size: 8px;
                                font-weight: AgTheme.weight-semibold;
                                letter-spacing: 1.4px;
                            }

                            Text {
                                text: root.change_summary;
                                color: AgTheme.bone-strong;
                                font-family: AgTheme.font-ui;
                                font-size: 15px;
                                font-weight: AgTheme.weight-semibold;
                                wrap: word-wrap;
                            }

                            Text {
                                text: root.changed_files > 0
                                    ? "+" + root.additions + "  /  -" + root.removals
                                    : "No file change set yet";
                                color: root.changed_files > 0 ? AgTheme.accent : AgTheme.quiet;
                                font-family: AgTheme.font-mono;
                                font-size: 10px;
                            }

                            Rectangle { height: AgTheme.hairline; background: AgTheme.line; }

                            if root.change_files.length > 0: VerticalLayout {
                                spacing: 3px;

                                for file in root.change_files: Rectangle {
                                    height: 50px;
                                    border-radius: AgTheme.radius-sm;
                                    background: file.selected
                                        ? AgTheme.accent-wash
                                        : (file-touch.has-hover ? AgTheme.panel : transparent);
                                    accessible-role: button;
                                    accessible-label: file.path;
                                    accessible-action-default => { root.load_change_diff(file.id); }

                                    if file.selected: Rectangle {
                                        x: 0px;
                                        y: 10px;
                                        width: 2px;
                                        height: 30px;
                                        background: AgTheme.accent;
                                    }

                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 10px;
                                        spacing: 9px;

                                        ShowcaseIcon {
                                            name: "file";
                                            size: 13px;
                                            tint: file.selected ? AgTheme.accent : AgTheme.muted;
                                        }

                                        VerticalLayout {
                                            spacing: 4px;
                                            horizontal-stretch: 1;
                                            alignment: center;

                                            Text {
                                                text: file.path;
                                                color: file.selected ? AgTheme.bone-strong : AgTheme.bone-dim;
                                                font-family: AgTheme.font-mono;
                                                font-size: 9px;
                                                horizontal-alignment: left;
                                                overflow: elide;
                                            }

                                            Text {
                                                text: file.kind + "  /  revision " + file.revision;
                                                color: AgTheme.quiet;
                                                font-family: AgTheme.font-ui;
                                                font-size: 8px;
                                                horizontal-alignment: left;
                                                overflow: elide;
                                            }
                                        }

                                        ShowcaseIcon {
                                            name: "chevron-right";
                                            size: 11px;
                                            tint: AgTheme.quiet;
                                        }
                                    }

                                    file-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.load_change_diff(file.id); }
                                    }
                                }
                            }

                            if root.change_files.length == 0: VerticalLayout {
                                spacing: 0;
                                alignment: start;

                                Rectangle { height: 28px; }

                                Rectangle {
                                    width: 24px;
                                    height: 2px;
                                    background: AgTheme.accent;
                                }

                                Text {
                                    text: "0";
                                    color: #F2EBDD12;
                                    font-family: AgTheme.font-display;
                                    font-size: 92px;
                                    font-weight: AgTheme.weight-bold;
                                    letter-spacing: -4px;
                                }

                                Rectangle { height: 8px; }

                                Text {
                                    text: "FILES TOUCHED";
                                    color: AgTheme.quiet;
                                    font-family: AgTheme.font-ui;
                                    font-size: 8px;
                                    font-weight: AgTheme.weight-semibold;
                                    letter-spacing: 1.4px;
                                }

                                Rectangle { height: 14px; }

                                Text {
                                    text: "Nothing changed yet. Run a task that touches files and its proposal will land here, with a diff and a restore gate.";
                                    color: AgTheme.muted;
                                    font-family: AgTheme.font-ui;
                                    font-size: AgTheme.type-small;
                                    wrap: word-wrap;
                                }
                            }

                            if root.selected_diff_available: VerticalLayout {
                                spacing: 9px;

                                Rectangle { height: 4px; }

                                Text {
                                    text: root.selected_change_path;
                                    color: AgTheme.bone-dim;
                                    font-family: AgTheme.font-mono;
                                    font-size: 9px;
                                    overflow: elide;
                                }

                                Rectangle {
                                    height: 156px;
                                    clip: true;
                                    background: AgTheme.ink;
                                    border-width: AgTheme.hairline;
                                    border-color: AgTheme.line;

                                    Text {
                                        x: 10px;
                                        y: 9px;
                                        width: parent.width - 20px;
                                        text: root.selected_diff;
                                        color: AgTheme.bone-dim;
                                        font-family: AgTheme.font-mono;
                                        font-size: 9px;
                                        wrap: word-wrap;
                                    }
                                }

                                if root.selected_restore_available: OutlineButton {
                                    label: "Restore file";
                                    icon: "lock";
                                    reduced-motion: root.reduced_motion;
                                    clicked => { root.request_restore(root.selected_file_change_id); }
                                }
                            }

                            if root.recovery_required: Rectangle {
                                border-width: AgTheme.hairline;
                                border-color: AgTheme.coral;
                                background: AgTheme.coral-wash;

                                VerticalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    padding-top: 12px;
                                    padding-bottom: 12px;
                                    spacing: 6px;

                                    Text {
                                        text: "RECOVERY REQUIRED";
                                        color: AgTheme.coral;
                                        font-family: AgTheme.font-ui;
                                        font-size: 8px;
                                        font-weight: AgTheme.weight-bold;
                                        letter-spacing: 1.2px;
                                    }

                                    Text {
                                        text: root.recovery_summary;
                                        color: AgTheme.bone-dim;
                                        font-family: AgTheme.font-ui;
                                        font-size: 10px;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }

                        if root.inspector-tab == "tools": VerticalLayout {
                            spacing: 12px;
                            alignment: start;

                            Text {
                                text: "TOOL STREAM";
                                color: AgTheme.muted;
                                font-family: AgTheme.font-ui;
                                font-size: 8px;
                                font-weight: AgTheme.weight-semibold;
                                letter-spacing: 1.4px;
                            }

                            Text {
                                text: root.activity_summary;
                                color: AgTheme.bone;
                                font-family: AgTheme.font-ui;
                                font-size: 13px;
                                wrap: word-wrap;
                            }

                            Rectangle { height: AgTheme.hairline; background: AgTheme.line; }

                            if root.activity_items.length == 0: Text {
                                text: "No tool calls in this session yet.";
                                color: AgTheme.muted;
                                font-family: AgTheme.font-ui;
                                font-size: AgTheme.type-small;
                            }

                            for item in root.activity_items: Rectangle {
                                background: AgTheme.ink;
                                border-width: AgTheme.hairline;
                                border-color: AgTheme.line;

                                VerticalLayout {
                                    padding-left: 11px;
                                    padding-right: 11px;
                                    padding-top: 11px;
                                    padding-bottom: 11px;
                                    spacing: 6px;

                                    HorizontalLayout {
                                        spacing: 8px;

                                        Rectangle {
                                            width: 5px;
                                            height: 5px;
                                            background: item.state == "active" || item.state == "running"
                                                ? AgTheme.accent
                                                : (item.state == "error" || item.state == "failed"
                                                    ? AgTheme.coral
                                                    : (item.state == "attention" || item.state == "blocked"
                                                        ? AgTheme.amber
                                                        : AgTheme.line-strong));
                                        }

                                        Text {
                                            text: item.title;
                                            color: AgTheme.bone-dim;
                                            font-family: AgTheme.font-mono;
                                            font-size: 9px;
                                            font-weight: AgTheme.weight-medium;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }

                                        Text {
                                            text: item.state;
                                            color: AgTheme.quiet;
                                            font-family: AgTheme.font-ui;
                                            font-size: 8px;
                                        }
                                    }

                                    Text {
                                        text: item.detail;
                                        color: AgTheme.muted;
                                        font-family: AgTheme.font-ui;
                                        font-size: 10px;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }

                        if root.inspector-tab == "verification": VerticalLayout {
                            spacing: 12px;
                            alignment: start;

                            Text {
                                text: "VERIFICATION";
                                color: AgTheme.muted;
                                font-family: AgTheme.font-ui;
                                font-size: 8px;
                                font-weight: AgTheme.weight-semibold;
                                letter-spacing: 1.4px;
                            }

                            Text {
                                text: root.display-verification-label;
                                color: root.verification_state == "passed"
                                    ? AgTheme.accent
                                    : (root.verification_state == "failed"
                                        ? AgTheme.coral
                                        : (root.verification_state == "ready"
                                            ? AgTheme.amber
                                            : AgTheme.bone));
                                font-family: AgTheme.font-display;
                                font-size: 36px;
                                font-weight: AgTheme.weight-bold;
                                letter-spacing: -0.8px;
                            }

                            Text {
                                text: root.verification_summary;
                                color: AgTheme.bone-dim;
                                font-family: AgTheme.font-ui;
                                font-size: 12px;
                                wrap: word-wrap;
                            }

                            Rectangle { height: AgTheme.hairline; background: AgTheme.line; }

                            Text {
                                text: root.plan_summary;
                                color: AgTheme.quiet;
                                font-family: AgTheme.font-mono;
                                font-size: 9px;
                            }

                            if root.plan_steps.length == 0: Text {
                                text: "No stages recorded for this run.";
                                color: AgTheme.muted;
                                font-family: AgTheme.font-ui;
                                font-size: AgTheme.type-small;
                            }

                            for step in root.plan_steps: HorizontalLayout {
                                spacing: 10px;

                                Rectangle {
                                    width: 18px;
                                    height: 18px;
                                    border-width: AgTheme.hairline;
                                    border-color: step.state == "complete" || step.state == "passed"
                                        ? AgTheme.accent
                                        : AgTheme.line-strong;
                                    background: step.state == "complete" || step.state == "passed"
                                        ? AgTheme.accent-wash
                                        : transparent;

                                    if step.state == "complete" || step.state == "passed": ShowcaseIcon {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        name: "check";
                                        size: 10px;
                                        tint: AgTheme.accent;
                                    }
                                }

                                VerticalLayout {
                                    spacing: 4px;
                                    horizontal-stretch: 1;

                                    Text {
                                        text: step.title;
                                        color: AgTheme.bone-dim;
                                        font-family: AgTheme.font-ui;
                                        font-size: 11px;
                                        font-weight: AgTheme.weight-medium;
                                        wrap: word-wrap;
                                    }

                                    Text {
                                        text: step.detail;
                                        color: AgTheme.quiet;
                                        font-family: AgTheme.font-ui;
                                        font-size: 9px;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }

                        if root.inspector-tab == "activity": VerticalLayout {
                            spacing: 12px;
                            alignment: start;

                            Text {
                                text: "ACTIVITY";
                                color: AgTheme.muted;
                                font-family: AgTheme.font-ui;
                                font-size: 8px;
                                font-weight: AgTheme.weight-semibold;
                                letter-spacing: 1.4px;
                            }

                            Text {
                                text: root.activity_summary;
                                color: AgTheme.bone;
                                font-family: AgTheme.font-ui;
                                font-size: 13px;
                                wrap: word-wrap;
                            }

                            Rectangle { height: AgTheme.hairline; background: AgTheme.line; }

                            if root.activity_items.length == 0: Text {
                                text: "Activity appears as the run moves.";
                                color: AgTheme.muted;
                                font-family: AgTheme.font-ui;
                                font-size: AgTheme.type-small;
                            }

                            for item in root.activity_items: HorizontalLayout {
                                spacing: 11px;

                                Rectangle {
                                    width: 8px;
                                    background: transparent;

                                    Rectangle {
                                        y: 5px;
                                        width: 5px;
                                        height: 5px;
                                        border-radius: 3px;
                                        background: item.state == "active" || item.state == "running"
                                            ? AgTheme.accent
                                            : (item.state == "error" || item.state == "failed"
                                                ? AgTheme.coral
                                                : (item.state == "attention" || item.state == "blocked"
                                                    ? AgTheme.amber
                                                    : AgTheme.line-strong));
                                    }
                                }

                                VerticalLayout {
                                    spacing: 4px;
                                    horizontal-stretch: 1;
                                    padding-bottom: 12px;

                                    Text {
                                        text: item.title;
                                        color: AgTheme.bone-dim;
                                        font-family: AgTheme.font-ui;
                                        font-size: 11px;
                                        font-weight: AgTheme.weight-medium;
                                        wrap: word-wrap;
                                    }

                                    Text {
                                        text: item.detail;
                                        color: AgTheme.muted;
                                        font-family: AgTheme.font-ui;
                                        font-size: 9px;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle { height: 10px; }

                Rectangle { height: AgTheme.hairline; background: AgTheme.line; }

                Rectangle { height: 10px; }

                HorizontalLayout {
                    height: 16px;
                    spacing: 8px;

                    ShowcaseIcon {
                        name: "lock";
                        size: 11px;
                        tint: AgTheme.quiet;
                    }

                    Text {
                        text: "LOCAL TOOLS  /  APPROVAL GATED";
                        color: AgTheme.quiet;
                        font-family: AgTheme.font-ui;
                        font-size: 8px;
                        letter-spacing: 0.8px;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Settings sheet
        Rectangle {
            visible: root.settings_open;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            background: AgTheme.scrim;

            TouchArea {
                clicked => { root.settings_open = false; }
            }

            settings-sheet := Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(parent.width - 64px, 940px);
                height: min(parent.height - 64px, 660px);
                background: AgTheme.panel;
                border-width: AgTheme.hairline;
                border-color: AgTheme.line-strong;
                border-radius: AgTheme.radius-md;
                clip: true;

                TouchArea {
                    clicked => { }
                }

                settings-focus := FocusScope {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    focus-on-click: false;
                    focus-on-tab-navigation: false;

                    capture-key-pressed(event) => {
                        if event.text == Key.Escape {
                            root.settings_open = false;
                            return accept;
                        }
                        if event.text == Key.Tab {
                            if event.modifiers.shift {
                                root.settings-focus-index = root.settings-focus-index == 0
                                    ? 2
                                    : root.settings-focus-index - 1;
                            } else {
                                root.settings-focus-index = root.settings-focus-index == 2
                                    ? 0
                                    : root.settings-focus-index + 1;
                            }
                            if root.settings-focus-index == 0 {
                                settings-close.take-focus();
                            } else if root.settings-focus-index == 1 {
                                settings-sections.focus();
                            } else {
                                settings-primary.take-focus();
                            }
                            return accept;
                        }
                        return reject;
                    }

                    key-pressed(event) => {
                        if event.text == Key.UpArrow {
                            root.settings-section-index = max(0, root.settings-section-index - 1);
                            return accept;
                        }
                        if event.text == Key.DownArrow {
                            root.settings-section-index = min(4, root.settings-section-index + 1);
                            return accept;
                        }
                        return reject;
                    }

                    VerticalLayout {
                        padding-left: 28px;
                        padding-right: 28px;
                        padding-top: 24px;
                        padding-bottom: 20px;
                        spacing: 0;

                        HorizontalLayout {
                            height: 38px;
                            spacing: 12px;

                            Text {
                                text: "SETTINGS";
                                color: AgTheme.accent;
                                font-family: AgTheme.font-ui;
                                font-size: 9px;
                                font-weight: AgTheme.weight-bold;
                                letter-spacing: 1.8px;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "/  " + root.settings-section-label;
                                color: AgTheme.quiet;
                                font-family: AgTheme.font-mono;
                                font-size: 9px;
                                vertical-alignment: center;
                            }

                            Rectangle { horizontal-stretch: 1; }

                            settings-close := OutlineButton {
                                label: "Close";
                                icon: "close";
                                reduced-motion: root.reduced_motion;
                                clicked => { root.settings_open = false; }
                            }
                        }

                        Rectangle { height: 16px; }

                        HorizontalLayout {
                            vertical-stretch: 1;
                            spacing: 26px;

                            VerticalLayout {
                                width: 208px;
                                spacing: 2px;

                                settings-sections := FocusScope {
                                    vertical-stretch: 1;
                                    focus-on-click: false;
                                    focus-on-tab-navigation: true;
                                    key-pressed(event) => {
                                        if event.text == Key.UpArrow {
                                            root.settings-section-index = max(0, root.settings-section-index - 1);
                                            return accept;
                                        }
                                        if event.text == Key.DownArrow {
                                            root.settings-section-index = min(4, root.settings-section-index + 1);
                                            return accept;
                                        }
                                        return reject;
                                    }

                                    VerticalLayout {
                                        spacing: 2px;

                                        SettingsSectionRow {
                                            index: "01";
                                            label: "Workspace";
                                            active: root.settings-section-index == 0;
                                            reduced-motion: root.reduced_motion;
                                            clicked => {
                                                root.settings-section-index = 0;
                                                settings-sections.focus();
                                            }
                                        }

                                        SettingsSectionRow {
                                            index: "02";
                                            label: "Provider";
                                            active: root.settings-section-index == 1;
                                            reduced-motion: root.reduced_motion;
                                            clicked => {
                                                root.settings-section-index = 1;
                                                settings-sections.focus();
                                            }
                                        }

                                        SettingsSectionRow {
                                            index: "03";
                                            label: "Model";
                                            active: root.settings-section-index == 2;
                                            reduced-motion: root.reduced_motion;
                                            clicked => {
                                                root.settings-section-index = 2;
                                                settings-sections.focus();
                                            }
                                        }

                                        SettingsSectionRow {
                                            index: "04";
                                            label: "Appearance";
                                            active: root.settings-section-index == 3;
                                            reduced-motion: root.reduced_motion;
                                            clicked => {
                                                root.settings-section-index = 3;
                                                settings-sections.focus();
                                            }
                                        }

                                        SettingsSectionRow {
                                            index: "05";
                                            label: "About / Version";
                                            active: root.settings-section-index == 4;
                                            reduced-motion: root.reduced_motion;
                                            clicked => {
                                                root.settings-section-index = 4;
                                                settings-sections.focus();
                                            }
                                        }
                                    }
                                }

                                Rectangle { vertical-stretch: 1; }

                                Text {
                                    text: "UP/DOWN SECTIONS\nTAB CONTROLS\nESC CLOSE";
                                    color: AgTheme.quiet;
                                    font-family: AgTheme.font-mono;
                                    font-size: 8px;
                                    wrap: word-wrap;
                                }
                            }

                            Rectangle {
                                width: 1px;
                                background: AgTheme.line;
                            }

                            ScrollView {
                                horizontal-stretch: 1;
                                vertical-stretch: 1;
                                viewport-width: self.width;
                                mouse-drag-pan-enabled: true;

                                VerticalLayout {
                                    padding-left: 2px;
                                    padding-right: 16px;
                                    padding-bottom: 20px;
                                    spacing: 14px;

                                    if root.settings-section-index == 0: VerticalLayout {
                                        spacing: 12px;

                                        Text {
                                            text: "WORKSPACE";
                                            color: AgTheme.quiet;
                                            font-family: AgTheme.font-ui;
                                            font-size: 8px;
                                            font-weight: AgTheme.weight-semibold;
                                            letter-spacing: 1.4px;
                                        }

                                        Text {
                                            text: root.project_name;
                                            color: AgTheme.bone-strong;
                                            font-family: AgTheme.font-display;
                                            font-size: 34px;
                                            font-weight: AgTheme.weight-bold;
                                            letter-spacing: -0.8px;
                                        }

                                        Text {
                                            text: root.workspace_label;
                                            color: AgTheme.accent;
                                            font-family: AgTheme.font-mono;
                                            font-size: 11px;
                                        }

                                        Rectangle { height: AgTheme.hairline; background: AgTheme.line; }

                                        SettingsInfoLine {
                                            label: "SESSION";
                                            value: root.session_title;
                                            detail: root.active_session_id != "" ? "ID " + root.active_session_id : "No active session";
                                        }

                                        SettingsInfoLine {
                                            label: "RUN STATE";
                                            value: root.run_state;
                                            value-color: root.running ? AgTheme.accent : AgTheme.bone;
                                        }

                                        SettingsInfoLine {
                                            label: "PROVIDER";
                                            value: root.provider_label;
                                            detail: root.provider_connected ? "Connected" : "Not tested";
                                        }

                                        Text {
                                            text: "Workspace selection and policy are managed by the native host. This sheet reports the active binding without changing it.";
                                            color: AgTheme.muted;
                                            font-family: AgTheme.font-ui;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                        }
                                    }

                                    if root.settings-section-index == 1: VerticalLayout {
                                        spacing: 12px;

                                        Text {
                                            text: "PROVIDER";
                                            color: AgTheme.quiet;
                                            font-family: AgTheme.font-ui;
                                            font-size: 8px;
                                            font-weight: AgTheme.weight-semibold;
                                            letter-spacing: 1.4px;
                                        }

                                        Text {
                                            text: root.provider_label;
                                            color: AgTheme.bone-strong;
                                            font-family: AgTheme.font-display;
                                            font-size: 34px;
                                            font-weight: AgTheme.weight-bold;
                                            letter-spacing: -0.8px;
                                        }

                                        Text {
                                            text: root.provider_kind_label + "  /  " + root.provider_probe_state;
                                            color: root.provider_connected ? AgTheme.accent : AgTheme.amber;
                                            font-family: AgTheme.font-ui;
                                            font-size: 10px;
                                            font-weight: AgTheme.weight-semibold;
                                            letter-spacing: 0.7px;
                                        }

                                        Rectangle { height: AgTheme.hairline; background: AgTheme.line; }

                                        SettingsInfoLine {
                                            label: "ENDPOINT";
                                            value: root.provider_endpoint;
                                            value-color: AgTheme.bone-dim;
                                        }

                                        SettingsInfoLine {
                                            label: "MODEL";
                                            value: root.provider_model;
                                            value-color: AgTheme.bone-dim;
                                        }

                                        SettingsInfoLine {
                                            label: "DETAIL";
                                            value: root.provider_detail;
                                            value-color: AgTheme.muted;
                                        }

                                        if root.provider_error != "": Text {
                                            text: root.provider_error;
                                            color: AgTheme.coral;
                                            font-family: AgTheme.font-ui;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                        }

                                        if root.provider_notice != "": Text {
                                            text: root.provider_notice;
                                            color: AgTheme.accent;
                                            font-family: AgTheme.font-ui;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                        }

                                        Rectangle { height: 1px; background: AgTheme.line; }

                                        Text {
                                            text: "PROFILES";
                                            color: AgTheme.quiet;
                                            font-family: AgTheme.font-ui;
                                            font-size: 8px;
                                            font-weight: AgTheme.weight-semibold;
                                            letter-spacing: 1.4px;
                                        }

                                        if root.provider_profiles.length == 0: Text {
                                            text: "No provider profiles loaded. The current binding is shown above.";
                                            color: AgTheme.muted;
                                            font-family: AgTheme.font-ui;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                        }

                                        for profile in root.provider_profiles: Rectangle {
                                            height: 54px;
                                            border-radius: AgTheme.radius-sm;
                                            background: profile.selected ? AgTheme.accent-wash : AgTheme.ink;
                                            border-width: AgTheme.hairline;
                                            border-color: profile.selected ? AgTheme.accent-line : AgTheme.line;

                                            HorizontalLayout {
                                                padding-left: 12px;
                                                padding-right: 12px;
                                                spacing: 10px;

                                                ShowcaseIcon {
                                                    name: "model";
                                                    size: 14px;
                                                    tint: profile.selected ? AgTheme.accent : AgTheme.muted;
                                                }

                                                VerticalLayout {
                                                    horizontal-stretch: 1;
                                                    spacing: 3px;
                                                    alignment: center;

                                                    Text {
                                                        text: profile.label;
                                                        color: profile.selected ? AgTheme.bone-strong : AgTheme.bone-dim;
                                                        font-family: AgTheme.font-ui;
                                                        font-size: 11px;
                                                        font-weight: AgTheme.weight-semibold;
                                                    }

                                                    Text {
                                                        text: profile.kind_label + "  /  " + profile.endpoint;
                                                        color: AgTheme.quiet;
                                                        font-family: AgTheme.font-mono;
                                                        font-size: 8px;
                                                        overflow: elide;
                                                    }
                                                }

                                                Text {
                                                    text: profile.selected ? "ACTIVE" : "SELECT";
                                                    color: profile.selected ? AgTheme.accent : AgTheme.quiet;
                                                    font-family: AgTheme.font-mono;
                                                    font-size: 8px;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.select_provider_profile(profile.id); }
                                            }
                                        }

                                        Text {
                                            text: "Credentials and secret values are never shown in this sheet.";
                                            color: AgTheme.quiet;
                                            font-family: AgTheme.font-ui;
                                            font-size: 9px;
                                        }
                                    }

                                    if root.settings-section-index == 2: VerticalLayout {
                                        spacing: 12px;

                                        Text {
                                            text: "MODEL";
                                            color: AgTheme.quiet;
                                            font-family: AgTheme.font-ui;
                                            font-size: 8px;
                                            font-weight: AgTheme.weight-semibold;
                                            letter-spacing: 1.4px;
                                        }

                                        Text {
                                            text: root.provider_model != "" ? root.provider_model : "No model selected";
                                            color: AgTheme.bone-strong;
                                            font-family: AgTheme.font-display;
                                            font-size: 32px;
                                            font-weight: AgTheme.weight-bold;
                                            letter-spacing: -0.7px;
                                            wrap: word-wrap;
                                        }

                                        Text {
                                            text: root.provider_label;
                                            color: AgTheme.muted;
                                            font-family: AgTheme.font-ui;
                                            font-size: 11px;
                                        }

                                        Rectangle { height: AgTheme.hairline; background: AgTheme.line; }

                                        SettingsInfoLine {
                                            label: "CONTEXT";
                                            value: root.context_window_reported ? root.context_window_tokens + " tokens" : "";
                                            value-color: AgTheme.bone-dim;
                                        }

                                        if root.provider_models_loading: Text {
                                            text: "Loading models...";
                                            color: AgTheme.amber;
                                            font-family: AgTheme.font-ui;
                                            font-size: 11px;
                                        }

                                        if root.provider_models_error != "": Text {
                                            text: root.provider_models_error;
                                            color: AgTheme.coral;
                                            font-family: AgTheme.font-ui;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                        }

                                        if root.provider_models.length == 0: Text {
                                            text: "No model list loaded. Refresh to query the selected provider.";
                                            color: AgTheme.muted;
                                            font-family: AgTheme.font-ui;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                        }

                                        for model in root.provider_models: Rectangle {
                                            height: 52px;
                                            border-radius: AgTheme.radius-sm;
                                            background: model.selected ? AgTheme.accent-wash : AgTheme.ink;
                                            border-width: AgTheme.hairline;
                                            border-color: model.selected ? AgTheme.accent-line : AgTheme.line;

                                            HorizontalLayout {
                                                padding-left: 12px;
                                                padding-right: 12px;
                                                spacing: 10px;

                                                ShowcaseIcon {
                                                    name: "model";
                                                    size: 14px;
                                                    tint: model.selected ? AgTheme.accent : AgTheme.muted;
                                                }

                                                VerticalLayout {
                                                    horizontal-stretch: 1;
                                                    spacing: 3px;
                                                    alignment: center;

                                                    Text {
                                                        text: model.label;
                                                        color: model.selected ? AgTheme.bone-strong : AgTheme.bone-dim;
                                                        font-family: AgTheme.font-mono;
                                                        font-size: 10px;
                                                        overflow: elide;
                                                    }

                                                    Text {
                                                        text: model.context_window_reported
                                                            ? model.context_window_tokens + " context tokens"
                                                            : "Context window not reported";
                                                        color: AgTheme.quiet;
                                                        font-family: AgTheme.font-ui;
                                                        font-size: 8px;
                                                    }
                                                }

                                                Text {
                                                    text: model.selected ? "ACTIVE" : "USE";
                                                    color: model.selected ? AgTheme.accent : AgTheme.quiet;
                                                    font-family: AgTheme.font-mono;
                                                    font-size: 8px;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.select_provider_model(root.provider_id, model.id); }
                                            }
                                        }
                                    }

                                    if root.settings-section-index == 3: VerticalLayout {
                                        spacing: 12px;

                                        Text {
                                            text: "APPEARANCE";
                                            color: AgTheme.quiet;
                                            font-family: AgTheme.font-ui;
                                            font-size: 8px;
                                            font-weight: AgTheme.weight-semibold;
                                            letter-spacing: 1.4px;
                                        }

                                        Text {
                                            text: "Motion";
                                            color: AgTheme.bone-strong;
                                            font-family: AgTheme.font-display;
                                            font-size: 34px;
                                            font-weight: AgTheme.weight-bold;
                                            letter-spacing: -0.8px;
                                        }

                                        Text {
                                            text: "Argentum uses motion for run state, focus and sheet transitions. Reduced motion keeps the same information without the pulse.";
                                            color: AgTheme.muted;
                                            font-family: AgTheme.font-ui;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                        }

                                        Rectangle { height: AgTheme.hairline; background: AgTheme.line; }

                                        HorizontalLayout {
                                            height: 44px;
                                            spacing: 12px;

                                            Text {
                                                text: "Reduced motion";
                                                color: AgTheme.bone-dim;
                                                font-family: AgTheme.font-ui;
                                                font-size: 12px;
                                                horizontal-stretch: 1;
                                                vertical-alignment: center;
                                            }

                                            SettingsToggle {
                                                checked: root.reduced_motion;
                                                reduced-motion: root.reduced_motion;
                                                toggled => { root.reduced_motion = !root.reduced_motion; }
                                            }
                                        }

                                        SettingsInfoLine {
                                            label: "STATE";
                                            value: root.reduced_motion ? "Reduced motion" : "Full motion";
                                            value-color: root.reduced_motion ? AgTheme.accent : AgTheme.bone;
                                        }

                                        Rectangle { height: 1px; background: AgTheme.line; }

                                        SettingsInfoLine { label: "CANVAS"; value: "#0B0B0E"; value-color: AgTheme.bone-dim; }
                                        SettingsInfoLine { label: "SIGNAL"; value: "#D8FF57"; value-color: AgTheme.accent; }
                                    }

                                    if root.settings-section-index == 4: VerticalLayout {
                                        spacing: 12px;

                                        Text {
                                            text: "ABOUT / VERSION";
                                            color: AgTheme.quiet;
                                            font-family: AgTheme.font-ui;
                                            font-size: 8px;
                                            font-weight: AgTheme.weight-semibold;
                                            letter-spacing: 1.4px;
                                        }

                                        BrandLockup { }

                                        Text {
                                            text: "0.1.0-rc.1";
                                            color: AgTheme.accent;
                                            font-family: AgTheme.font-mono;
                                            font-size: 12px;
                                            letter-spacing: 1.2px;
                                        }

                                        Text {
                                            text: "A local-first agent workbench for changes that survive review.";
                                            color: AgTheme.bone-dim;
                                            font-family: AgTheme.font-ui;
                                            font-size: 14px;
                                            wrap: word-wrap;
                                        }

                                        Rectangle { height: AgTheme.hairline; background: AgTheme.line; }

                                        SettingsInfoLine { label: "LICENSE"; value: "MIT"; value-color: AgTheme.bone-dim; }
                                        SettingsInfoLine { label: "BUILD"; value: "Native Slint host"; value-color: AgTheme.bone-dim; }
                                        SettingsInfoLine { label: "RUN STATE"; value: root.run_state; value-color: root.running ? AgTheme.accent : AgTheme.bone; }
                                        SettingsInfoLine {
                                            label: "PROVIDER";
                                            value: root.provider_label;
                                            detail: root.provider_connected ? "Connected" : "Not tested";
                                        }
                                        SettingsInfoLine {
                                            label: "VERIFICATION";
                                            value: root.display-verification-label;
                                            detail: root.verification_summary;
                                            value-color: root.verification_state == "passed" ? AgTheme.accent : (root.verification_state == "failed" ? AgTheme.coral : AgTheme.bone);
                                        }
                                        SettingsInfoLine {
                                            label: "CHANGES";
                                            value: root.changed_files + " files";
                                            detail: root.change_summary;
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle { height: 16px; }

                        HorizontalLayout {
                            height: 40px;
                            spacing: 12px;

                            Text {
                                text: "LOCAL ONLY  /  NO CREDENTIALS DISPLAYED";
                                color: AgTheme.quiet;
                                font-family: AgTheme.font-ui;
                                font-size: 8px;
                                letter-spacing: 0.8px;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }

                            settings-primary := OutlineButton {
                                label: root.settings-primary-label;
                                icon: root.settings-primary-icon;
                                enabled: root.settings-primary-enabled;
                                reduced-motion: root.reduced_motion;
                                clicked => { root.settings-primary-action(); }
                            }
                        }
                    }
                }
            }
        }

        // About panel
        Rectangle {
            visible: root.about_open;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            background: AgTheme.scrim;

            TouchArea {
                clicked => { root.about_open = false; }
            }

            about-card := Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(parent.width - 64px, 560px);
                height: min(parent.height - 64px, 380px);
                background: AgTheme.panel;
                border-width: AgTheme.hairline;
                border-color: AgTheme.line-strong;
                border-radius: AgTheme.radius-md;
                clip: true;

                TouchArea { clicked => { } }

                about-focus := FocusScope {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    focus-on-click: false;
                    focus-on-tab-navigation: false;

                    capture-key-pressed(event) => {
                        if event.text == Key.Escape {
                            root.about_open = false;
                            return accept;
                        }
                        if event.text == Key.Tab {
                            about-close.take-focus();
                            return accept;
                        }
                        return reject;
                    }

                    VerticalLayout {
                        padding-left: 30px;
                        padding-right: 30px;
                        padding-top: 28px;
                        padding-bottom: 24px;
                        spacing: 0;

                        BrandLockup { }

                        Rectangle { height: 26px; }

                        Text {
                            text: "Argentum";
                            color: AgTheme.bone-strong;
                            font-family: AgTheme.font-display;
                            font-size: 42px;
                            font-weight: AgTheme.weight-bold;
                            letter-spacing: -1.2px;
                        }

                        Text {
                            text: "0.1.0-rc.1  /  MIT  /  NATIVE SLINT HOST";
                            color: AgTheme.accent;
                            font-family: AgTheme.font-mono;
                            font-size: 9px;
                            letter-spacing: 1px;
                        }

                        Rectangle { height: 18px; }

                        Text {
                            text: "A local-first agent workbench for changes that survive review.";
                            color: AgTheme.bone-dim;
                            font-family: AgTheme.font-ui;
                            font-size: 15px;
                            wrap: word-wrap;
                        }

                        Rectangle { vertical-stretch: 1; }

                        Rectangle { height: AgTheme.hairline; background: AgTheme.line; }

                        Rectangle { height: 14px; }

                        HorizontalLayout {
                            height: 38px;
                            spacing: 12px;

                            Text {
                                text: "NO OWNER DATA  /  NO CREDENTIALS";
                                color: AgTheme.quiet;
                                font-family: AgTheme.font-ui;
                                font-size: 8px;
                                letter-spacing: 0.8px;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }

                            about-close := OutlineButton {
                                label: "Close";
                                icon: "close";
                                reduced-motion: root.reduced_motion;
                                clicked => { root.about_open = false; }
                            }
                        }
                    }
                }
            }
        }

        // Command palette
        Rectangle {
            visible: root.command_palette_open;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            background: AgTheme.scrim;

            TouchArea {
                clicked => { root.command_palette_open = false; }
            }

            palette := Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(parent.width - 80px, 720px);
                height: min(parent.height - 80px, 560px);
                background: AgTheme.panel;
                border-width: AgTheme.hairline;
                border-color: AgTheme.line-strong;
                border-radius: AgTheme.radius-md;
                clip: true;

                TouchArea { clicked => { } }

                palette-focus := FocusScope {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    focus-on-click: false;
                    focus-on-tab-navigation: false;

                    capture-key-pressed(event) => {
                        if event.text == Key.Escape {
                            root.command_palette_open = false;
                            return accept;
                        }
                        if event.text == Key.Tab {
                            palette-filter-input.focus();
                            return accept;
                        }
                        return reject;
                    }

                    VerticalLayout {
                        padding-left: 22px;
                        padding-right: 22px;
                        padding-top: 20px;
                        padding-bottom: 18px;
                        spacing: 0;

                        HorizontalLayout {
                            height: 20px;
                            spacing: 10px;

                            Text {
                                text: "COMMAND PALETTE";
                                color: AgTheme.accent;
                                font-family: AgTheme.font-ui;
                                font-size: 9px;
                                font-weight: AgTheme.weight-bold;
                                letter-spacing: 1.6px;
                                vertical-alignment: center;
                            }

                            Rectangle { horizontal-stretch: 1; }

                            Text {
                                text: "CTRL K";
                                color: AgTheme.quiet;
                                font-family: AgTheme.font-mono;
                                font-size: 8px;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle { height: 12px; }

                        Rectangle {
                            height: 48px;
                            border-radius: AgTheme.radius-sm;
                            border-width: AgTheme.hairline;
                            border-color: palette-filter-input.has-focus ? AgTheme.accent : AgTheme.line;
                            background: AgTheme.ink;

                            Text {
                                visible: root.command_filter == "";
                                x: 14px;
                                y: 0px;
                                width: parent.width - 28px;
                                height: parent.height;
                                text: "Filter commands...";
                                color: AgTheme.quiet;
                                font-family: AgTheme.font-ui;
                                font-size: 12px;
                                vertical-alignment: center;
                            }

                            palette-filter-input := TextInput {
                                x: 14px;
                                y: 0px;
                                width: parent.width - 28px;
                                height: parent.height;
                                text <=> root.command_filter;
                                color: AgTheme.bone-strong;
                                selection-foreground-color: AgTheme.accent-ink;
                                selection-background-color: AgTheme.accent;
                                font-family: AgTheme.font-ui;
                                font-size: 12px;
                                single-line: true;
                                accessible-label: "Filter commands";
                                key-pressed(event) => {
                                    if event.text == Key.Escape {
                                        root.command_palette_open = false;
                                        return accept;
                                    }
                                    if event.text == Key.UpArrow {
                                        root.command-selected = root.previous-visible(root.command-selected - 1);
                                        return accept;
                                    }
                                    if event.text == Key.DownArrow {
                                        root.command-selected = root.next-visible(root.command-selected + 1);
                                        return accept;
                                    }
                                    if event.text == Key.Return {
                                        if root.command-visible(root.command-selected) {
                                            root.execute-command(root.command-selected);
                                        }
                                        return accept;
                                    }
                                    return reject;
                                }
                            }
                        }

                        Rectangle { height: 12px; }

                        ScrollView {
                            vertical-stretch: 1;
                            viewport-width: self.width;
                            mouse-drag-pan-enabled: true;

                            VerticalLayout {
                                spacing: 2px;

                                CommandRow {
                                    index: "01";
                                    label: "New session";
                                    detail: "Start a fresh conversation";
                                    icon: "plus";
                                    selected: root.command-selected == 0;
                                    row-visible: root.show-new;
                                    reduced-motion: root.reduced_motion;
                                    clicked => {
                                        root.command-selected = 0;
                                        root.execute-command(0);
                                    }
                                }

                                CommandRow {
                                    index: "02";
                                    label: "Settings";
                                    detail: "Workspace, provider, model, appearance";
                                    icon: "settings";
                                    selected: root.command-selected == 1;
                                    row-visible: root.show-settings;
                                    reduced-motion: root.reduced_motion;
                                    clicked => {
                                        root.command-selected = 1;
                                        root.execute-command(1);
                                    }
                                }

                                CommandRow {
                                    index: "03";
                                    label: "Choose model";
                                    detail: "Open the model section";
                                    icon: "model";
                                    selected: root.command-selected == 2;
                                    row-visible: root.show-model;
                                    reduced-motion: root.reduced_motion;
                                    clicked => {
                                        root.command-selected = 2;
                                        root.execute-command(2);
                                    }
                                }

                                CommandRow {
                                    index: "04";
                                    label: "Context";
                                    detail: "Workspace and session context";
                                    icon: "workspace";
                                    selected: root.command-selected == 3;
                                    row-visible: root.show-context;
                                    reduced-motion: root.reduced_motion;
                                    clicked => {
                                        root.command-selected = 3;
                                        root.execute-command(3);
                                    }
                                }

                                CommandRow {
                                    index: "05";
                                    label: "Compact";
                                    detail: "Toggle the inspector rail";
                                    icon: "panel";
                                    selected: root.command-selected == 4;
                                    row-visible: root.show-compact;
                                    reduced-motion: root.reduced_motion;
                                    clicked => {
                                        root.command-selected = 4;
                                        root.execute-command(4);
                                    }
                                }

                                CommandRow {
                                    index: "06";
                                    label: "Status";
                                    detail: "Run, provider and verification state";
                                    icon: "verify";
                                    selected: root.command-selected == 5;
                                    row-visible: root.show-status;
                                    reduced-motion: root.reduced_motion;
                                    clicked => {
                                        root.command-selected = 5;
                                        root.execute-command(5);
                                    }
                                }

                                CommandRow {
                                    index: "07";
                                    label: "About";
                                    detail: "Product and build identity";
                                    icon: "session";
                                    selected: root.command-selected == 6;
                                    row-visible: root.show-about;
                                    reduced-motion: root.reduced_motion;
                                    clicked => {
                                        root.command-selected = 6;
                                        root.execute-command(6);
                                    }
                                }

                                CommandRow {
                                    index: "08";
                                    label: "Close";
                                    detail: "Close the command palette";
                                    icon: "close";
                                    selected: root.command-selected == 7;
                                    row-visible: root.show-close;
                                    reduced-motion: root.reduced_motion;
                                    clicked => {
                                        root.command-selected = 7;
                                        root.execute-command(7);
                                    }
                                }

                                if !root.show-new && !root.show-settings && !root.show-model
                                    && !root.show-context && !root.show-compact && !root.show-status
                                    && !root.show-about && !root.show-close: Text {
                                    text: "No matching commands.";
                                    color: AgTheme.muted;
                                    font-family: AgTheme.font-ui;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                }
                            }
                        }

                        Rectangle { height: 10px; }

                        Rectangle { height: AgTheme.hairline; background: AgTheme.line; }

                        Rectangle { height: 10px; }

                        HorizontalLayout {
                            height: 16px;
                            spacing: 10px;

                            Text {
                                text: "UP/DOWN NAVIGATE";
                                color: AgTheme.quiet;
                                font-family: AgTheme.font-mono;
                                font-size: 8px;
                                vertical-alignment: center;
                            }

                            Rectangle { horizontal-stretch: 1; }

                            Text {
                                text: "ENTER RUN  /  ESC CLOSE";
                                color: AgTheme.quiet;
                                font-family: AgTheme.font-mono;
                                font-size: 8px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
