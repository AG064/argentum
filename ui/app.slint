    public function focus_composer() { shell.focus-composer(); }

    shell := Workbench {
        x: 0px;
        y: root.safe_area_top;
        width: root.width;
        height: root.height - root.safe_area_top - root.safe_area_bottom - root.keyboard_inset;
    }
}
