import { ScrollView } from "std-widgets.slint";
import { AgTheme } from "../tokens.slint";
import { ActionButton } from "../components/buttons.slint";
import { InlineState } from "../components/inline-state.slint";
import { SettingsField, SectionHeading } from "../components/surfaces.slint";
import { FileChangeView, VerificationEvidenceView, VerificationRunnerView } from "../view-models.slint";

export component ReviewSurface inherits Rectangle {
    in property <bool> goal-available: false;
    in property <string> goal-objective: "";
    in-out property <string> goal-draft: "";
    in property <string> goal-state: "";
    in property <string> goal-next-action: "";
    in property <int> goal-iteration: 0;
    in property <int> goal-tokens-used: 0;
    in property <int> goal-token-budget: 0;
    in property <bool> goal-token-budget-reported: false;
    in property <int> goal-tools-used: 0;
    in property <int> goal-tool-budget: 0;
    in property <bool> goal-tool-budget-reported: false;
    in property <int> goal-time-budget-seconds: 0;
    in property <bool> goal-time-budget-reported: false;
    in property <int> goal-verification-count: 0;
    in property <bool> goal-busy: false;
    in property <string> change-summary: "No files changed";
    in property <[FileChangeView]> change-files: [];
    in property <int> changed-files: 0;
    in property <int> additions: 0;
    in property <int> removals: 0;
    in property <string> selected-file-change-id: "";
    in property <string> selected-change-path: "";
    in property <string> selected-diff: "";
    in property <bool> selected-diff-available: false;
    in property <bool> selected-diff-truncated: false;
    in property <string> selected-diff-reason: "Select a file to load its diff.";
    in property <bool> selected-restore-available: false;
    in property <string> selected-restore-reason: "Select a file to inspect restore availability.";
    in property <bool> recovery-required: false;
    in property <string> recovery-summary: "";
    in property <string> recovery-operation-id: "";
    in property <string> verification-state: "pending";
    in property <string> verification-label: "Not run";
    in property <string> verification-summary: "No automated checks were run";
    in property <[VerificationRunnerView]> verification-runners: [];
    in property <int> verification-runner-count: 0;
    in property <bool> verification-runners-loading: false;
    in property <string> verification-runners-error: "";
    in property <string> verification-approve-pending: "";
    in property <bool> verification-review-open: false;
    in property <string> verification-review-runner: "";
    in property <string> verification-review-command: "";
    in property <string> verification-review-scope: "";
    in property <string> verification-review-binding: "";
    in property <[VerificationEvidenceView]> verification-evidence: [];
    in property <bool> verification-evidence-loading: false;
    in property <string> verification-evidence-error: "";
    in property <bool> touch-mode: false;
    in property <bool> reduced-motion: false;
    callback set-goal(string, int, int, int);
    callback pause-goal();
    callback resume-goal();
    callback clear-goal();
    callback load-change-diff(string);
    callback request-restore(string);
    callback load-change-recovery();
    callback retry-change-recovery(string);
    callback request-recovery-restore(string);
    callback refresh-verification();
    callback review-verification-runner(string);
    callback approve-verification-runner(string);
    callback cancel-verification-review();

    background: transparent;

    ScrollView {
        width: parent.width;
        height: parent.height;
        viewport-width: self.width;
        mouse-drag-pan-enabled: root.touch-mode;

        VerticalLayout {
            spacing: AgTheme.space-4;

            if root.recovery-required: Rectangle {
                height: root.touch-mode ? 156px : 132px;
                vertical-stretch: 0;
                border-radius: AgTheme.radius-md;
                border-width: AgTheme.hairline;
                border-color: AgTheme.red-700;
                background: AgTheme.attention-surface;

                VerticalLayout {
                    padding: AgTheme.space-3;
                    spacing: AgTheme.space-2;
                    Text { text: "Recovery required"; color: AgTheme.red-100; font-family: AgTheme.font-ui; font-size: AgTheme.type-body; font-weight: AgTheme.weight-semibold; }
                    Text { text: root.recovery-summary; color: AgTheme.text-secondary; font-family: AgTheme.font-ui; font-size: AgTheme.type-compact; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: AgTheme.space-2;
                        ActionButton {
                            label: "Retry inspection";
                            enabled: root.recovery-operation-id != "";
                            target-height: root.touch-mode ? AgTheme.mobile-control-height : AgTheme.control-height;
                            reduced-motion: root.reduced-motion;
                            clicked => { root.retry-change-recovery(root.recovery-operation-id); }
                        }
                        if !root.touch-mode: ActionButton {
                            label: "Restore preimage";
                            enabled: root.recovery-operation-id != "";
                            primary: true;
                            target-height: root.touch-mode ? AgTheme.mobile-control-height : AgTheme.control-height;
                            reduced-motion: root.reduced-motion;
                            clicked => { root.request-recovery-restore(root.recovery-operation-id); }
                        }
                    }
                }
            }

            HorizontalLayout {
                height: root.touch-mode ? AgTheme.mobile-control-height : AgTheme.control-height;
                SectionHeading { label: "Goal"; horizontal-stretch: 1; }
                if root.goal-available: InlineState {
                    label: root.goal-state;
                    active: root.goal-state == "Active";
                    attention: root.goal-state == "Budget limited";
                }
            }

            if root.goal-available: VerticalLayout {
                spacing: AgTheme.space-2;
                Text { text: root.goal-objective; color: AgTheme.text-primary; font-family: AgTheme.font-ui; font-size: AgTheme.type-body; wrap: word-wrap; }
                Text { text: "Next: " + root.goal-next-action; color: AgTheme.text-muted; font-family: AgTheme.font-ui; font-size: AgTheme.type-compact; wrap: word-wrap; }
                Text { text: "Iteration " + root.goal-iteration + " | Verifications " + root.goal-verification-count; color: AgTheme.text-muted; font-family: AgTheme.font-ui; font-size: AgTheme.type-compact; }
                if root.goal-token-budget-reported: Text { text: "Recorded tokens " + root.goal-tokens-used + " / goal allowance " + root.goal-token-budget; color: AgTheme.text-muted; font-family: AgTheme.font-ui; font-size: AgTheme.type-compact; wrap: word-wrap; }
                if root.goal-tool-budget-reported: Text { text: "Tools " + root.goal-tools-used + " / " + root.goal-tool-budget; color: AgTheme.text-muted; font-family: AgTheme.font-ui; font-size: AgTheme.type-compact; }
                if root.goal-time-budget-reported: Text { text: "Time " + root.goal-time-budget-seconds + " seconds"; color: AgTheme.text-muted; font-family: AgTheme.font-ui; font-size: AgTheme.type-compact; }
            }

            if !root.goal-available: Text {
                text: "Set an objective for this session. It remains under your control.";
                color: AgTheme.text-muted;
                font-family: AgTheme.font-ui;
                font-size: AgTheme.type-compact;
                wrap: word-wrap;
            }

            SettingsField {
                label: "Objective";
                placeholder: root.goal-available ? "Replace the objective" : "Describe the objective";
                value <=> root.goal-draft;
                enabled: !root.goal-busy;
            }

            HorizontalLayout {
                spacing: AgTheme.space-2;
                ActionButton {
                    label: root.goal-available ? "Replace goal" : "Set goal";
                    icon: root.goal-available ? "changes" : "new-task";
                    primary: !root.goal-available;
                    enabled: !root.goal-busy && root.goal-draft != "";
                    target-height: root.touch-mode ? AgTheme.mobile-control-height : AgTheme.control-height;
                    reduced-motion: root.reduced-motion;
                    clicked => {
                        root.set-goal(
                            root.goal-draft,
                            root.goal-token-budget-reported ? root.goal-token-budget : -1,
                            root.goal-tool-budget-reported ? root.goal-tool-budget : -1,
                            root.goal-time-budget-reported ? root.goal-time-budget-seconds : -1
                        );
                    }
                }
                if root.goal-available: ActionButton {
                    label: root.goal-state == "Paused" ? "Resume" : "Pause";
                    enabled: !root.goal-busy && (root.goal-state == "Active" || root.goal-state == "Paused");
                    target-height: root.touch-mode ? AgTheme.mobile-control-height : AgTheme.control-height;
                    reduced-motion: root.reduced-motion;
                    clicked => {
                        if (root.goal-state == "Paused") { root.resume-goal(); }
                        else { root.pause-goal(); }
                    }
                }
                if root.goal-available: ActionButton {
                    label: "Clear";
                    enabled: !root.goal-busy;
                    foreground: AgTheme.red-100;
                    outline-color: transparent;
                    target-height: root.touch-mode ? AgTheme.mobile-control-height : AgTheme.control-height;
                    reduced-motion: root.reduced-motion;
                    clicked => { root.clear-goal(); }
                }
            }

            Rectangle { height: AgTheme.hairline; background: AgTheme.border-subtle; }

            SectionHeading { label: "Changes"; detail: root.changed-files; }
            VerticalLayout {
                spacing: AgTheme.space-1;
                Text { text: root.change-summary; color: AgTheme.text-primary; font-family: AgTheme.font-ui; font-size: AgTheme.type-body; font-weight: AgTheme.weight-semibold; }
                Text { text: root.changed-files > 0 ? "+" + root.additions + "  -" + root.removals : "No additions or removals"; color: AgTheme.text-muted; font-family: AgTheme.font-ui; font-size: AgTheme.type-compact; }
            }

            if root.changed-files > 0: VerticalLayout {
                spacing: AgTheme.space-2;
                for file in root.change-files: ActionButton {
                    label: file.kind + "  " + file.path + "  r" + file.revision;
                    outline-color: file.id == root.selected-file-change-id ? AgTheme.border-default : AgTheme.border-subtle;
                    enabled: !root.recovery-required;
                    target-height: root.touch-mode ? AgTheme.mobile-control-height : AgTheme.control-height;
                    reduced-motion: root.reduced-motion;
                    clicked => { root.load-change-diff(file.id); }
                }
            }

            if root.selected-file-change-id != "": VerticalLayout {
                spacing: AgTheme.space-2;
                Text { text: root.selected-change-path; color: AgTheme.text-primary; font-family: AgTheme.font-ui; font-size: AgTheme.type-body; font-weight: AgTheme.weight-semibold; overflow: elide; }
                if root.touch-mode: Text {
                    text: "The selected change is ready. Open desktop review to inspect the bounded diff.";
                    color: AgTheme.text-muted;
                    font-family: AgTheme.font-ui;
                    font-size: AgTheme.type-compact;
                    wrap: word-wrap;
                }
                if !root.touch-mode && root.selected-diff-available: Rectangle {
                    height: 160px;
                    vertical-stretch: 0;
                    border-radius: AgTheme.radius-xs;
                    border-width: AgTheme.hairline;
                    border-color: AgTheme.border-subtle;
                    background: AgTheme.surface-soft;
                    Text {
                        x: AgTheme.space-3;
                        y: AgTheme.space-3;
                        width: parent.width - AgTheme.space-6;
                        height: parent.height - AgTheme.space-6;
                        text: root.selected-diff;
                        color: AgTheme.text-secondary;
                        font-family: AgTheme.font-code;
                        font-size: AgTheme.type-code;
                        wrap: word-wrap;
                    }
                }
                if !root.touch-mode && !root.selected-diff-available: Text {
                    text: root.selected-diff-reason;
                    color: AgTheme.text-muted;
                    font-family: AgTheme.font-ui;
                    font-size: AgTheme.type-compact;
                    wrap: word-wrap;
                }
                if !root.touch-mode && root.selected-diff-truncated: Text {
                    text: "Diff preview was truncated to the safe display limit.";
                    color: AgTheme.text-muted;
                    font-family: AgTheme.font-ui;
                    font-size: AgTheme.type-compact;
                    wrap: word-wrap;
                }
                if !root.touch-mode: ActionButton {
                    label: "Restore this revision";
                    enabled: root.selected-restore-available && !root.recovery-required;
                    target-height: root.touch-mode ? AgTheme.mobile-control-height : AgTheme.control-height;
                    reduced-motion: root.reduced-motion;
                    clicked => { root.request-restore(root.selected-file-change-id); }
                }
                if !root.touch-mode && !root.selected-restore-available: Text {
                    text: root.selected-restore-reason;
                    color: AgTheme.text-muted;
                    font-family: AgTheme.font-ui;
                    font-size: AgTheme.type-compact;
                    wrap: word-wrap;
                }
            }

            Rectangle { height: AgTheme.hairline; background: AgTheme.border-subtle; }

            HorizontalLayout {
                height: root.touch-mode ? AgTheme.mobile-control-height : AgTheme.control-height;
                SectionHeading { label: "Checks"; detail: root.verification-runner-count; horizontal-stretch: 1; }
                InlineState {
                    label: root.verification-label;
                    attention: root.verification-state == "failed";
                }
            }
            Text {
                text: root.verification-summary;
                color: root.verification-state == "failed" ? AgTheme.red-100 : AgTheme.text-muted;
                font-family: AgTheme.font-ui;
                font-size: AgTheme.type-body;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: AgTheme.space-2;
                ActionButton {
                    label: root.verification-runners-loading ? "Loading checks" : "Refresh checks";
                    enabled: !root.verification-runners-loading;
                    fill: AgTheme.surface-soft;
                    outline-color: AgTheme.border-default;
                    reduced-motion: root.reduced-motion;
                    clicked => { root.refresh-verification(); }
                }
            }

            if root.verification-runners-error != "": Text {
                text: root.verification-runners-error;
                color: AgTheme.text-danger;
                font-size: AgTheme.type-compact;
                wrap: word-wrap;
            }

            if root.verification-review-open: Rectangle {
                border-radius: AgTheme.radius-md;
                border-width: AgTheme.hairline;
                border-color: AgTheme.red-600;
                background: AgTheme.chrome;

                VerticalLayout {
                    padding: AgTheme.space-3;
                    spacing: AgTheme.space-2;

                    Text {
                        text: "Review exact runner";
                        color: AgTheme.white-100;
                        font-size: AgTheme.type-section-title;
                        font-weight: AgTheme.weight-semibold;
                    }
                    Text {
                        text: root.verification-review-runner;
                        color: AgTheme.text-secondary;
                        font-size: AgTheme.type-compact;
                    }
                    Text {
                        text: root.verification-review-command;
                        color: AgTheme.text-secondary;
                        font-family: AgTheme.font-code;
                        font-size: AgTheme.type-metadata;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.verification-review-scope;
                        color: AgTheme.text-muted;
                        font-size: AgTheme.type-compact;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "Binding " + root.verification-review-binding;
                        color: AgTheme.text-tertiary;
                        font-family: AgTheme.font-code;
                        font-size: AgTheme.type-metadata;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "The runner executes current-user code, not an operating-system sandbox.";
                        color: AgTheme.text-muted;
                        font-size: AgTheme.type-compact;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: AgTheme.space-2;
                        ActionButton {
                            label: "Cancel";
                            fill: AgTheme.surface-soft;
                            outline-color: AgTheme.border-default;
                            reduced-motion: root.reduced-motion;
                            clicked => { root.cancel-verification-review(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        ActionButton {
                            label: root.verification-approve-pending == "" ? "Approve exact runner" : "Approving";
                            primary: true;
                            enabled: root.verification-approve-pending == "";
                            reduced-motion: root.reduced-motion;
                            clicked => { root.approve-verification-runner(root.verification-review-runner); }
                        }
                    }
                }
            }

            if root.verification-runners-loading: Text {
                text: "Loading verification runners";
                color: AgTheme.text-muted;
                font-size: AgTheme.type-compact;
            }

            for runner in root.verification-runners: Rectangle {
                min-height: 92px;
                border-radius: AgTheme.radius-md;
                border-width: AgTheme.hairline;
                border-color: AgTheme.border-subtle;
                background: AgTheme.chrome;

                VerticalLayout {
                    padding: AgTheme.space-3;
                    spacing: AgTheme.space-1;

                    HorizontalLayout {
                        spacing: AgTheme.space-2;
                        Text {
                            text: runner.id;
                            color: AgTheme.white-100;
                            font-size: AgTheme.type-body;
                            font-weight: AgTheme.weight-semibold;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        InlineState {
                            label: runner.state;
                            attention: runner.state == "Unavailable";
                        }
                    }

                    Text {
                        text: runner.detail;
                        color: AgTheme.text-muted;
                        font-size: AgTheme.type-compact;
                        wrap: word-wrap;
                    }

                    if runner.available && runner.approval_required && !runner.approved: ActionButton {
                        label: root.verification-approve-pending == runner.id ? "Reviewing" : "Review exact runner";
                        enabled: root.verification-approve-pending == "";
                        fill: AgTheme.surface-soft;
                        outline-color: AgTheme.border-default;
                        reduced-motion: root.reduced-motion;
                        clicked => { root.review-verification-runner(runner.id); }
                    }

                    if runner.approved: Text {
                        text: "Owner grant recorded for this exact runner.";
                        color: AgTheme.silver-300;
                        font-size: AgTheme.type-compact;
                    }
                }
            }

            Rectangle { height: AgTheme.hairline; background: AgTheme.border-subtle; }

            SectionHeading { label: "Evidence"; detail: root.verification-evidence.length; }

            if root.verification-evidence-loading: Text {
                text: "Loading recorded checks";
                color: AgTheme.text-muted;
                font-size: AgTheme.type-compact;
            }

            if root.verification-evidence-error != "": Text {
                text: root.verification-evidence-error;
                color: AgTheme.text-danger;
                font-size: AgTheme.type-compact;
                wrap: word-wrap;
            }

            if !root.verification-evidence-loading && root.verification-evidence.length == 0: Text {
                text: "No automated checks were recorded for this run.";
                color: AgTheme.text-muted;
                font-size: AgTheme.type-body;
                wrap: word-wrap;
            }

            for item in root.verification-evidence: Rectangle {
                min-height: 76px;
                border-radius: AgTheme.radius-md;
                border-width: AgTheme.hairline;
                border-color: AgTheme.border-subtle;
                background: AgTheme.chrome;

                VerticalLayout {
                    padding: AgTheme.space-3;
                    spacing: AgTheme.space-1;

                    HorizontalLayout {
                        spacing: AgTheme.space-2;
                        Text {
                            text: item.runner;
                            color: AgTheme.text-primary;
                            font-size: AgTheme.type-body;
                            vertical-alignment: center;
                        }
                        InlineState {
                            label: item.state;
                            attention: item.state == "Failed" || item.state == "Timed out" || item.state == "Could not start";
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: item.fresh ? "Current" : "Stale";
                            color: item.fresh ? AgTheme.silver-300 : AgTheme.red-100;
                            font-size: AgTheme.type-metadata;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: item.detail;
                        color: AgTheme.text-muted;
                        font-size: AgTheme.type-compact;
                        wrap: word-wrap;
                    }

                    Text {
                        text: item.recorded;
                        color: AgTheme.text-tertiary;
                        font-size: AgTheme.type-metadata;
                    }
                }
            }
        }
    }
}
